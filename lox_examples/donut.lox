// Port of Andy Sloane's donut.c (https://www.a1k0n.net/2011/07/20/donut-math.html):
// a spinning ASCII torus rendered with a z-buffer and luminance-indexed
// characters, drawn glyph-by-glyph into a raylib window instead of stdout.
// Close the window to stop.
from gfx import *

const COLS = 80
const ROWS = 22
const SHADES = ".,-~:;=!*#$@"
const MAX_SHADE = len(SHADES) - 1

var win = window(COLS * 10, ROWS * 20)
win.init()
win.toggle_fullscreen()

// Cell size derived from the actual monitor resolution, halved so the torus
// renders at half size; OFFSET_X/Y center the resulting smaller grid within
// the fullscreen window.
const SCREEN_W = win.get_screen_width()
const SCREEN_H = win.get_screen_height()
const CELL_W = SCREEN_W / COLS / 2
const CELL_H = SCREEN_H / ROWS / 2
const FONT_SIZE = CELL_H
const OFFSET_X = (SCREEN_W - CELL_W * COLS) / 2
const OFFSET_Y = (SCREEN_H - CELL_H * ROWS) / 2

// zbuf/shade are float_arrays (flat, unboxed f64 buffers) rather than plain
// lists -- cheaper per-cell get/set, and clear() resets the whole buffer in
// one native call instead of a Lox-level loop. A cell is untouched by the
// torus surface iff its zbuf entry stays 0.0.
var zbuf = float_array(COLS, ROWS)
var shade = float_array(COLS, ROWS)

// j/i sample the same fixed angles every frame -- only A/B change -- so their
// sin/cos are precomputed once here instead of recomputed ~28,000 times/frame.
var cos_j = []
var sin_j = []
var h_j = []
for (var j = 0.0; j < 6.28; j += 0.07) {
    cos_j.append(_cos(j))
    sin_j.append(_sin(j))
    h_j.append(_cos(j) + 2)
}
const J_COUNT = len(cos_j)

var sin_i = []
var cos_i = []
for (var i = 0.0; i < 6.28; i += 0.02) {
    sin_i.append(_sin(i))
    cos_i.append(_cos(i))
}
const I_COUNT = len(sin_i)

func render_frame(A, B) {
    const e = _sin(A)
    const g = _cos(A)
    const m = _cos(B)
    const n = _sin(B)

    zbuf.clear(0.0)

    // j: angle around the tube cross-section; i: angle around the torus axis.
    foreach (jx in range(J_COUNT)) {
        var d = cos_j[jx]
        var f = sin_j[jx]
        var h = h_j[jx]
        foreach (ix in range(I_COUNT)) {
            var c = sin_i[ix]
            var l = cos_i[ix]
            var D = 1 / (c * h * e + f * g + 5)
            var t = c * h * g - f * e
            var x = int(40 + 30 * D * (l * h * m - t * n))
            var y = int(12 + 15 * D * (l * h * n + t * m))
            var N = int(8 * ((f * e - c * d * g) * m - c * d * e - f * g - l * d * n))
            if (y > 0 and y < ROWS and x > 0 and x < COLS) {
                if (D > zbuf.get(x, y)) {
                    zbuf.set(x, y, D)
                    var n_clamped = N
                    if (n_clamped < 0) { n_clamped = 0 }
                    if (n_clamped > MAX_SHADE) { n_clamped = MAX_SHADE }
                    shade.set(x, y, n_clamped)
                }
            }
        }
    }
}

func draw_frame() {
    win.begin()
    win.clear(vec4(0, 0, 0, 255))
    foreach (row in range(ROWS)) {
        foreach (col in range(COLS)) {
            if (zbuf.get(col, row) > 0.0) {
                var ch = SHADES[int(shade.get(col, row))]
                win.text(ch, OFFSET_X + col * CELL_W, OFFSET_Y + row * CELL_H, FONT_SIZE, vec4(255, 255, 255, 255))
            }
        }
    }
    win.end()
}

var A = 0.0
var B = 0.0
while (!win.should_close()) {
    render_frame(A, B)
    draw_frame()
    // donut.c advances A/B by 0.00004/0.00002 once per output char (1761/frame).
    A += 0.07044
    B += 0.03522
}
win.close()
