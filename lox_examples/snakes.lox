from gfx import *
// Spheres Demo
//
// Four "vanguard" points wander the arena on axis-aligned random paths,
// each trailed by its own snake of spheres chasing it as fast as they can.

import colour as col
import random
import math

const WIDTH = 1000
const HEIGHT = 700

win = window(WIDTH, HEIGHT)

win.init()
win.toggle_fullscreen()

const DISTANCE = 40.0   // Camera orbital distance from arena center
const ARENA_SIZE = 20.0 // Arena half-extent (30x30x30 total space)
const VANGUARD_COUNT = 8
const SPHERES_PER_VANGUARD = 50
const SPHERE_COUNT = VANGUARD_COUNT * SPHERES_PER_VANGUARD // an equal share
                                                            // per vanguard,
                                                            // by construction
const MIN_SIZE = 3
const MAX_SIZE = 3
const VANGUARD_SPEED = 0.36     // the independent base speed -- everything
                                 // else below is derived from it
const MAX_SPEED = VANGUARD_SPEED * 0.95 // fastest sphere: right up against
                                         // the vanguard's own speed, but
                                         // still just under it so the
                                         // vanguard always leads the chase
const MIN_SPEED = MAX_SPEED             // slowest sphere: half the fastest
                                         // -- each sphere's own random speed
                                         // falls somewhere in [MIN, MAX]
const VANGUARD_MIN_LEG = 20     // shortest/longest run of frames the
const VANGUARD_MAX_LEG = 80     // vanguard travels in a straight line
                                 // before randomly turning 90 degrees
const VANGUARD_SIZE = 0.2 // marker radius, drawn unshaded so the
                                      // point the swarm is chasing is visible
const VANGUARD_COLOR = vec4(255, 255, 255, 255)
const TRAIL_SAMPLE_INTERVAL = 4 // frames between trail samples -- higher
                                 // spreads spheres further apart and makes
                                 // the whole snake longer, same sphere count

// Standard raylib default-material vertex shader (mvp/matModel/matNormal
// are auto-wired by name).
var lit_vertex_shader = "
#version 330
in vec3 vertexPosition;
in vec2 vertexTexCoord;
in vec3 vertexNormal;
in vec4 vertexColor;

uniform mat4 mvp;
uniform mat4 matModel;
uniform mat4 matNormal;

out vec2 fragTexCoord;
out vec4 fragColor;
out vec3 fragPosition;
out vec3 fragNormal;

void main() {
    fragTexCoord = vertexTexCoord;
    fragColor = vertexColor;
    fragPosition = vec3(matModel * vec4(vertexPosition, 1.0));
    fragNormal = normalize(vec3(matNormal * vec4(vertexNormal, 0.0)));
    gl_Position = mvp * vec4(vertexPosition, 1.0);
}
"

// Ambient + diffuse + Blinn-Phong specular, one point light. lightPos/
// viewPos/ambientColor aren't auto-wired, so their locations are grabbed
// explicitly below.
var lit_fragment_shader = "
#version 330
in vec2 fragTexCoord;
in vec4 fragColor;
in vec3 fragPosition;
in vec3 fragNormal;

uniform sampler2D texture0;
uniform vec4 colDiffuse;
uniform vec3 lightPos;
uniform vec3 viewPos;
uniform vec3 ambientColor;

out vec4 finalColor;

void main() {
    vec3 norm = normalize(fragNormal);
    vec3 lightDir = normalize(lightPos - fragPosition);
    vec3 viewDir = normalize(viewPos - fragPosition);

    float diff = max(dot(norm, lightDir), 0.0);
    vec3 diffuse = diff * vec3(1.0);

    vec3 halfwayDir = normalize(lightDir + viewDir);
    float spec = pow(max(dot(norm, halfwayDir), 0.0), 32.0);
    vec3 specular = spec * vec3(0.5);

    vec4 texelColor = texture(texture0, fragTexCoord);
    vec3 lighting = ambientColor + diffuse + specular;
    finalColor = vec4(lighting, 1.0) * texelColor * fragColor * colDiffuse;
}
"

lit_shader = shader()
lit_shader.load_from_memory(lit_vertex_shader, lit_fragment_shader)
if (!lit_shader.is_valid()) {
    print("Failed to load sphere lighting shader")
}
light_pos_loc = lit_shader.get_location("lightPos")
view_pos_loc = lit_shader.get_location("viewPos")
ambient_loc = lit_shader.get_location("ambientColor")
lit_shader.set_value_vec3(light_pos_loc, vec3(0, ARENA_SIZE * 1.5, 0))
lit_shader.set_value_vec3(ambient_loc, vec3(0.15, 0.15, 0.15))

cam = camera(vec3(DISTANCE, 10, 0), vec3(0, 0, 0), vec3(0, 1, 0))
orbit_angle = 0.0

// Holds one position coordinate inside +/-limit -- used by Sphere.update
// (limit shrunk by radius) and Vanguard.update (bare arena size).
func clamp_axis(v, limit) {
    if (v < -limit) {
        return -limit
    }
    if (v > limit) {
        return limit
    }
    return v
}

// The 6 axis-aligned unit directions the vanguard can travel in -- straight
// lines only, no diagonals.
directions = [
    vec3(1, 0, 0), vec3(-1, 0, 0),
    vec3(0, 1, 0), vec3(0, -1, 0),
    vec3(0, 0, 1), vec3(0, 0, -1)
]

// A random direction perpendicular to heading -- a genuine 90-degree turn,
// never straight or a 180. Returns a clone, not a `directions` entry
// itself, so the caller is free to mutate it in place.
func perpendicular_heading(heading) {
    candidates = []
    foreach (i in range(len(directions))) {
        d = directions[i]
        dot = d.x * heading.x + d.y * heading.y + d.z * heading.z
        if (dot == 0) {
            candidates.append(d)
        }
    }
    d = random.choice(candidates)
    return vec3(d.x, d.y, d.z)
}

// One sphere chasing its target at its own fixed speed. No persisted
// velocity -- movement each frame is just speed applied toward target_pos.
class Sphere {
    init(pos, radius, color, speed) {
        this.pos = pos
        this.radius = radius
        this.color = color
        this.speed = speed
    }

    // Scalar math + this.pos.set() instead of normalize3/scale3 + a fresh
    // vec3(): zero vec3 allocations per sphere per frame. Safe because
    // this.pos is never aliased anywhere else, unlike Vanguard.pos.
    update(target_pos) {
        dx = target_pos.x - this.pos.x
        dy = target_pos.y - this.pos.y
        dz = target_pos.z - this.pos.z
        dist = math.sqrt(dx * dx + dy * dy + dz * dz)

        limit = ARENA_SIZE - this.radius
        if (dist > 0.0001) {
            scale = this.speed / dist
            x = clamp_axis(this.pos.x + dx * scale, limit)
            y = clamp_axis(this.pos.y + dy * scale, limit)
            z = clamp_axis(this.pos.z + dz * scale, limit)
            this.pos.set(x, y, z)
        }
    }

    draw() {
        win.sphere(this.pos, this.radius, this.color)
    }
}

// Travels straight along heading (an axis direction) for a random number
// of frames, then turns a genuine 90 degrees. Bounces (full reversal) off
// the arena walls, distinct from the voluntary 90-degree turns.
class Vanguard {
    init(pos, heading, speed) {
        this.pos = pos
        this.heading = heading
        this.speed = speed
        this.steps_until_turn = random.integer(VANGUARD_MIN_LEG, VANGUARD_MAX_LEG)
    }

    // Bounds/reflect logic is inlined per axis rather than a helper
    // returning a (pos, dir) tuple, which would allocate 3 tuples/frame.
    update() {
        this.steps_until_turn = this.steps_until_turn - 1
        if (this.steps_until_turn <= 0) {
            this.heading = perpendicular_heading(this.heading)
            this.steps_until_turn = random.integer(VANGUARD_MIN_LEG, VANGUARD_MAX_LEG)
        }

        x = this.pos.x + this.heading.x * this.speed
        y = this.pos.y + this.heading.y * this.speed
        z = this.pos.z + this.heading.z * this.speed

        dx = this.heading.x
        dy = this.heading.y
        dz = this.heading.z

        if (x < -ARENA_SIZE or x > ARENA_SIZE) {
            x = clamp_axis(x, ARENA_SIZE)
            dx = -dx
        }
        if (y < -ARENA_SIZE or y > ARENA_SIZE) {
            y = clamp_axis(y, ARENA_SIZE)
            dy = -dy
        }
        if (z < -ARENA_SIZE or z > ARENA_SIZE) {
            z = clamp_axis(z, ARENA_SIZE)
            dz = -dz
        }

        // Both unaliased (this.pos: Swarm.update copies its x/y/z, not a
        // reference; this.heading: perpendicular_heading returns a clone),
        // so direct field mutation is safe -- zero vec3 allocs here.
        this.pos.set(x, y, z)
        this.heading.x = dx
        this.heading.y = dy
        this.heading.z = dz
    }

    draw() {
        //win.sphere(this.pos, VANGUARD_SIZE, VANGUARD_COLOR)
    }
}

// One vanguard plus its own snake of SPHERES_PER_VANGUARD spheres, all
// sharing one hue so which spheres belong to which vanguard is visible.
class Swarm {
    init(color) {
        start_bound = ARENA_SIZE * 0.5
        start_pos = vec3(
            random.float(-start_bound, start_bound),
            random.float(-start_bound, start_bound),
            random.float(-start_bound, start_bound)
        )
        d = random.choice(directions)
        this.vanguard = Vanguard(start_pos, vec3(d.x, d.y, d.z), VANGUARD_SPEED)

        this.spheres = []
        n = 0
        while (n < SPHERES_PER_VANGUARD) {
            s = random.float(MIN_SIZE, MAX_SIZE)
            radius = s / 2.0
            bound = ARENA_SIZE - radius
            pos = vec3(random.float(-bound, bound), random.float(-bound, bound), random.float(-bound, bound))
            speed = random.float(MIN_SPEED, MAX_SPEED)
            this.spheres.append(Sphere(pos, radius, color, speed))
            n = n + 1
        }

        // Fixed-size ring buffer of independent vec3 slots, allocated once
        // and never replaced -- update() copies x/y/z into a slot via
        // .set() rather than storing a reference to this.vanguard.pos.
        this.trail = []
        n = 0
        while (n < SPHERES_PER_VANGUARD) {
            this.trail.append(vec3(this.vanguard.pos.x, this.vanguard.pos.y, this.vanguard.pos.z))
            n = n + 1
        }
        this.trail_head = 0
        this.frames_until_sample = TRAIL_SAMPLE_INTERVAL
    }

    // Position i samples behind the vanguard's current one: i=0 is the
    // vanguard's own newest sampled position, i=SPHERES_PER_VANGUARD-1 the
    // oldest one still remembered.
    trail_at(i) {
        return this.trail[(this.trail_head + i) % SPHERES_PER_VANGUARD]
    }

    update() {
        this.vanguard.update()

        // Sampling the trail less often than every frame spreads
        // consecutive spheres further apart and lengthens the whole
        // snake, without touching the sphere count.
        this.frames_until_sample = this.frames_until_sample - 1
        if (this.frames_until_sample <= 0) {
            this.frames_until_sample = TRAIL_SAMPLE_INTERVAL
            this.trail_head = (this.trail_head - 1 + SPHERES_PER_VANGUARD) % SPHERES_PER_VANGUARD
            this.trail[this.trail_head].set(this.vanguard.pos.x, this.vanguard.pos.y, this.vanguard.pos.z)
        }

        i = 0
        while (i < SPHERES_PER_VANGUARD) {
            this.spheres[i].update(this.trail_at(i))
            i = i + 1
        }
    }
}

swarms = []
foreach (i in range(VANGUARD_COUNT)) {
    color = col.hsv_to_rgb(i * 360.0 / VANGUARD_COUNT, 1.0, 1.0)
    swarms.append(Swarm(color))
}

arena_color = col.BLACK
clear_color = vec4(80, 80, 80, 255)
arena_wire_pos = vec3(0, 0, 0)
arena_wire_size = vec3(ARENA_SIZE * 2, ARENA_SIZE * 2, ARENA_SIZE * 2)
cam_pos = vec3(DISTANCE, 10, 0) // reused every frame via .set() below --
                                 // the two calls that read it (camera and
                                 // shader uniform) just copy its values

while (!win.should_close()) {
    // ===== CAMERA CONTROL =====
    orbit_angle = orbit_angle + 0.005
    x = math.cos(orbit_angle) * DISTANCE
    z = math.sin(orbit_angle) * DISTANCE
    cam_pos.set(x, 10, z)
    cam.set_position(cam_pos)
    lit_shader.set_value_vec3(view_pos_loc, cam_pos)

    i = 0
    while (i < VANGUARD_COUNT) {
        swarms[i].update()
        i = i + 1
    }

    win.begin()
    win.clear(clear_color)
    win.begin_3d(cam)

    win.cube_wires(arena_wire_pos, arena_wire_size, arena_color)

    win.begin_shader_mode(lit_shader)
    i = 0
    while (i < VANGUARD_COUNT) {
        spheres = swarms[i].spheres
        j = 0
        while (j < SPHERES_PER_VANGUARD) {
            spheres[j].draw()
            j = j + 1
        }
        i = i + 1
    }
    win.end_shader_mode()

    i = 0
    while (i < VANGUARD_COUNT) {
        swarms[i].vanguard.draw()
        i = i + 1
    }

    win.end_3d()
    win.end()
}

win.close()
print("spheres demo terminated")
