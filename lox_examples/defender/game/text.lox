from gfx import *

// Bitmap text drawn from the alphanumeric atlas (pngs/font.png).
//
// The atlas is a single row of 38 glyphs on a 30px pitch. Each glyph's ink is
// 20px wide and 30px tall, with 10px of trailing padding in its cell -- drawing
// the ink width rather than the full cell keeps the last glyph ('Z', which ends
// exactly at the atlas edge) from sampling past the texture.
//
// A character maps to its cell by index into CHARS.

const CHARS   = "0123456789:?ABCDEFGHIJKLMNOPQRSTUVWXYZ"
const PITCH   = 30    // distance between glyph cells in the atlas
const INK_W   = 20    // drawn width of a glyph
const INK_H   = 30    // glyph height
const ADVANCE = 25    // pen advance per character

class Font {
    __init__(img) {
        this.tex = texture(img, 1, 1, 1)   // sliced manually, so a single frame
        this.index = {}
        i = 0
        foreach (var c in CHARS) {
            this.index[c] = i
            i = i + 1
        }
        this.chars = this.index.keys()
    }

    // scale defaults to 1.0 (the atlas's native ADVANCE-per-character pitch);
    // pass a smaller value to shrink a line that would otherwise overflow the
    // screen (see game_controller.lox's draw_intro, which scales the controls
    // line down to fit the play area width).
    width(s, scale = 1.0) {
        return len(s) * ADVANCE * scale
    }

    // Draw s at screen (x, y), tinted col, at the given scale (1.0 = native
    // size). Characters outside the atlas (a space, say) draw nothing but
    // still advance the pen. Uses draw_texture_pro (not the fixed-size
    // draw_texture_rect every other atlas draw in this file used) since only
    // draw_texture_pro supports a dest size that differs from the source.
    draw(win, s, x, y, col, scale = 1.0) {
        cx = x
        ink_w = INK_W * scale
        ink_h = INK_H * scale
        advance = ADVANCE * scale
        foreach (var c in s) {
            if (c in this.chars) {
                win.draw_texture_pro(this.tex, this.index[c] * PITCH, 0, INK_W, INK_H, cx, y, ink_w, ink_h, 0, 0, 0, col)
            }
            cx = cx + advance
        }
    }
}

// Smoothly cycles a colour through a palette, taking `steps` frames per leg.
class ColourCycle {
    __init__(palette, steps) {
        this.palette = palette
        this.steps = steps
        this.i = 0
        this.t = 0
    }

    update() {
        this.t = this.t + 1
        if (this.t >= this.steps) {
            this.t = 0
            this.i = (this.i + 1) % len(this.palette)
        }
    }

    // linear blend from the current palette entry toward the next
    get() {
        a = this.palette[this.i]
        b = this.palette[(this.i + 1) % len(this.palette)]
        f = float(this.t) / float(this.steps)     // float(): int/int would truncate to 0
        return vec4(a.x + (b.x - a.x) * f,
                    a.y + (b.y - a.y) * f,
                    a.z + (b.z - a.z) * f,
                    255)
    }
}

// Left-pad n with zeros to width w.
func zero_pad(n, w) {
    s = str(n)
    while (len(s) < w) {
        s = "0" & s
    }
    return s
}
