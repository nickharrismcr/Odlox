// gui.Screen.update() should fire on_mouse_over/on_mouse_leave exactly
// once each, on the hover-state transition -- not every frame the mouse
// happens to be inside/outside the widget.
import gui

class Fake_Win {
    __init__(positions) {
        this.MOUSE_LEFT = 0
        this.MOUSE_RIGHT = 1
        this.positions = positions
        this.frame = -1
    }
    mouse_position() {
        this.frame = this.frame + 1
        return this.positions[this.frame]
    }
    mouse_pressed(btn) { return false }
    mouse_down(btn) { return false }
    mouse_released(btn) { return false }
}

var screen = gui.Screen()
var btn = screen.add(gui.Button(0, 0, 10, 10, nil))
btn.on_mouse_over = func (w, pos) { print "over" }
btn.on_mouse_leave = func (w, pos) { print "leave" }

// outside, inside, inside (no repeat event), outside
var win = Fake_Win([vec2(100, 100), vec2(5, 5), vec2(5, 5), vec2(100, 100)])
for (var i = 0; i < 4; i = i + 1) {
    screen.update(win)
}
