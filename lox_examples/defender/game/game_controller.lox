from gfx import *
import levels
import colour
import text
import math
from sprite import Sprite
from player import state_play, state_safe_start

// Drives the level/game-state machine: intro -> level_start -> level ->
// level_finish -> level_start (loops), or level_start -> ... -> game_over.
// `state` is a readable string, tested by main.lox for gating what runs/draws each frame.
// level_finish is the "ATTACK WAVE N COMPLETED." screen: it clears every enemy, bullet,
// and laser (humans persist), hides the ship, and emits "level_finish" (Mountain listens
// for this to hide itself). Shows the banner for LEVEL_FINISH_DISPLAY_TIME, then hands off
// to level_start, which spawns the next level, reveals the ship, and emits "level_start".

const LEVEL_FINISH_DISPLAY_TIME = 240  // frames the "ATTACK WAVE N COMPLETED." banner shows (4s at 60fps)
const GAME_OVER_PAUSE    = 180  // frames game_over waits before done becomes true (3s at 60fps)
const HUMANS_EVERY_N_LEVELS = 3 // humans top up only every Nth level, otherwise they persist

const LIVES_ICON_SCALE = 0.45
const LIVES_ICON_GAP   = 34
const LIVES_ICON_MAX   = 7
const LIVES_ROW_X      = 10   // left-aligned under the score
const LIVES_ROW_Y       = 50

const BOMB_ICON_SCALE = 0.5
const BOMB_ICON_GAP   = 20
const BOMB_ICON_MAX   = 7
const BOMB_COLUMN_GAP  = 8    // gap between the icon column and the radar's left edge
const BOMB_COLUMN_Y    = 0

// Intro screen sequence: Williams logo flash -> "presents" colour-cycles in
// -> DEFENDER title shatters into place (reusing the same disperse-draw
// effect as NPC materialise) with a colour-cycling highlight overlay ->
// instructions. SPACE skips straight to level_start at any point.
const INTRO_WILLIAMS_FLASH_FRAMES = 12  // 0.2s per colour
const INTRO_PRESENTS_AT = 120           // 2s
const INTRO_TITLE_AT = 240              // 4s
const INTRO_TEXT_AT = 360               // 6s
const INTRO_DISPERSE_START = 30
const INTRO_DISPERSE_RATE = 0.25        // ~2s (120 frames) to fully converge
const INTRO_PRESENTS_CYCLE_STEPS = 30   // 0.5s period
const INTRO_HILITE_CYCLE_STEPS = 6      // 0.1s period
const INTRO_WILLIAMS_Y = 100
const INTRO_PRESENTS_Y = 220
const INTRO_TITLE_Y = 400
// presents.png ships as a huge mostly-transparent canvas with the actual
// artwork in this sub-rectangle.
const INTRO_PRESENTS_SRC_X = 304
const INTRO_PRESENTS_SRC_Y = 259
const INTRO_PRESENTS_SRC_W = 361
const INTRO_PRESENTS_SRC_H = 406
const INTRO_CONTROLS_TEXT = "Q=UP A=DOWN SPACE=REVERSE SHIFT=THRUST ENTER=FIRE BACKSPACE=BOMB - PRESS SPACE TO PLAY"
const INTRO_CONTROLS_MARGIN = 40  // horizontal breathing room so the line never touches the screen edges

class GameController {
    __init__(cfg, entities, ship, ship_img, smartbomb_img) {
        this.cfg = cfg
        this.entities = entities
        this.ship = ship
        this.level = 0
        this.lives = cfg.starting_lives
        this.landers_killed = 0
        this.level_landers = 0
        this.timer = 0
        this.banner = ""
        this.done = false
        this.state = "intro"
        this.update_func = state_intro
        // own texture, locked to a single static frame (start_frame ==
        // end_frame): every draw_texture* call advances its texture's
        // animation frame as a side effect, so reusing ship.texture here
        // would make the real ship animate LIVES_ICON_MAX times too fast
        this.lives_icon = texture(ship_img, 5, 1, 1)
        this.bomb_icon = texture(smartbomb_img, 1, 1, 1)   // smartbomb.png is a single frame already
        // same palette/speed as the score (see score.lox), for a consistent HUD look
        this.banner_cycle = text.ColourCycle([colour.RED, colour.BLUE, colour.PURPLE, colour.YELLOW], 45)

        this.intro_timer = 0
        this.title_disperse = INTRO_DISPERSE_START
        this.presents_cycle = text.ColourCycle([colour.RED, colour.BLUE, colour.PURPLE, colour.YELLOW], INTRO_PRESENTS_CYCLE_STEPS)
        this.hilite_cycle = text.ColourCycle([colour.RED, colour.BLUE, colour.PURPLE, colour.YELLOW], INTRO_HILITE_CYCLE_STEPS)
        this.williams = texture(image("pngs/williams.png"), 1, 1, 1)
        this.presents = texture(image("pngs/presents.png"), 1, 1, 1)
        this.title_sprite = Sprite(vec2(0, 0), image("pngs/title.png"), 1, 1, 1)
        this.title_hilite_sprite = Sprite(vec2(0, 0), image("pngs/title_hilite.png"), 1, 1, 1)

        entities.events.on("lander_killed", this.on_lander_killed())
        entities.events.on("mutant_killed", this.on_lander_killed())
        entities.events.on("player_die", this.on_player_die())
        entities.events.on("player_start", this.on_player_start())
    }

    on_lander_killed() {
        func handler(e) {
            this.landers_killed = this.landers_killed + 1
        }
        return handler
    }
    on_player_die() {
        func handler(e) {
            this.lives = this.lives - 1
        }
        return handler
    }
    on_player_start() {
        func handler(e) {
            if (this.lives < 0) {
                enter_game_over(this)
            }
        }
        return handler
    }

    // Gameplay (ship/entities update, collisions) runs during level_start and
    // level; it's frozen during intro, the level_finish pause, and game_over.
    gameplay_active() -> bool {
        return this.state == "level_start" or this.state == "level"
    }

    update(win, input) {
        this.banner_cycle.update()
        f = this.update_func
        f(this, win, input)
    }

    draw(win, width: int, height: int, font) {
        if (this.state == "intro") {
            this.draw_intro(win, width, height, font)
        } else if (this.state == "level_finish") {
            draw_centered(win, font, this.banner, width/2, height/2, this.banner_cycle.get())
        } else if (this.state == "game_over") {
            draw_centered(win, font, "GAME OVER", width/2, height/2, colour.RED)
        }
        if (this.state != "intro") {
            this.draw_lives(win)
            this.draw_bombs(win, width)
        }
    }

    draw_intro(win, width: int, height: int, font) {
        flash_on = (this.intro_timer / INTRO_WILLIAMS_FLASH_FRAMES) % 2 == 0
        will_tint = colour.RED
        if (!flash_on) {
            will_tint = colour.YELLOW
        }
        will_x = width / 2 - this.williams.width() / 2
        win.draw_texture(this.williams, will_x, INTRO_WILLIAMS_Y, will_tint)

        if (this.intro_timer > INTRO_PRESENTS_AT) {
            pres_x = width / 2 - INTRO_PRESENTS_SRC_W / 2
            win.draw_texture_rect(this.presents, pres_x, INTRO_PRESENTS_Y, INTRO_PRESENTS_SRC_X, INTRO_PRESENTS_SRC_Y, INTRO_PRESENTS_SRC_W, INTRO_PRESENTS_SRC_H, this.presents_cycle.get())
        }

        if (this.intro_timer > INTRO_TITLE_AT) {
            title_x = width / 2 - this.title_sprite.get_texture().frame_width() / 2
            this.title_sprite.draw_disperse(win, title_x, INTRO_TITLE_Y, this.title_disperse, colour.WHITE)
            this.title_hilite_sprite.draw_disperse(win, title_x, INTRO_TITLE_Y, this.title_disperse, this.hilite_cycle.get())
        }

        if (this.intro_timer > INTRO_TEXT_AT) {
            // Shrinks the line to fit within width - INTRO_CONTROLS_MARGIN if
            // it would otherwise overflow at native size (1.0); never scales
            // up past native size on a wide screen.
            controls_scale = math.min(1.0, (width - INTRO_CONTROLS_MARGIN) / font.width(INTRO_CONTROLS_TEXT))
            draw_centered(win, font, INTRO_CONTROLS_TEXT, width/2, height - 100, colour.BLUE, controls_scale)
        }
    }

    // A row of small ship icons, one per life (capped at LIVES_ICON_MAX),
    // under the score.
    draw_lives(win) {
        n = this.lives
        if (n > LIVES_ICON_MAX) {
            n = LIVES_ICON_MAX
        }
        x = LIVES_ROW_X
        foreach (var i in range(0, n)) {
            win.draw_texture_scaled(this.lives_icon, x, LIVES_ROW_Y, colour.WHITE, false, LIVES_ICON_SCALE)
            x = x + LIVES_ICON_GAP
        }
    }

    // A column of small bomb icons, one per remaining smart bomb (capped at
    // BOMB_ICON_MAX), sitting flush against the radar's left edge.
    draw_bombs(win, width: int) {
        n = this.entities.bombs
        if (n > BOMB_ICON_MAX) {
            n = BOMB_ICON_MAX
        }
        radar_left = width / 4
        icon_width = this.bomb_icon.frame_width() * BOMB_ICON_SCALE
        x = radar_left - icon_width - BOMB_COLUMN_GAP
        y = BOMB_COLUMN_Y
        foreach (var i in range(0, n)) {
            win.draw_texture_scaled(this.bomb_icon, x, y, colour.WHITE, false, BOMB_ICON_SCALE)
            y = y + BOMB_ICON_GAP
        }
    }
}

func draw_centered(win, font, s: string, cx: float, y: float, col: vec4, scale: float = 1.0) {
    font.draw(win, s, cx - font.width(s, scale) / 2, y, col, scale)
}

func enter_intro(g) {
    g.state = "intro"
    g.update_func = state_intro
}
func state_intro(g, win, input) {
    g.intro_timer = g.intro_timer + 1
    g.presents_cycle.update()
    g.hilite_cycle.update()
    if (g.intro_timer > INTRO_TITLE_AT) {
        g.title_disperse = math.max(g.title_disperse - INTRO_DISPERSE_RATE, 1)
    }
    if (input.reverse) {   // SPACE, same key as the arcade "press space to start"
        enter_level_start(g)
    }
}

func enter_level_start(g) {
    g.level = g.level + 1
    levels.apply_level(g.cfg, g.level)

    g.landers_killed = 0
    // +1 for the guaranteed near-spawn below -- it's a genuine extra lander,
    // not one of the landers_per_wave*lander_waves already counted, so the
    // kill target must include it or the level can finish one lander short.
    g.level_landers = g.cfg.landers_per_wave * g.cfg.lander_waves + 1

    foreach (var i in range(0, g.cfg.lander_waves)) {
        g.entities.add_landers(g.cfg.landers_per_wave, i * g.cfg.lander_wave_delay)
    }
    // guarantee one lander materialises in view (roughly screen-centre)
    g.entities.add_lander_near(g.ship.pos.x + g.cfg.width * 0.35, 0)
    g.entities.add_pods(g.cfg.pods, g.ship.pos.x)
    g.entities.add_bombers(g.cfg.bombers)
    if ((g.level - 1) % HUMANS_EVERY_N_LEVELS == 0) {
        g.entities.add_humans(g.cfg.humans)
    }

    // Only force the ship visible if it's just coasting along in normal play
    // or its post-respawn invulnerability window -- if it's mid
    // death-sequence/hyperspace, that state's own enter_/state_ functions
    // already own visibility and know better.
    if (g.ship.update_func == state_play or g.ship.update_func == state_safe_start) {
        g.ship.visible = true
    }
    g.state = "level_start"
    g.update_func = state_level_start
    g.entities.events.emit("level_start", nil)
}
func state_level_start(g, win, input) {
    enter_level(g)
}

func enter_level(g) {
    g.state = "level"
    g.update_func = state_level
}
func state_level(g, win, input) {
    if (g.lives >= 0 and g.landers_killed >= g.level_landers) {
        enter_level_finish(g)
    }
}

func enter_level_finish(g) {
    g.entities.clear_wave()
    g.ship.visible = false
    g.banner = "ATTACK WAVE ${g.level} COMPLETED."
    g.timer = LEVEL_FINISH_DISPLAY_TIME
    g.state = "level_finish"
    g.update_func = state_level_finish
    g.entities.events.emit("level_finish", nil)
}
func state_level_finish(g, win, input) {
    if (g.timer > 0) {
        g.timer = g.timer - 1
        return
    }
    enter_level_start(g)
}

func enter_game_over(g) {
    g.timer = GAME_OVER_PAUSE
    g.state = "game_over"
    g.update_func = state_game_over
}
func state_game_over(g, win, input) {
    if (g.timer > 0) {
        g.timer = g.timer - 1
        if (g.timer <= 0) {
            g.done = true
        }
    }
}
