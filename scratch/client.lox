// Drives server.lox: starts it as a companion process (process.start(),
// no pipe attached -- the two talk over a socket instead), connects,
// sends "GET" twenty times printing each response, then closes the
// connection and kills the server.

import socket
import os
import sys
import process

PORT = 45900

func pad_left(s, width) {
    while len(s) < width {
        s = "0" & s
    }
    return s
}

func send_message(sock, payload) {
    sock.send(pad_left(str(len(payload)), 10))
    sock.send(payload)
}

func recv_exact(sock, n) {
    buf = ""
    remaining = n
    while remaining > 0 {
        chunk = sock.recv(remaining)
        if chunk == "" {
            break
        }
        buf = buf & chunk
        remaining = remaining - len(chunk)
    }
    return buf
}

func recv_message(sock) {
    header = recv_exact(sock, 10)
    if len(header) < 10 {
        return nil
    }
    return recv_exact(sock, int(header))
}

// The server needs a moment to start and call socket.listen() -- retry
// the connect a few times rather than assuming a fixed delay is enough.
func connect_with_retry(host, port, attempts) {
    result = nil
    i = 0
    while i < attempts and result == nil {
        try {
            result = socket.connect(host, port)
        } except SocketError as e {
            sys.sleep(0.1)
        }
        i = i + 1
    }
    return result
}

// kill() raises if the process has already exited on its own (nothing
// left to kill) -- not something the caller needs to treat as fatal.
func kill_server_safely(p) {
    try {
        p.kill()
    } except RunTimeError as e {
        print "client: server already exited (" & e.msg & ")"
    }
}

here = os.dirname(sys.args()[0])
server_path = os.join(here, "server.lox")

print "client: starting server"
srv_proc = process.start(server_path)

c = connect_with_retry("127.0.0.1", PORT, 50)
if c == nil {
    print "client: could not connect to server"
    kill_server_safely(srv_proc)
} else {
    print "client: connected to " & c.peer_endpoint()

    foreach (i in range(20)) {
        send_message(c, "GET")
        name = recv_message(c)
        content = recv_message(c)
        print "--- response " & str(i + 1) & ": " & name & " (" & str(len(content)) & " bytes) ---"
        print content
        sys.sleep(2)
    }

    c.close()
    print "client: closed connection"

    kill_server_safely(srv_proc)
    print "client: killed server"
}

print "client: done"
