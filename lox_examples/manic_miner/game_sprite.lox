from gfx import *

// @file game_sprite.lox
// @brief An animated, optionally moving sprite: cycles through
// image_list's frames and, for a "moving" sprite, bounces between
// (start_x, start_y) and (end_x, end_y) at movement_speed pixels/tick.

class Sprite {
    __init__() {
        this.type = "fixed"          // "moving" | "fixed" | "player"
        this.frames = 1
        this.movement_type = nil     // "horizontal" | "vertical"
        this.movement_speed = 0      // pixels per tick (or per cycle, if step_movement)
        this.animation_speed = 1     // ticks per animation frame
        this.step_movement = false   // hold position until a full anim cycle completes, then jump
        this.image_list = []         // sprite names, len == 2*frames (right half, then left half)
        this.start_x = 0
        this.start_y = 0
        this.end_x = 0
        this.end_y = 0
        this.init_x = nil            // nil: spawn at start_x/start_y (the usual case)
        this.init_y = nil
        this.colour = nil
        this.paper = nil

        this.x = 0
        this.y = 0
        this.dx = 0
        this.dy = 0
        this.frame = 0
        this.tick = 0

        this.last_x = nil     // where draw() last blitted -- nil means "never drawn yet"
        this.last_y = nil
        this.blank = nil      // lazily sized to the first frame drawn, reused every erase

        this.erase_ink = nil    // the room's own ink/paper under the last drawn position,
        this.erase_paper = nil  // captured just before it was painted over -- see draw()

        this.pending_flip = false  // see update(): defers a boundary reversal by one cycle
        this.crash_respawn = false // see update(): Skylab Landing Bay's fall/disintegrate/respawn cycle
    }

    // Sets every named field present in `d` (anything absent keeps its
    // current value), then re-derives position/delta from start_x/y and
    // movement_type/speed. init_x/init_y let a "moving" sprite spawn
    // somewhere other than start_x/start_y (e.g. mid-range).
    load_from_dict(d) {
        this.type = d.get("type", this.type)
        this.frames = d.get("frames", this.frames)
        this.movement_type = d.get("movement_type", this.movement_type)
        this.movement_speed = d.get("movement_speed", this.movement_speed)
        this.animation_speed = d.get("animation_speed", this.animation_speed)
        this.step_movement = d.get("step_movement", this.step_movement)
        this.image_list = d.get("image_list", this.image_list)
        this.start_x = d.get("start_x", this.start_x)
        this.start_y = d.get("start_y", this.start_y)
        this.end_x = d.get("end_x", this.end_x)
        this.end_y = d.get("end_y", this.end_y)
        this.init_x = d.get("init_x", this.start_x)
        this.init_y = d.get("init_y", this.start_y)
        this.crash_respawn = d.get("crash_respawn", this.crash_respawn)
        this.colour = d.get("colour", this.colour)
        this.paper = d.get("paper", this.paper)

        this.x = this.init_x
        this.y = this.init_y
        this.dx = 0
        this.dy = 0
        if (this.type == "moving") {
            if (this.movement_type == "horizontal") {
                this.dx = this.movement_speed
            } else if (this.movement_type == "vertical") {
                this.dy = this.movement_speed
            }
        }

        this.frame = 0
        this.tick = 0

        this.last_x = nil
        this.last_y = nil
        this.blank = nil

        this.erase_ink = nil
        this.erase_paper = nil

        this.pending_flip = false
    }

    // Advances the animation frame every animation_speed ticks, and for
    // a "moving" sprite (not "fixed"/"player"), the position too,
    // reversing at start/end. step_movement holds position until a full
    // cycle wraps; crash_respawn instead runs a fall/crash/respawn cycle.
    update() {
        if (this.crash_respawn) {
            if (this.y >= this.end_y) {
                this.frame = this.frame + 1
                if (this.frame >= this.frames) {
                    this.frame = 0
                    this.y = this.start_y
                    this.x = (this.x + 64) % 256
                }
            } else {
                this.y = this.y + this.dy
            }
            return
        }

        this.tick = this.tick + 1
        var wrapped = false
        if (this.tick >= this.animation_speed) {
            this.tick = 0
            this.frame = this.frame + 1
            if (this.frame >= this.frames) {
                this.frame = 0
                wrapped = true
            }
        }

        if (this.type != "moving") {
            return
        }

        if (this.step_movement and !wrapped) {
            return
        }

        // Horizontal movement defers a boundary reversal by a full cycle:
        // the cycle reaching start/end clamps and plays out there fully;
        // only the next cycle flips direction. Otherwise step_movement's
        // hold would switch facing before landing exactly on the bound.
        if (this.movement_type == "horizontal") {
            if (this.pending_flip) {
                this.dx = -this.dx
                this.pending_flip = false
            } else {
                var next_x = this.x + this.dx
                if (next_x <= this.start_x) {
                    this.x = this.start_x
                    this.pending_flip = true
                } else if (next_x >= this.end_x) {
                    this.x = this.end_x
                    this.pending_flip = true
                } else {
                    this.x = next_x
                }
            }
        } else if (this.movement_type == "vertical") {
            this.y = this.y + this.dy
            if (this.y <= this.start_y or this.y >= this.end_y) {
                this.dy = -this.dy
            }
        }
    }

    // Erases wherever this sprite last drew itself (a no-op on the first
    // call, since last_x is nil) before any sprite draws this tick, so a
    // fresh draw isn't wiped by a later clear. Uses erase_ink/erase_paper
    // captured from disp just before the previous draw(), not black.
    clear(disp) {
        if (this.last_x != nil) {
            disp.blit_sprite(this.blank, this.last_x, this.last_y, this.erase_ink, this.erase_paper)
        }
    }

    // Looks up the current frame's sprite in `lib` and blits it onto
    // `disp` at the current position, in this sprite's colour/paper. A
    // sprite moving left indexes into image_list's second half, counting
    // down as this.frame counts up. clear() must already run first.
    draw(disp, lib) {
        var index = this.frame
        if (this.movement_type == "horizontal" and this.dx < 0) {
            index = 2 * this.frames - 1 - this.frame
        }
        var name = this.image_list[index]
        var img = lib.get(name)

        if (this.blank == nil) {
            this.blank = float_array(img.width(), img.height())
        }

        var cx = int(this.x / 8)
        var cy = int(this.y / 8)
        this.erase_ink = disp.get_ink(cx, cy)
        this.erase_paper = disp.get_paper(cx, cy)

        disp.blit_sprite(img, int(this.x), int(this.y), this.colour, this.paper)

        this.last_x = int(this.x)
        this.last_y = int(this.y)
    }
}
