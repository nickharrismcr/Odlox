from gfx import *
import display
import assets
import cavern as cavern_module
import willy as willy_module
import willy_controller
import spectrum_attr
import font

//
// @file game.lox
// @brief Owns one Manic Miner play session: cavern/Willy/controller,
// ticked from running/die/game_over -- a state machine of update_func
// funcs, same convention as willy.lox. The caller still owns the window
// (create it, poll input via tick(win), upload/present the Display) and
// the game_sound.Sound passed into __init__ -- shared with intro.Intro
// rather than owned here, since there's only one audio device for the
// whole process.
//

const DIE_FLASH_TICKS = 20  // one tick per ink value, 7 down to 0
const LIVES_START = 3
const CAVERN_COUNT = 20  // caverns/cavern_0.json .. cavern_19.json

// Portal-entry flash: two ink cycles of 7 down to 1 (blue) -- unlike the
// death flash, black is never part of the cycle, so it ends on blue --
// then a fixed pause (placeholder for a remaining-air countdown) before
// the next cavern loads.
const PORTAL_FLASH_CYCLE_TICKS = 7
const PORTAL_FLASH_TICKS = PORTAL_FLASH_CYCLE_TICKS * 2
const PORTAL_PAUSE_TICKS = 30

// HUD layout: six 8px rows in the blank strip below the cavern's own
// tile rows (every cavern is 16 rows / 128px tall, but the display is
// 24 rows / 192px) -- name, oxygen, blank, score, blank, lives.
const NAME_ROW_Y = 128
const NAME_INK = encode_rgba(0, 0, 0)
const NAME_PAPER = encode_rgba(255, 255, 0)

const SCORE_ROW_Y = 152
const SCORE_INK = encode_rgba(255, 255, 0)
const SCORE_PAPER = encode_rgba(0, 0, 0)
const SCORE_TEXT = "High Score 000000   Score 000000"  // TBC: no scoring system wired up yet

// Lives display: one small Willy icon per remaining life, cycling the
// same right-facing walk-cycle frame every LIVES_ANIM_TICKS ticks.
const LIVES_ICON_INK = encode_rgba(0, 255, 255)
const LIVES_ICON_X = 8
const LIVES_ICON_Y = 168
const LIVES_ICON_STRIDE = 24  // 16px sprite + 8px gap
const LIVES_ANIM_TICKS = 8  // halved speed (was 4)
const LIVES_FRAMES = ["willy_right_0", "willy_right_1", "willy_right_2", "willy_right_3"]

// Oxygen row: red paper for its left 80px (10 cells), green for the
// rest, "AIR" labelled in white at the left, then a bar (also white)
// spanning pixel 25-248 that empties from the right as air runs out --
// wherever the bar's bit is 0, that cell's red/green paper shows
// through instead. draw_oxygen_row_background()/draw_oxygen_bar_fill()
// paint it solid at spawn/respawn/cavern-change; update_oxygen_bar()
// then only re-plots the newly-emptied columns each tick -- O(1)
// amortized over the bar's lifetime rather than redrawing it every frame.
const OXYGEN_ROW_Y = 136
const OXYGEN_INK = encode_rgba(255, 255, 255)
const OXYGEN_PAPER_RED = encode_rgba(255, 0, 0)
const OXYGEN_PAPER_GREEN = encode_rgba(0, 255, 0)
const OXYGEN_RED_CELLS = 10  // 80px
const OXYGEN_BAR_X = 25
const OXYGEN_BAR_WIDTH = 224  // pixel 25 .. 248 inclusive
const OXYGEN_BAR_HEIGHT = 4
const OXYGEN_BAR_Y = OXYGEN_ROW_Y + (8 - OXYGEN_BAR_HEIGHT) / 2  // vertically centred in the row

// Game-over sequence: the plinth sits bottom-centre of the cavern area
// (the 32x16-cell region above the HUD rows), Willy stands on it, and
// the boot starts directly above both, at the very top. Everything's
// white; the whole cavern area's paper cycles blue/red/magenta every
// tick while the boot descends 2px per stamp, GAME_OVER_BOOT_STEPS_PER_TICK
// stamps a tick (its previous stamps never erased, see state_game_over()),
// until it reaches Willy.
const GAME_OVER_X = 120            // (256 - 16) / 2 -- shared by plinth/Willy/boot
const GAME_OVER_PLINTH_Y = 112     // bottom of the 128px-tall cavern area
const GAME_OVER_WILLY_Y = 96       // GAME_OVER_PLINTH_Y - WILLY_HEIGHT
const GAME_OVER_BOOT_START_Y = 0
const GAME_OVER_BOOT_STEP = 2
const GAME_OVER_BOOT_STEPS_PER_TICK = 2  // 2 stamps/tick -- doubles the fall speed without thinning the trail
const GAME_OVER_INK = encode_rgba(255, 255, 255)
const GAME_OVER_PAPER_CYCLE = [1, 2, 3]  // spectrum_attr indices: blue, red, magenta

func enter_running(g) {
    g.update_func = state_running
}

// Paints the name row's attribute cells and centred cavern name --
// static per cavern, so this only needs calling when the whole display
// is cleared (cavern change, respawn), not every tick.
func draw_name_row(g) {
    for (var cx = 0; cx < 32; cx = cx + 1) {
        g.disp.set_attr(cx, int(NAME_ROW_Y / 8), NAME_INK, NAME_PAPER)
    }
    font.draw_text_centred(g.disp, g.font, g.cavern.name, NAME_ROW_Y, NAME_INK, NAME_PAPER)
}

// Paints the score row -- static placeholder text, see SCORE_TEXT.
func draw_score_row(g) {
    for (var cx = 0; cx < 32; cx = cx + 1) {
        g.disp.set_attr(cx, int(SCORE_ROW_Y / 8), SCORE_INK, SCORE_PAPER)
    }
    font.draw_text(g.disp, g.font, SCORE_TEXT, 0, SCORE_ROW_Y, SCORE_INK, SCORE_PAPER)
}

// Paints the oxygen row's fixed red/green background and "AIR" label --
// the bar itself is drawn separately (draw_oxygen_bar_fill()), since
// only the bar's pixels (not this row's attribute cells) change as air
// depletes.
func draw_oxygen_row_background(g) {
    var cy = int(OXYGEN_ROW_Y / 8)
    for (var cx = 0; cx < 32; cx = cx + 1) {
        var paper = OXYGEN_PAPER_GREEN
        if (cx < OXYGEN_RED_CELLS) {
            paper = OXYGEN_PAPER_RED
        }
        g.disp.set_attr(cx, cy, OXYGEN_INK, paper)
    }
    font.draw_text(g.disp, g.font, "AIR", 0, OXYGEN_ROW_Y, OXYGEN_INK, OXYGEN_PAPER_RED)
}

// Fills the oxygen bar solid -- call whenever Willy (re)spawns, since
// that's exactly when air_remaining resets to full.
func draw_oxygen_bar_fill(g) {
    for (var x = OXYGEN_BAR_X; x < OXYGEN_BAR_X + OXYGEN_BAR_WIDTH; x = x + 1) {
        for (var y = OXYGEN_BAR_Y; y < OXYGEN_BAR_Y + OXYGEN_BAR_HEIGHT; y = y + 1) {
            g.disp.plot(x, y, 1.0)
        }
    }
    g.oxygen_drawn_width = OXYGEN_BAR_WIDTH
}

// Re-plots (to background) only the columns that have newly emptied
// since the last call -- the bar's width tracks air_remaining /
// willy.AIR_MAX (1 air unit = 1px, every cavern gives the same budget,
// see willy.lox), and air only ever counts down, so this is a one-way
// shrink. air_remaining alone only steps once every AIR_TICKS_PER_UNIT
// ticks, which would jump the bar several pixels at once -- willy.air_tick
// (the tick count within the current air unit) fills in the gap so the
// bar empties smoothly, never more than a pixel at a time.
func update_oxygen_bar(g) {
    var fractional_air = g.willy.air_remaining - g.willy.air_tick / willy_module.AIR_TICKS_PER_UNIT
    var target = int(OXYGEN_BAR_WIDTH * fractional_air / willy_module.AIR_MAX)
    if (target < 0) { target = 0 }
    if (target >= g.oxygen_drawn_width) {
        return
    }
    for (var x = OXYGEN_BAR_X + target; x < OXYGEN_BAR_X + g.oxygen_drawn_width; x = x + 1) {
        for (var y = OXYGEN_BAR_Y; y < OXYGEN_BAR_Y + OXYGEN_BAR_HEIGHT; y = y + 1) {
            g.disp.plot(x, y, 0.0)
        }
    }
    g.oxygen_drawn_width = target
}

// Draws the four static HUD rows (name/score/oxygen background+label,
// then the oxygen bar solid) -- call whenever the whole display has
// just been cleared: __init__, every respawn, every cavern change.
func draw_static_hud(g) {
    draw_name_row(g)
    draw_score_row(g)
    draw_oxygen_row_background(g)
    draw_oxygen_bar_fill(g)
}

// Draws one icon per g.lives, all cyan, sharing the same right-facing
// walk-cycle frame (advancing every LIVES_ANIM_TICKS ticks, independent
// of Willy's own animation state).
func draw_lives(g) {
    var frame_name = LIVES_FRAMES[int(g.frame_count / LIVES_ANIM_TICKS) % len(LIVES_FRAMES)]
    var img = g.lib.get(frame_name)
    for (var i = 0; i < g.lives; i = i + 1) {
        g.disp.blit_sprite(img, LIVES_ICON_X + i * LIVES_ICON_STRIDE, LIVES_ICON_Y, LIVES_ICON_INK, encode_rgba(0, 0, 0))
    }
}

// Every moving sprite (Willy, guardians, Eugene) goes through the same
// three phases, each run to completion across all of them before the
// next starts: clear (erase wherever it last drew itself), move
// (position/animation/collision, no drawing), draw (paint at its new
// position). Keeping the phases fully separate -- not interleaved
// per-sprite -- means no sprite's fresh draw can ever be wiped out by
// another sprite's clear running later in the same tick.
func state_running(g, win) {
    g.controller.update(win)
    g.sound.play_next_tune_note()

    g.willy.clear(g.disp)
    g.cavern.clear_guardians(g.disp)
    g.cavern.clear_eugene(g.disp)

    // Guardians/Eugene move before Willy so his own pixel-perfect
    // collision check (handle_items_and_hazards() -> guardian_hit())
    // sees their current-tick position, not last tick's.
    g.cavern.update_guardians()
    g.cavern.update_eugene()
    g.willy.step(g.controller, g.cavern, g.disp, g.lib)

    g.cavern.draw_items(g.disp, g.lib, g.frame_count)
    g.cavern.animate_conveyor(g.disp)
    g.willy.draw(g.disp, g.lib, g.cavern)
    g.cavern.draw_guardians(g.disp, g.lib)
    g.cavern.draw_eugene(g.disp, g.lib)
    // Last, so the portal always renders on top -- Willy disappears
    // underneath it rather than erasing it.
    g.cavern.set_portal_flash(g.disp, g.lib, g.frame_count)
    draw_lives(g)
    update_oxygen_bar(g)
    g.frame_count = g.frame_count + 1

    if (g.willy.dead) {
        enter_die(g, win)
        return
    }

    var portal = g.cavern.portal
    if (g.cavern.is_portal_flashing() and g.willy.x == portal["x"] and g.willy.y == portal["y"]) {
        enter_portal(g, win)
    }
}

func enter_die(g, win) {
    win.set_target_fps(30)
    g.update_func = state_die
    g.die_tick = 0
    g.disp.begin_flash()
    g.sound.play_willy_dying()
}

// All-attribute flash (ink 7 down to 0, one tick each), then a full
// cavern reload/redraw and a fresh Willy spawn -- or game_over once
// lives run out.
func state_die(g, win) {
    var ink_index = 7 - g.die_tick
    if ink_index < 0 { ink_index = 0 }
    var flash_colour = spectrum_attr.colour_to_rgba(ink_index, true)
    g.disp.flash_ink(flash_colour)
    g.die_tick = g.die_tick + 1
    if (g.die_tick < DIE_FLASH_TICKS) {
        return
    }

    win.set_target_fps(g.target_fps)
    g.lives = g.lives - 1

    if (g.lives <= 0) {
        enter_game_over(g)
        return
    }

    g.cavern.reset_for_respawn()
    g.disp.clear(encode_rgba(0, 0, 0), encode_rgba(0, 0, 0))
    g.cavern.draw(g.disp, g.lib)
    g.willy.spawn(g.cavern)
    draw_static_hud(g)
    enter_running(g)
}

func enter_portal(g, win) {
    win.set_target_fps(30)
    g.update_func = state_portal
    g.portal_tick = 0
    g.disp.begin_flash()
    g.sound.play_level_end_swoop()
}

// Two ink cycles of 7 down to 1 (blue -- see PORTAL_FLASH_TICKS), then a
// fixed pause (placeholder for a remaining-air countdown), then the next
// cavern loads and play resumes there.
func state_portal(g, win) {
    if (g.portal_tick < PORTAL_FLASH_TICKS) {
        var ink_index = 7 - (g.portal_tick % PORTAL_FLASH_CYCLE_TICKS)
        g.disp.flash_ink(spectrum_attr.colour_to_rgba(ink_index, true))
    }
    g.portal_tick = g.portal_tick + 1
    if (g.portal_tick < PORTAL_FLASH_TICKS + PORTAL_PAUSE_TICKS) {
        return
    }

    win.set_target_fps(g.target_fps)
    enter_next_cavern(g)
}

// Loads cavern_<cavern_index>'s data/sprites and redraws disp with it --
// shared by __init__ (first cavern) and enter_next_cavern (every cavern
// after). Caller still owns spawning Willy into the new room.
func load_cavern(g, cavern_index) {
    g.cavern_index = cavern_index
    g.lib = assets.SpriteAssets()
    g.lib.load(format("caverns/cavern_%d_sprites.json", cavern_index))
    g.lib.load("assets/willy_sprites.json")

    g.cavern = cavern_module.Cavern()
    g.cavern.load(format("caverns/cavern_%d.json", cavern_index))

    g.disp.clear(encode_rgba(0, 0, 0), encode_rgba(0, 0, 0))
    g.cavern.draw(g.disp, g.lib)
}

// Bumps the cavern counter (wrapping past the last cavern back to the
// first) and starts the running state fresh in the new room.
func enter_next_cavern(g) {
    load_cavern(g, (g.cavern_index + 1) % CAVERN_COUNT)
    g.willy.spawn(g.cavern)
    draw_static_hud(g)
    g.frame_count = 0
    enter_running(g)
}

// Blanks the cavern area's bitmap and attribute cells (rows 0-15) to
// ink/paper -- like Display.clear(), but leaves the HUD rows below
// (16-23) untouched.
func clear_cavern_area(g, ink, paper) {
    for (var y = 0; y < 128; y = y + 1) {
        for (var x = 0; x < 256; x = x + 1) {
            g.disp.plot(x, y, 0.0)
        }
    }
    for (var cy = 0; cy < 16; cy = cy + 1) {
        for (var cx = 0; cx < 32; cx = cx + 1) {
            g.disp.set_attr(cx, cy, ink, paper)
        }
    }
}

// Repaints the HUD (undoing the death flash's colour corruption, so
// name/score/air/lives stay visible and correct throughout the
// sequence), then clears just the cavern area and paints the game-over
// tableau's static parts (plinth, Willy in his frame-3 pose) plus the
// boot's starting frame -- all white on the first paper colour of the
// cycle. state_game_over() takes over from here every tick.
func enter_game_over(g) {
    g.sound.play_game_over_swoop()
    draw_static_hud(g)
    draw_lives(g)

    var paper = spectrum_attr.colour_to_rgba(GAME_OVER_PAPER_CYCLE[0], true)
    clear_cavern_area(g, GAME_OVER_INK, paper)
    g.disp.blit_sprite(g.global_sprites.get("game_over_plinth"), GAME_OVER_X, GAME_OVER_PLINTH_Y, GAME_OVER_INK, paper)
    var willy_img = g.lib.get(g.willy.image_list[3])
    g.disp.blit_sprite(willy_img, GAME_OVER_X, GAME_OVER_WILLY_Y, GAME_OVER_INK, paper)
    g.game_over_paper_index = 0
    g.game_over_boot_y = GAME_OVER_BOOT_START_Y
    g.disp.blit_sprite(g.global_sprites.get("boot"), GAME_OVER_X, g.game_over_boot_y, GAME_OVER_INK, paper)
    g.update_func = state_game_over
}

// Every tick: cycles the whole cavern area's paper through
// GAME_OVER_PAPER_CYCLE (an attribute-only change, via set_attr -- never
// touches the bitmap, so it can't disturb the boot's trail) once, then
// stamps the boot GAME_OVER_BOOT_STEPS_PER_TICK times, 2px further down
// each stamp, without erasing its previous stamps -- so it leaves a
// solid trail behind it as it falls, twice as fast as one stamp/tick
// would without thinning that trail out. Stops advancing once it
// reaches Willy -- is_game_over() then tells the caller to stop calling
// tick() (one more frame still renders the final stamp).
func state_game_over(g, win) {
    g.game_over_paper_index = (g.game_over_paper_index + 1) % len(GAME_OVER_PAPER_CYCLE)
    var paper = spectrum_attr.colour_to_rgba(GAME_OVER_PAPER_CYCLE[g.game_over_paper_index], true)
    for (var cy = 0; cy < 16; cy = cy + 1) {
        for (var cx = 0; cx < 32; cx = cx + 1) {
            g.disp.set_attr(cx, cy, GAME_OVER_INK, paper)
        }
    }

    for (var step = 0; step < GAME_OVER_BOOT_STEPS_PER_TICK; step = step + 1) {
        if (g.game_over_boot_y >= GAME_OVER_WILLY_Y) {
            g.update_func = state_game_over_done
            return
        }
        g.game_over_boot_y = g.game_over_boot_y + GAME_OVER_BOOT_STEP
        if (g.game_over_boot_y > GAME_OVER_WILLY_Y) {
            g.game_over_boot_y = GAME_OVER_WILLY_Y
        }
        g.disp.blit_sprite(g.global_sprites.get("boot"), GAME_OVER_X, g.game_over_boot_y, GAME_OVER_INK, paper)
    }
}

// Frozen -- is_game_over() tells the caller to stop calling tick().
func state_game_over_done(g, win) {
}

class Game {
    __init__(cavern_index,target_fps,sound) {
        this.sound = sound
        this.disp = display.Display()
        this.font = assets.SpriteAssets()
        this.font.load("assets/font_sprites.json")
        this.global_sprites = assets.SpriteAssets()
        this.global_sprites.load("caverns/global_sprites.json")
        load_cavern(this, cavern_index)

        this.willy = willy_module.Willy(this.sound)
        this.willy.spawn(this.cavern)
        draw_static_hud(this)

        this.controller = willy_controller.Controller()

        this.frame_count = 0
        this.die_tick = 0
        this.portal_tick = 0
        this.game_over_paper_index = 0
        this.game_over_boot_y = 0
        this.lives = LIVES_START
        this.update_func = state_running
        this.target_fps = target_fps
    }

    is_game_over() -> bool {
        return this.update_func == state_game_over_done
    }

    is_dying() -> bool {
        return this.update_func == state_die
    }

    is_entering_portal() -> bool {
        return this.update_func == state_portal
    }

    tick(win) {
        this.sound.update()
        var f = this.update_func
        f(this, win)
    }
}
