import assets

//
// @file test_assets.lox
// @brief Loads test_sprites.json (simulated data covering both the
// "pixel" and "byte" data_types) and dumps each decoded sprite back out
// as ASCII art, so the decode can be checked by eye against the source.
//

var lib = assets.SpriteAssets()
lib.load("test_sprites.json")

func dump(name) {
    var arr = lib.get(name)
    print(format("-- %s (%dx%d) --", name, arr.width(), arr.height()))
    for (var y = 0; y < arr.height(); y = y + 1) {
        var row = ""
        for (var x = 0; x < arr.width(); x = x + 1) {
            if (arr.get(x, y) != 0.0) {
                row = row & "#"
            } else {
                row = row & "."
            }
        }
        print(row)
    }
}

print(format("loaded sprites: %s", lib.names()))
dump("tile_wall")
dump("willy_stand")
dump("guardian_diamond")

print(format("has('tile_wall') = %s", str(lib.has("tile_wall"))))
print(format("has('nope') = %s", str(lib.has("nope"))))
