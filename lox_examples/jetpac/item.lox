from gfx import *
from game_sprite import Sprite
import spectrum_attr

// @file item.lox
// @brief One class for rocket modules, fuel pods and collectibles,
// distinguished by kind. Derived from ItemPickup ($64E8)/
// CollectRocketItem/CarryRocketItem/PickupRocketItem (modules/fuel) and
// ItemCheckCollect ($6461) (collectibles). States state_falling,
// state_carried, state_docking, state_idle.
//
// Two Item instances exist (game.lox's rocket_item/collectible_item),
// matching the skool's own $5D38/$5D40 RAM slots. Each starts out
// holding one of the two rocket modules (init_module(), called once at
// Game construction, not gated/spawned) and only later, once that
// module is delivered, starts being reused for its slot's ongoing job:
// module-level spawn_fuel_pod(g)/spawn_collectible(g) hold those
// spawn-gate conditions (ItemNewFuelPod $65F9/ItemNewCollectible
// $65A8), called from spawner.lox.

const FUEL_DOCK_Y = 176    // $B0 -- PickupRocketItem's fuel-pod delivery check
const MODULE_DOCK_Y = 183  // $B7 -- PickupRocketItem's module delivery check
const CARRY_SNAP_DX = 6    // CarryRocketItem: close enough to the rocket's X to start docking
const FALL_STEP = 2        // IncYRedrawSprite: +2px/tick, falling or docking
const FUEL_PODS_NEEDED = 6 // RocketUpdate's fuel-pod-count gate ($601B)

// AlienCollision's ($6DE9) proximity test, shared by both item pickup
// and (later) alien-vs-Jetman collision.
const COLLECT_DX = 12  // $0C, $6E00
const COLLECT_DY = 21  // $15, $6E14

const SCORE_ROCKET_ITEM = 100  // CollectRocketItem: $0100
const SCORE_COLLECTIBLE = 250  // ItemCheckCollect: $0250

const COLLECTIBLE_NAMES = ["gold_bar", "radiation", "chemical_weapon", "plutonium", "diamond"]

// Raw Spectrum attribute bytes, read directly off their own drop
// routines: ItemDropGoldBar ($64A0, "$46"/gold), ItemDropPlutonium
// ($64BC, "$44"/green), ItemDropChemical ($64C2, "$45"/cyan -- its own
// comment names "radiation and plutonium" as the flashing items, but
// plutonium already has its dedicated green routine, so chemical_weapon
// is the other one this cyan slot covers). "diamond" is
// ItemDropRandomColour's own slot ($64D7): a fresh random attribute in
// $41-$47 every spawn, not a fixed one.
const COLLECTIBLE_COLOUR_ATTR = {
    "gold_bar": 70,
    "plutonium": 68,
    "radiation": 69,
    "chemical_weapon": 69
}
const RANDOM_COLOUR_MIN = 65  // $41
const RANDOM_COLOUR_MAX = 71  // $47

func attr_colour(attr) {
    var d = spectrum_attr.decode_attribute(attr)
    return spectrum_attr.colour_to_rgba(d["ink"], d["bright"])
}

func near_jetman(item, jetman) -> bool {
    var dx = item.x - jetman.x
    if (dx < 0.0) {
        dx = -dx
    }
    var dy = item.y - jetman.y
    if (dy < 0.0) {
        dy = -dy
    }
    return dx < COLLECT_DX and dy < COLLECT_DY
}

class Item < Sprite {
    __init__(sound) {
        super.__init__()
        this.sound = sound
        this.frames = 1
        this.kind = "fuel"   // "fuel" | "module" | "collectible"
        this.colour = encode_rgba(255, 255, 255)
        this.paper = encode_rgba(0, 0, 0)
        this.or_blit = true  // don't punch through a platform's own art once landed/docked on it
        this.active = false
        this.update_func = state_idle
    }

    is_active() -> bool {
        return this.active
    }

    // Dispatches through update_func -- named step() to match every
    // other actor class's own convention.
    step(jetman, rocket, platforms, score) {
        var f = this.update_func
        f(this, jetman, rocket, platforms, score)
    }
}

// Activates item as a rocket module sitting at its own default
// position -- unconditional, no gate, called exactly twice ever (once
// per slot, at Game construction). RocketReset ($60A7) copies 24 bytes
// -- the rocket record plus BOTH the top-module and middle-module
// templates -- into $5D30 in one go: $5D38 (the "rocket module
// object" ItemNewFuelPod/CollectRocketItem read) receives the TOP
// module, and $5D40 (ItemNewCollectible's own "collectible object")
// receives the MIDDLE module. Both are therefore active from frame
// one -- not a per-tick spawn like fuel pods/collectibles -- and each
// slot only becomes available for its *other* job (fuel pod /
// collectible respectively) once its pre-seeded module is delivered,
// since collecting it despawns the same Item instance that spawn_fuel_pod/
// spawn_collectible later reuses. See game.lox's __init__ for the two
// call sites (one per slot) and CLAUDE.md for the address cross-reference.
func init_module(item, key, sprite, static_data) {
    var d = static_data[key]
    item.kind = "module"
    item.image_list = [sprite]
    item.frame = 0
    item.colour = attr_colour(d["attr"])
    item.x = float(d["x"])
    item.y = float(d["y"])
    item.active = true
    item.last_x = nil
    item.last_y = nil
    item.update_func = state_falling
}

// Spawns a falling fuel pod at x/y from the static default record,
// gated exactly as ItemNewFuelPod: Jetman must be alive, no fuel pod
// already active, fewer than FUEL_PODS_NEEDED collected, and
// game_timer's low nibble at zero (the caller's own timer -- see
// spawner.lox once it exists).
func spawn_fuel_pod(item, jetman, rocket, static_data) -> bool {
    if (jetman.is_dead() or item.active or rocket.fuel >= FUEL_PODS_NEEDED) {
        return false
    }
    var d = static_data["default_fuel_pod"]
    item.kind = "fuel"
    item.image_list = ["fuel_pod"]
    item.frame = 0
    item.colour = attr_colour(d["attr"])
    item.x = float(d["x"])
    item.y = float(d["y"])
    item.active = true
    item.last_x = nil
    item.last_y = nil
    item.update_func = state_falling
    return true
}

// Spawns a falling collectible (one of the 5 pickup types, chosen at
// random -- the ROM instead cycles by player level, out of scope for a
// level-1-only port) at a random drop column from
// data/jetpac_static.json's item_drop_columns.
func spawn_collectible(item, jetman, static_data) -> bool {
    if (jetman.is_dead() or item.active) {
        return false
    }
    var d = static_data["default_item"]
    var columns = static_data["item_drop_columns"]
    var name = COLLECTIBLE_NAMES[int(rand() * len(COLLECTIBLE_NAMES))]
    item.kind = "collectible"
    item.image_list = [name]
    item.frame = 0
    if (name == "diamond") {
        item.colour = attr_colour(RANDOM_COLOUR_MIN + int(rand() * (RANDOM_COLOUR_MAX - RANDOM_COLOUR_MIN + 1)))
    } else {
        item.colour = attr_colour(COLLECTIBLE_COLOUR_ATTR[name])
    }
    item.x = float(columns[int(rand() * len(columns))])
    item.y = float(d["y"])
    item.active = true
    item.last_x = nil
    item.last_y = nil
    item.update_func = state_falling
    return true
}

// Falling: drops FALL_STEP/tick unless a platform is directly
// underfoot (matches ItemCheckCollect/PickupRocketItem's shared
// "bit-2 set -> don't fall" platform test); collected on Jetman
// proximity -- a collectible scores and despawns immediately, a
// module/fuel pod starts following Jetman (CollectRocketItem).
func state_falling(item, jetman, rocket, platforms, score) {
    var result = platforms.collide(item.x, item.y, item.y + FALL_STEP, 1)
    if (result["landed"]) {
        // Snap to the platform's own surface -- without this, the item
        // rests wherever FALL_STEP's 2px increments happened to land it
        // (anywhere up to LAND_TOLERANCE off), which reads as resting
        // partway inside the platform.
        item.y = result["snap_y"]
    } else if (!result["blocked_x"]) {
        item.y = item.y + FALL_STEP
    }

    if (!near_jetman(item, jetman)) {
        return
    }

    if (item.kind == "collectible") {
        item.sound.pickup_item()
        score.add(SCORE_COLLECTIBLE)
        item.active = false
        item.update_func = state_idle
    } else {
        item.sound.pickup_fuel()
        score.add(SCORE_ROCKET_ITEM)
        item.update_func = state_carried
    }
}

// Carried: follows Jetman's feet; once within CARRY_SNAP_DX of the
// rocket's own X, locks X to the rocket's and starts docking.
func state_carried(item, jetman, rocket, platforms, score) {
    item.x = jetman.x
    item.y = jetman.y

    var dx = rocket.x - item.x
    if (dx < 0.0) {
        dx = -dx
    }
    if (dx < CARRY_SNAP_DX) {
        item.x = rocket.x
        item.update_func = state_docking
    }
}

// Docking: slides down to the module/fuel dock Y, then attaches to the
// rocket and despawns.
func state_docking(item, jetman, rocket, platforms, score) {
    var target = MODULE_DOCK_Y
    if (item.kind == "fuel") {
        target = FUEL_DOCK_Y
    }
    if (item.y < target) {
        item.y = item.y + FALL_STEP
        return
    }

    if (item.kind == "fuel") {
        rocket.add_fuel()
    } else {
        rocket.add_module()
    }
    item.active = false
    item.update_func = state_idle
}

// Inactive slot -- spawn_fuel_pod/spawn_collectible reactivate it.
func state_idle(item, jetman, rocket, platforms, score) {
}
