from gfx import *
import item as item_module
import alien as alien_module
import spectrum_attr

// @file spawner.lox
// @brief The ROM's NewActor ($6971): advances a timer and gates
// fuel-pod, collectible, and alien spawns (fuel-pod/collectible gate
// conditions live in item.lox as spawn_fuel_pod/spawn_collectible;
// this file just calls them on the ROM's own cadence -- new_fuel_pod
// every (255-timer)%16==0 tick, new_collectible every timer%128==0
// tick). Rocket modules are NOT spawned here -- both are pre-seeded
// once at Game construction (item.lox's init_module(), see its own
// header) and never spawn again; this file only starts trying
// spawn_fuel_pod/spawn_collectible once each one's slot is free, which
// naturally only happens after its pre-seeded module has been
// delivered. Also owns alien spawning itself, since alien.lox has no
// equivalent gate function of its own (level 1 has only meteors,
// spawned here directly).

const ALIEN_SPAWN_TICKS = 96  // no ROM equivalent cadence for meteors specifically; tuned for this port
const METEOR_Y_SPEED = 0.25   // tuned: half the original 0.5
const METEOR_X_SPEED_MIN = 0.6  // tuned: double the original 0.3-0.7 range
const METEOR_X_SPEED_MAX = 1.4

// NewActor's own alien colour: "$02..$05 from the slot index" -- plain
// small ink-index bytes, same convention gfx_params_platforms' own attr
// field uses (paper black, not bright), not a full bright attribute.
const ALIEN_COLOUR_BASE = 2
const ALIEN_COLOUR_COUNT = 4

func alien_colour(slot) {
    var d = spectrum_attr.decode_attribute(ALIEN_COLOUR_BASE + slot % ALIEN_COLOUR_COUNT)
    return spectrum_attr.colour_to_rgba(d["ink"], d["bright"])
}

class Spawner {
    __init__() {
        this.timer = 0
    }

    tick(g) {
        this.timer = (this.timer + 1) % 256

        if (!g.rocket_item.is_active() and (255 - this.timer) % 16 == 0) {
            item_module.spawn_fuel_pod(g.rocket_item, g.jetman, g.rocket, g.static_data)
        }

        if (!g.collectible_item.is_active() and this.timer % 128 == 0) {
            item_module.spawn_collectible(g.collectible_item, g.jetman, g.static_data)
        }

        // NewActor's own gate ($69BE-$69C7): alien spawns require
        // Jetman's direction to be FLY or WALK, same as the fuel-pod/
        // collectible gates above -- while he's hidden (boarding a
        // launching rocket), nothing new spawns at all.
        if (!g.jetman.is_hidden() and this.timer % ALIEN_SPAWN_TICKS == 0) {
            spawn_alien_if_free(g)
        }
    }
}

const METEOR_SPAWN_Y_MIN = 32.0   // matches alien.lox's own vertical bounce range
const METEOR_SPAWN_Y_MAX = 192.0

// A free alien slot gets the current level's alien type
// (item_level_object_types $6A2D, level % 8 -- see alien.lox's
// ALIEN_TYPES), entering from the left edge (travelling right) or the
// right edge (travelling left) at a random height, coloured by its own
// pool slot index.
func spawn_alien_if_free(g) {
    for (var i = 0; i < len(g.aliens); i = i + 1) {
        var a = g.aliens[i]
        if (!a.is_active()) {
            var vx = METEOR_X_SPEED_MIN + rand() * (METEOR_X_SPEED_MAX - METEOR_X_SPEED_MIN)
            var x = 0.0
            if (rand() < 0.5) {
                x = 255.0
                vx = -vx
            }
            var y = METEOR_SPAWN_Y_MIN + rand() * (METEOR_SPAWN_Y_MAX - METEOR_SPAWN_Y_MIN)
            alien_module.spawn_alien(a, x, y, vx, METEOR_Y_SPEED, alien_colour(i), g.rocket.level)
            return
        }
    }
}
