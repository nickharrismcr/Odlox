from gfx import *
// 2d particle system fireworks demo


import random;
import colour;
from math import * 
import particle_sys;

MIN_PARTICLES=20
MAX_PARTICLES=100
MIN_DELAY=10
MAX_DELAY= 30

 
// particle update function
func move(particle) {
    var dpos = particle.dpos;
    dpos.x = dpos.x * 0.98;
    dpos.y = dpos.y + 0.1;  //gravity
    particle.dpos = dpos; // vec2 is a value type -- dpos is a copy, so the
                           // mutations above need writing back explicitly
    particle.size = particle.size * 0.97; // Gradually reduce size
}

// return a particle initialisation closure
func init(col1,col2) {

    // Capped at 300 (was 1000): steady-state concurrent particle count is roughly
    // (spawn rate) x (avg lifetime), so an unbounded lifemax let long-lived stragglers
    // keep the total climbing for tens of seconds after every burst.
    var lifemax=random.integer(20,300);
    var speedmax=random.integer(1,7);
    var sizemax=random.integer(5,10);
    var cols=[col1,col2]; // built once per emitter, captured by the closure

    // anonymous closure over lifemax/speedmax/sizemax/cols
    return func(particle) {
        particle.dpos = vec2(1,1); // Initial velocity
        var angle = random.float(0, 2 * PI); // Random angle
        particle.dpos = rotate2d(particle.dpos, angle); // Rotate the initial velocity
        particle.dpos = scale2(particle.dpos, random.float(0.01, speedmax)); // Scale the velocity

        particle.life = random.integer(1, lifemax); // Random life
        particle.size = random.float(1, sizemax);
        particle.col = random.choice(cols);
    };
}

func random_vec_2D(xmin,xmax,ymin,ymax) {
  return vec2(random.integer(xmin,xmax),random.integer(ymin,ymax))
}

func queue_random_emitter(width,height,delay){
    var pos=random_vec_2D(200,width-200,0,height/2);
    var pcols=colour.primary_colours();
    var ecol1 = pcols[random.choice(pcols.keys())];
    var ecol2 = pcols[random.choice(pcols.keys())];
    
    emitters.queue(particle_sys.Emitter(pos, init(ecol1,ecol2), move), random.integer(MIN_PARTICLES, MAX_PARTICLES), delay); 
}
STARS=300
func make_stars(){
    var stars=[];
    for ( var i = 0; i < STARS ; i=i+1 ){
        var pos=random_vec_2D(0,width,0,height);
        var size=1;
        var a=random.integer(1,255);
        stars.append([pos,size,vec4(255,255,255,a)]);
    }
    return stars;
}

func update_stars(stars, batch) {
    foreach (var s in stars) {

        if (random.integer(0,1000) < 4) {
            // vec4 is a value type, so this reassigns the whole list
            // element rather than mutating a component in place -- no
            // allocation cost either way (see docs/plans/inline-vec-value.md).
            s[2] = vec4(s[2].x, s[2].y, s[2].z, random.integer(1, 255));
        }
        pos,size,col = s
        batch.add_circle(pos, size, col);
    }
}

var width=1500;
var height=900;
var win = window(width,height);
win.init();
win.show_fps(true);
win.toggle_fullscreen()
width = win.get_screen_width();
height = win.get_screen_height();
 
var emitters = particle_sys.Emitters();

stars = make_stars();

// Single shared circle batch for both particles and stars -- both are
// filled circles drawn under the same BLEND_ADD blend mode, so one
// clear()/draw() per frame covers everything instead of one
// win.circle_fill() native call per particle/star. reserve() sized
// against a measured 900-frame run at these constants (avg 670, peak
// 1098 concurrent particles) plus margin, so steady-state frames add
// zero backing-array growth.
var particle_batch = batch2d(win.BATCH2D_CIRCLE);
particle_batch.reserve(STARS + 1500);

while (!win.should_close()) {

    win.begin();
    win.begin_blend_mode("BLEND_ADD");
    win.clear(colour.BLACK); // Clear the window with black
    emitters.update();
    if (emitters.queue_length() < 3 ) {
        queue_random_emitter(width,height,random.integer(MIN_DELAY, MAX_DELAY));
    }
    particle_batch.clear();
    foreach ( var e in emitters.get()) {
        foreach (var p in e.get_particles()) {
            particle_batch.add_circle(p.pos, p.size, p.col);
        }
    }
    update_stars(stars, particle_batch);
    particle_batch.draw();
    win.end_blend_mode();
    win.end();

}

win.close();
