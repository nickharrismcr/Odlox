from gfx import *
import spectrum_attr
import item as item_module
import alien as alien_module

// @file rocket.lox
// @brief The Rocket: modules (1..3), fuel (0..6), takeoff/landing, and
// colour banding by fuel collected. States state_on_pad/
// state_taking_off/state_landing, mirroring the skool's own move
// values $09/$0A/$0B (RocketUpdate/RocketTakeoff/RocketLanding).
// Full level cycling (new alien sets, a fresh screen) is out of scope,
// see docs/plans/jetpac-port.md -- this port loops the same screen's
// pad<->launch cycle indefinitely -- but this.level mirrors
// RocketTakeoff/LevelNew's own per-cycle reset cadence
// (state_taking_off()): modules only resets every 4th launch.

const ROCKET_PAD_Y = 183          // $B7, RocketLanding's landed check
const ROCKET_LAUNCH_TOP_Y = 40    // $28, RocketTakeoff's top-of-screen check
const FUEL_PODS_NEEDED = 6        // RocketUpdate's takeoff gate
const RISE_STEP = 1               // RocketTakeoff/RocketLanding: 1px/tick (dec/inc)
const ROCKET_TILE = 16
const MAX_MODULES = 3
const STACK_HEIGHT = MAX_MODULES * ROCKET_TILE  // module stack, top to y
const FLAME_HEIGHT = 16                          // flame sprites extend below y, during takeoff/landing
const ERASE_HEIGHT = STACK_HEIGHT + FLAME_HEIGHT // clear()'s blank buffer covers both

const MODULE_SPRITES = ["rocket_u1_bottom", "rocket_u1_middle", "rocket_u1_top"]
const FLAME_SPRITES = ["rocket_flames_0", "rocket_flames_1"]
const FLAME_ANIM_TICKS = 4

const CELL = 8
const SCREEN_W = 256
const SCREEN_H = 192
const FLASH_TICKS = 16  // UpdateRocketColour: timer bit 4 -> toggles every 16 game ticks

// UpdateRocketColour ($66FC): banding only kicks in once the rocket is
// fully built (modules == MAX_MODULES) -- a partially-built stack, or
// one with zero fuel, is always plain white. A full tank (fuel >=
// FUEL_PODS_NEEDED) doesn't band -- it flashes the *entire* stack
// between magenta and white on the game timer. Otherwise the bottom
// `fuel*8` pixels are solid magenta counting up from the rocket's own
// base, the rest above solid white.
//
// row_top_y is the top pixel of ONE attribute row -- coloured by
// testing its own *midpoint* against the magenta/white pixel boundary
// rather than a discrete cell index, because ROCKET_PAD_Y (183) isn't a
// multiple of 8: a 16px module tile's sprite straddles 3 attribute
// rows, not a clean 2. Continuous pixel-space math is correct
// regardless of alignment.
func row_ink(rocket, row_top_y, white, magenta, flash_on) {
    if (rocket.modules < MAX_MODULES or rocket.fuel == 0) {
        return white
    }
    if (rocket.fuel >= FUEL_PODS_NEEDED) {
        if (flash_on) { return magenta }
        return white
    }
    var boundary_y = rocket.y - float(rocket.fuel) * float(CELL)
    var row_mid = float(row_top_y) + float(CELL) / 2.0
    if (row_mid >= boundary_y) {
        return magenta
    }
    return white
}

// AlienCollision ($6DE9), reused by RocketUpdate ($66D0) with IX=Rocket
// for Jetman-touches-rocket proximity: X within 12px; Y asymmetric --
// within 21px at-or-below the rocket's own Y, only (height-14) above it
// (a tighter catch window from above, since Jetman has to actually
// reach the rocket's own top rather than just being above it).
const TOUCH_DX = 12.0
const TOUCH_DY_BELOW = 21.0

func near_jetman(rocket, jetman) -> bool {
    var dx = jetman.x - rocket.x
    if (dx < 0.0) { dx = -dx }
    if (dx >= TOUCH_DX) {
        return false
    }
    var dy = jetman.y - rocket.y
    if (dy >= 0.0) {
        return dy < TOUCH_DY_BELOW
    }
    dy = -dy
    return dy < (rocket.height - 14.0)
}

class Rocket {
    __init__(static_data, sound) {
        var d = static_data["default_rocket"]
        this.sound = sound
        this.x = float(d["x"])
        this.y = float(d["y"])
        this.height = float(d["height"])
        this.modules = d["modules"]
        this.fuel = d["fuel"]
        this.update_func = state_on_pad
        this.flame_tick = 0
        this.flame_frame = 0
        this.colour_tick = 0
        this.level = 0  // mirrors $5DF0 -- see state_taking_off()

        this.last_x = nil
        this.last_y = nil
        this.blank = float_array(ROCKET_TILE, ERASE_HEIGHT)
        this.erase_ink = nil
        this.erase_paper = nil
    }

    // SfxRocketBuild: "activated when ship module is dropped, or fuel
    // cell touches the rocket base" -- both delivery events share it.
    // Reaching FUEL_PODS_NEEDED doesn't launch by itself, see
    // state_on_pad().
    add_fuel() {
        this.sound.rocket_build()
        this.fuel = this.fuel + 1
    }

    add_module() {
        this.sound.rocket_build()
        if (this.modules < MAX_MODULES) {
            this.modules = this.modules + 1
        }
    }

    is_taking_off() -> bool {
        return this.update_func == state_taking_off
    }

    // jetman/game are only used by state_on_pad/state_landing, but
    // threaded through every state uniformly since they share one
    // dispatch.
    step(jetman, game) {
        var f = this.update_func
        f(this, jetman, game)
    }

    // Erases from the topmost possible module tile (y - STACK_HEIGHT)
    // down through the flame's own extent (y + FLAME_HEIGHT) -- a
    // fixed region regardless of the current module count, so a
    // newly-docked module never leaves a stale un-erased gap above it.
    clear(disp) {
        if (this.last_x != nil) {
            disp.blit_sprite(this.blank, this.last_x, this.last_y - STACK_HEIGHT, this.erase_ink, this.erase_paper)
        }
    }

    // Draws the module stack bottom-up, then the thruster flame while
    // taking off/landing. Sprite pixels for every tile are blitted
    // first, then colour banding (row_ink()) is applied in a separate
    // pass across every attribute row the stack spans -- not
    // interleaved per tile, since adjacent tiles' attribute footprints
    // overlap by one row (ROCKET_PAD_Y isn't 8-aligned) and a later
    // tile's own blit would stomp an earlier tile's correct override.
    draw(disp, lib) {
        var white = encode_rgba(255, 255, 255)
        var magenta = encode_rgba(255, 0, 255)
        var black = encode_rgba(0, 0, 0)

        this.colour_tick = this.colour_tick + 1
        var flash_on = int(this.colour_tick / FLASH_TICKS) % 2 == 0

        var cx = int(this.x / 8)
        var cy = int(this.y / 8)
        this.erase_ink = disp.get_ink(cx, cy)
        this.erase_paper = disp.get_paper(cx, cy)

        var col_x0 = int(this.x / CELL)
        var col_x1 = int((this.x + float(ROCKET_TILE) - 1.0) / CELL)

        // or_blit: the bottom tile's own transparent gaps (between the
        // landing struts) shouldn't punch through the pad platform
        // underneath. Blitted plain white here; the colouring pass
        // below repaints the real colour right after.
        var tile_y = int(this.y) - ROCKET_TILE
        for (var i = 0; i < this.modules; i = i + 1) {
            disp.blit_sprite(lib.get(MODULE_SPRITES[i]), int(this.x), tile_y, white, black, false, true)
            tile_y = tile_y - ROCKET_TILE
        }

        if (this.modules > 0) {
            var cy_bottom = int((int(this.y) - 1) / CELL)
            var cy_top = int((int(this.y) - this.modules * ROCKET_TILE) / CELL)
            for (var row_cy = cy_top; row_cy <= cy_bottom; row_cy = row_cy + 1) {
                // set_attr doesn't clip itself (unlike blit_sprite
                // above) -- a fully-built stack legitimately reaches
                // above row 0 near the top of a launch.
                if (row_cy < 0 or row_cy >= SCREEN_H / CELL) {
                    continue
                }
                var ink = row_ink(this, row_cy * CELL, white, magenta, flash_on)
                for (var cxi = col_x0; cxi <= col_x1; cxi = cxi + 1) {
                    if (cxi < 0 or cxi >= SCREEN_W / CELL) {
                        continue
                    }
                    disp.set_attr(cxi, row_cy, ink, black)
                }
            }
        }

        if (this.update_func == state_taking_off or this.update_func == state_landing) {
            disp.blit_sprite(lib.get(FLAME_SPRITES[this.flame_frame]), int(this.x), int(this.y), encode_rgba(255, 0, 0), black, false, true)
        }

        this.last_x = int(this.x)
        this.last_y = int(this.y)
    }
}

func enter_on_pad(r) {
    r.update_func = state_on_pad
}

func enter_taking_off(r) {
    r.update_func = state_taking_off
}

func enter_landing(r) {
    r.update_func = state_landing
    r.y = float(ROCKET_LAUNCH_TOP_Y)
}

// RocketUpdate ($66D0): polls every tick for a full tank AND Jetman
// actually touching the rocket (near_jetman()) before launching --
// reaching FUEL_PODS_NEEDED alone only starts the full-tank flash. On a
// genuine touch, Jetman boards (vanishes, not a death) and gets a bonus
// life ($66F5) before takeoff begins. Aliens are cleared here too:
// RocketModulesReset ($6624) only runs once the rocket reaches the top,
// but Jetman is hidden the whole round trip regardless and NewActor's
// own gate blocks anything new from spawning meanwhile, so clearing
// existing aliens at boarding keeps the screen quiet for the whole
// window rather than only part of it.
func state_on_pad(r, jetman, game) {
    if (!jetman.is_dead() and r.fuel >= FUEL_PODS_NEEDED and near_jetman(r, jetman)) {
        jetman.board()
        game.lives = game.lives + 1
        foreach (var a in game.aliens) {
            alien_module.hide(a)
        }
        enter_taking_off(r)
    }
}

func animate_flame(r) {
    r.flame_tick = r.flame_tick + 1
    if (r.flame_tick >= FLAME_ANIM_TICKS) {
        r.flame_tick = 0
        r.flame_frame = (r.flame_frame + 1) % len(FLAME_SPRITES)
    }
}

// RocketTakeoff/RocketLanding ($6690/$66B4) call SfxThrusters ($67B6)
// every tick while rising/falling -- not Jetman's own jetpack (see
// jetman.lox).
func state_taking_off(r, jetman, game) {
    r.y = r.y - RISE_STEP
    r.sound.thrust(r.y)
    animate_flame(r)
    if (r.y <= ROCKET_LAUNCH_TOP_Y) {
        // Fuel resets every time; modules only resets via RocketReset
        // ($60A7), which LevelNew ($6083) calls only when the new level
        // number is a multiple of 4 -- 3 launches out of 4 come back
        // still fully built, needing only a refuel. r.level mirrors
        // $5DF0's own increment/mod-4 check.
        r.fuel = 0
        r.level = r.level + 1
        if (r.level % 4 == 0) {
            r.modules = 1
            item_module.init_module(game.rocket_item, "default_top_module", "rocket_u1_top", game.static_data)
            item_module.init_module(game.collectible_item, "default_middle_module", "rocket_u1_middle", game.static_data)
        }
        enter_landing(r)
    }
}

func state_landing(r, jetman, game) {
    r.y = r.y + RISE_STEP
    r.sound.thrust(r.y)
    animate_flame(r)
    if (r.y >= ROCKET_PAD_Y) {
        r.y = float(ROCKET_PAD_Y)
        r.sound.stop_thrust()
        enter_on_pad(r)
        // Jetman boarded rather than dying, so he respawns here
        // instead of through Game's death/respawn timer -- no life
        // lost.
        jetman.spawn(game.static_data)
    }
}
