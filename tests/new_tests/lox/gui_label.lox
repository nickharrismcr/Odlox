// Label: text/font_size/colour are plain mutable fields, draw() forwards
// to win.text() with them, and it defaults to colour.WHITE when no
// text_colour is given. Not hit-testable by default.
import gui
import colour

class Fake_Win {
    __init__() { this.calls = [] }
    text(text, x, y, font_size, colour_value) {
        this.calls.append([text, x, y, font_size, colour_value])
    }
}

var label = gui.Label(10, 20, "hello")
print label.text == "hello"
print label.font_size == 16
print label.colour == colour.WHITE
print label.contains(15, 25) == false // w/h default to 0 -- only its exact corner point can match

var win = Fake_Win()
label.draw(win)
print win.calls[0][0] == "hello"
print win.calls[0][1] == 10
print win.calls[0][2] == 20
print win.calls[0][3] == 16
print win.calls[0][4] == colour.WHITE

label.text = "updated"
label.draw(win)
print win.calls[1][0] == "updated"

var custom = gui.Label(0, 0, "x", 24, colour.RED)
print custom.font_size == 24
print custom.colour == colour.RED
