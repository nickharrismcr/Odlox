//
// @file string.lox
// @brief String manipulation utilities: split(string, delimiter).
//
// @author odlox Project
// @date 2025
//

func split(s: string, delim: string) -> List[string] {
    var rv=[];
    var w="";

    foreach (var c in s) {
        if (c==delim) {
            append(rv,w);
            w="";
        } else {
            w=w &c;
        }
    }
    if (w!=""){
        append(rv,w);
    }
    return rv;
}