from gfx import *
import box2d
import random
import math
import colour

// box2d native-module demo: two switchable scenes.
//   1 - top-down view, 100 circles with random pos/velocity, no
//       gravity/friction, bouncing elastically off each other and
//       four sealed boundary walls.
//   2 - side view with gravity and a few angled static ramps, no floor --
//       balls dropped continuously from the top at random x positions
//       bounce down through the ramps and off the bottom of the screen.
// Press 1/2 to switch scenes, R to reset/rebuild the active scene.

const STATIC = 0
const DYNAMIC = 2

const SCALE = 25.0 // pixels per metre

// WIDTH/HEIGHT/WORLD_W/WORLD_H are plain globals, not consts: their real
// values aren't known until the window exists and toggle_fullscreen() has
// run (see the "Main loop / scene switching" section at the bottom of this
// file, which sets them before Scene1()/Scene2() are constructed). Global
// name lookup for these is only ever done when a function/method actually
// runs, not at class/function declaration time, so referencing them here --
// textually above where they're actually assigned -- is fine.
var WIDTH = 0
var HEIGHT = 0
var WORLD_W = 0.0
var WORLD_H = 0.0

// Box2D is Y-up; the window is Y-down with the origin at the top-left.
// This mapping puts world y=0 at the bottom of the window (floor-friendly
// for scene 2) and is used unchanged by scene 1 too, where gravity is
// zero so the axis convention doesn't matter physically.
func to_screen(pos) {
    return vec2(pos.x * SCALE, HEIGHT - pos.y * SCALE)
}

// ---------------------------------------------------------------------
// Scene 1: sealed box of elastic, frictionless bouncing circles.

const SCENE1_COUNT = 500
const SCENE1_KILLER_COUNT = 40

class Scene1 {
    init() {
        this.world = box2d.world(vec2(0.0, 0.0))
        this.ids = []
        this.colours = []
        this.radii = []

        // Four static walls sealing the world's own extents so circles
        // never leave the visible area.
        wall_t = 0.5
        this.world.add_box(vec2(-wall_t / 2, WORLD_H / 2), vec2(wall_t / 2, WORLD_H / 2 + wall_t), 0.0, STATIC, 1.0, 0.0, 1.0)
        this.world.add_box(vec2(WORLD_W + wall_t / 2, WORLD_H / 2), vec2(wall_t / 2, WORLD_H / 2 + wall_t), 0.0, STATIC, 1.0, 0.0, 1.0)
        this.world.add_box(vec2(WORLD_W / 2, -wall_t / 2), vec2(WORLD_W / 2 + wall_t, wall_t / 2), 0.0, STATIC, 1.0, 0.0, 1.0)
        this.world.add_box(vec2(WORLD_W / 2, WORLD_H + wall_t / 2), vec2(WORLD_W / 2 + wall_t, wall_t / 2), 0.0, STATIC, 1.0, 0.0, 1.0)

        for (i = 0; i < SCENE1_COUNT; i = i + 1) {
            // 40-80px diameter -> 20-40px radius -> metres via SCALE.
            r = random.float(10.0, 30.0) / SCALE
            x = random.float(r + 0.1, WORLD_W - r - 0.1)
            y = random.float(r + 0.1, WORLD_H - r - 0.1)
            angle = random.float(0.0, 2.0 * math.PI)
            speed = random.float(6.0, 14.0)
            id = this.world.add_circle(vec2(x, y), r, DYNAMIC, 1.0, 0.0, 1.0)
            this.world.set_velocity(id, vec2(math.cos(angle) * speed, math.sin(angle) * speed))
            this.ids.append(id)
            this.radii.append(r)
            this.colours.append(colour.hsv_to_rgb(random.float(1,50), 0.8, 1.0))
        }

        // Killer balls: white, despawn any regular ball they touch (see
        // step()'s collision handling below) but bounce off each other
        // normally. Tracked in the same ids/colours/radii lists as
        // everything else, just remembered separately (killer_ids) so
        // none of them is ever a despawn target.
        this.killer_ids = []
        kr = 12.5 / SCALE // half the previous 25px radius
        for (k = 0; k < SCENE1_KILLER_COUNT; k = k + 1) {
            kx = random.float(kr + 0.1, WORLD_W - kr - 0.1)
            ky = random.float(kr + 0.1, WORLD_H - kr - 0.1)
            kangle = random.float(0.0, 2.0 * math.PI)
            kspeed = random.float(6.0, 14.0)
            kid = this.world.add_circle(vec2(kx, ky), kr, DYNAMIC, 1.0, 0.0, 1.0)
            this.world.set_velocity(kid, vec2(math.cos(kangle) * kspeed, math.sin(kangle) * kspeed))
            this.killer_ids.append(kid)
            this.ids.append(kid)
            this.radii.append(kr)
            this.colours.append(colour.WHITE)
        }
    }

    step() {
        this.world.step(1.0 / 60.0)

        // Any ball a killer ball touches despawns; killer-vs-killer
        // contacts are left alone (they just bounce off each other).
        // Collect ids to remove first rather than mutating this.ids
        // mid-loop.
        to_remove = []
        foreach (var pair in this.world.collisions()) {
            a_killer = this.killer_ids.find(pair[0]) != nil
            b_killer = this.killer_ids.find(pair[1]) != nil
            if (a_killer and !b_killer) {
                to_remove.append(pair[1])
            } else if (b_killer and !a_killer) {
                to_remove.append(pair[0])
            }
        }

        if (len(to_remove) > 0) {
            new_ids = []
            new_colours = []
            new_radii = []
            i = 0
            foreach (var id in this.ids) {
                if (to_remove.find(id) != nil) {
                    this.world.remove(id)
                } else {
                    new_ids.append(id)
                    new_colours.append(this.colours[i])
                    new_radii.append(this.radii[i])
                }
                i = i + 1
            }
            this.ids = new_ids
            this.colours = new_colours
            this.radii = new_radii
        }
    }

    // Every non-killer ball has been despawned.
    regular_remaining() {
        return len(this.ids) - len(this.killer_ids)
    }

    draw(win) {
        i = 0
        foreach (var id in this.ids) {
            pos = to_screen(this.world.get_position(id))
            win.circle_fill(pos.x, pos.y, this.radii[i] * SCALE, this.colours[i])
            i = i + 1
        }
    }
}

// ---------------------------------------------------------------------
// Scene 2: gravity, angled ramps, no floor, balls dropped from the top.

const SCENE2_TOTAL = 2300
const SCENE2_SPAWN_PER_FRAME = 4
// 10-30px diameter -> 5-15px radius -> metres via SCALE.
const SCENE2_BALL_RADIUS_MIN = 2.0 / SCALE
const SCENE2_BALL_RADIUS_MAX = 10.0 / SCALE

// No floor at all -- balls bounce down through the ramps and off the
// bottom of the screen. Below this they're despawned rather than left
// to fall forever.
const KILL_Y = -2.0

class Scene2 {
    init() {
        this.world = box2d.world(vec2(0.0, -10.0))
        this.ids = []
        this.colours = []
        this.radii = []
        this.spawned = 0

        // Thin angled ramps, zigzagging down the screen. Each
        // entry is (body_id, half_length) -- half_length is needed to
        // draw the ramp as a line along its actual long axis.
        this.ramps = []
        this.ramps.append(this.add_ramp(WORLD_W * 0.30, WORLD_H * 0.72, WORLD_W * 0.22, -0.6))
        this.ramps.append(this.add_ramp(WORLD_W * 0.75, WORLD_H * 0.52, WORLD_W * 0.24, 0.62))
        this.ramps.append(this.add_ramp(WORLD_W * 0.28, WORLD_H * 0.30, WORLD_W * 0.24, -0.55))
        this.ramps.append(this.add_ramp(WORLD_W * 0.72, WORLD_H * 0.12, WORLD_W * 0.22, 0.58))
    }

    add_ramp(cx, cy, half_len, angle) {
        id = this.world.add_box(vec2(cx, cy), vec2(half_len, 0.12), angle, STATIC, 1.0, 0.4, 0.2)
        return [id, half_len]
    }

    step() {
        n = 0
        while (this.spawned < SCENE2_TOTAL and n < SCENE2_SPAWN_PER_FRAME) {
            r = random.float(SCENE2_BALL_RADIUS_MIN, SCENE2_BALL_RADIUS_MAX)
            x = random.float(r + 0.2, WORLD_W - r - 0.2)
            y = WORLD_H - random.float(0.0, 1.5)
            id = this.world.add_circle(vec2(x, y), r, DYNAMIC, 1.0, 0.3, 0.3)
            this.ids.append(id)
            this.radii.append(r)
            this.colours.append(colour.hsv_to_rgb(random.float(0.0, 360.0), 0.8, 1.0))
            this.spawned = this.spawned + 1
            n = n + 1
        }
        this.world.step(1.0 / 60.0)

        // Cull balls that have fallen off the bottom of the screen.
        new_ids = []
        new_colours = []
        new_radii = []
        i = 0
        foreach (var id in this.ids) {
            pos = this.world.get_position(id)
            if (pos.y < KILL_Y) {
                this.world.remove(id)
            } else {
                new_ids.append(id)
                new_colours.append(this.colours[i])
                new_radii.append(this.radii[i])
            }
            i = i + 1
        }
        this.ids = new_ids
        this.colours = new_colours
        this.radii = new_radii
    }

    // Finished spawning and every ball has fallen off screen.
    is_done() {
        return this.spawned >= SCENE2_TOTAL and len(this.ids) == 0
    }

    draw(win) {
        // Ramps, drawn as thick red lines along their real long axis
        // (they're thin boxes -- a line is visually indistinguishable
        // and much simpler than a rotated-rectangle draw call).
        foreach (var ramp in this.ramps) {
            id = ramp[0]
            half_len = ramp[1]
            t = this.world.get_rotation(id)
            p = this.world.get_position(id)
            dx = math.cos(t) * half_len
            dy = math.sin(t) * half_len
            a = to_screen(vec2(p.x - dx, p.y - dy))
            b = to_screen(vec2(p.x + dx, p.y + dy))
            win.line_ex(a.x, a.y, b.x, b.y, 6.0, colour.RED)
        }

        i = 0
        foreach (var id in this.ids) {
            pos = to_screen(this.world.get_position(id))
            win.circle_fill(pos.x, pos.y, this.radii[i] * SCALE, this.colours[i])
            i = i + 1
        }
    }
}

// ---------------------------------------------------------------------
// Main loop / scene switching.

win = window(1, 1)
win.init()
win.toggle_fullscreen()
win.set_target_fps(60)

WIDTH = int(win.get_screen_width())
HEIGHT = int(win.get_screen_height())
WORLD_W = WIDTH / SCALE
WORLD_H = HEIGHT / SCALE

scene = 1
s1 = Scene1()
s2 = Scene2()

while (!win.should_close()) {
    if (win.key_pressed(win.KEY_ONE)) {
        scene = 1
    }
    if (win.key_pressed(win.KEY_TWO)) {
        scene = 2
    }
    if (win.key_pressed(win.KEY_R)) {
        if (scene == 1) {
            s1 = Scene1()
        } else {
            s2 = Scene2()
        }
    }

    if (scene == 1) {
        s1.step()
        if (s1.regular_remaining() <= 0) {
            // All non-killer balls are gone -- move on to scene 2.
            scene = 2
            s2 = Scene2()
        }
    } else {
        s2.step()
        if (s2.is_done()) {
            // Everything has fallen off screen -- back to a fresh scene 1.
            scene = 1
            s1 = Scene1()
        }
    }

    win.begin()
    win.clear(colour.BLACK)
    if (scene == 1) {
        s1.draw(win)
    } else {
        s2.draw(win)
    }
    win.text(format("Scene %d  (1/2: switch, R: reset)  FPS: %d", scene, int(win.get_fps())), 10, 10, 18, colour.WHITE)
    win.end()
}
win.close()
