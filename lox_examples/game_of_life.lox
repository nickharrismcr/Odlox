from gfx import *
// Cellular automata in the "Life" family, fullscreen -- Conway's Game of
// Life plus nine other rulesets (Generations, HighLife, Seeds, Brian's
// Brain, Day & Night, Replicator, 2x2, Immigration Game, QuadLife) sharing
// the same grid/neighbour-counting/rendering machinery. Each run cycles to
// the next ruleset in `strategies` (see below) when the grid resets.
//
// The grid is a float_array (per-cell state, not just 0/1 -- see each
// strategy's own rule for what its states mean), sized to the actual
// fullscreen resolution / CELL_SIZE. Neighbour counting wraps toroidally
// (edges connect to the opposite edge) so patterns don't just die off at
// the screen border. Each tick's cells are drawn once into a render_texture
// (bracketed by a single begin_texture_mode/end_texture_mode pair, not one
// per cell -- thousands of individual GPU target switches per frame would
// be the actual bottleneck otherwise), then blitted to the screen with one
// draw_render_texture() call.
//
// ESC to quit. The grid clears, re-randomises, and switches to the next
// strategy every RESET_TICKS generations (most random starts stabilise or
// die out well before that).

import random
import colour

const CELL_SIZE = 10
const RESET_TICKS = 200
const NUM_LINES = 40  // straight lines (horizontal/vertical/diagonal) per reset
const NUM_BOXES = 15  // rectangle outlines per reset
const NUM_BLOCKS = 10 // filled rectangles per reset

const ALIVE_COLOUR = vec4(0, 230, 120, 255)
const BG_COLOUR = colour.BLACK

var win = window(1, 1)
win.init()
win.toggle_fullscreen()
win.set_target_fps(30)

var screen_w = int(win.get_screen_width())
var screen_h = int(win.get_screen_height())
var cols = screen_w / CELL_SIZE
var rows = screen_h / CELL_SIZE

var rt = render_texture(screen_w, screen_h)

// set_wrapped writes `value` into grid at (x, y), wrapping toroidally --
// consistent with every other cell access in this file (see
// horiz_sum_of's own wraparound), so a shape drawn near an edge below can
// straddle it exactly like a live pattern already can once simulation
// starts, rather than getting clipped.
func set_wrapped(grid, x, y, value) {
    var wx = ((x % cols) + cols) % cols
    var wy = ((y % rows) + rows) % rows
    grid.set(wx, wy, value)
}

// draw_random_line plots a straight run of cells from a random start
// point: horizontal, vertical, or diagonal (chosen with equal probability),
// a random length between 1/8 and 1/2 of the grid's width.
func draw_random_line(grid, value) {
    var x0 = random.integer(0, cols - 1)
    var y0 = random.integer(0, rows - 1)
    var length = random.integer(cols / 8, cols / 2)
    var kind = random.integer(0, 2)
    var dx = 0
    var dy = 0
    if (kind == 0) {
        dx = 1
    } else if (kind == 1) {
        dy = 1
    } else {
        dx = 1
        dy = random.integer(0, 1) * 2 - 1 // +1 or -1
    }
    for (var i = 0; i < length; i = i + 1) {
        set_wrapped(grid, x0 + dx * i, y0 + dy * i, value)
    }
}

// draw_random_box plots the border of a random axis-aligned rectangle
// (interior left empty) -- width/height 1/12 to 1/4 of the grid.
func draw_random_box(grid, value) {
    var x0 = random.integer(0, cols - 1)
    var y0 = random.integer(0, rows - 1)
    var w = random.integer(cols / 12, cols / 4)
    var h = random.integer(rows / 12, rows / 4)
    for (var i = 0; i < w; i = i + 1) {
        set_wrapped(grid, x0 + i, y0, value)
        set_wrapped(grid, x0 + i, y0 + h - 1, value)
    }
    for (var j = 0; j < h; j = j + 1) {
        set_wrapped(grid, x0, y0 + j, value)
        set_wrapped(grid, x0 + w - 1, y0 + j, value)
    }
}

// draw_random_block plots a solid random rectangle -- width/height 1/20
// to 1/6 of the grid, smaller than draw_random_box's range so filled
// blocks don't dominate the seed the way a handful of huge ones would.
func draw_random_block(grid, value) {
    var x0 = random.integer(0, cols - 1)
    var y0 = random.integer(0, rows - 1)
    var w = random.integer(cols / 20, cols / 6)
    var h = random.integer(rows / 20, rows / 6)
    for (var j = 0; j < h; j = j + 1) {
        for (var i = 0; i < w; i = i + 1) {
            set_wrapped(grid, x0 + i, y0 + j, value)
        }
    }
}

// seed_shapes clears the grid, then plants NUM_LINES lines, NUM_BOXES box
// outlines, and NUM_BLOCKS filled blocks at random positions/sizes/
// orientations -- value_fn is called once per shape (not once per cell),
// so a whole line/box/block is a single colour, not per-cell noise;
// single-colour strategies always return 1.0, but a strategy with
// multiple competing colours (Immigration Game, QuadLife) can return a
// different one per shape, seeding recognisable territories instead of
// scattered dots.
func seed_shapes(grid, value_fn) {
    grid.clear(0.0)
    for (var i = 0; i < NUM_LINES; i = i + 1) {
        draw_random_line(grid, value_fn())
    }
    for (var i = 0; i < NUM_BOXES; i = i + 1) {
        draw_random_box(grid, value_fn())
    }
    for (var i = 0; i < NUM_BLOCKS; i = i + 1) {
        draw_random_block(grid, value_fn())
    }
}

// randomise seeds the grid via seed_shapes with every shape at state 1
// ("fully alive") -- shared by every single-colour strategy below, since
// a strategy's richer states (e.g. Generations' dying states) only ever
// emerge from simulation, never from the initial seed.
func randomise(grid) {
    seed_shapes(grid, func () { return 1.0 })
}

// horiz_sum_of returns a `cols`-length list where entry x is the sum of
// row y's three cells around column x (x-1, x, x+1, wrapping at the
// edges) in `source` -- the horizontal half of each cell's 3x3
// neighbourhood. Computed with a sliding window (prev/curr/next locals),
// so after the first cell each later x only costs one new float_array
// read, not three.
func horiz_sum_of(source, y) {
    var row = []
    var prev = source.get(cols - 1, y)
    var curr = source.get(0, y)
    for (var x = 0; x < cols; x = x + 1) {
        var next = source.get((x + 1) % cols, y)
        row.append(prev + curr + next)
        prev = curr
        curr = next
    }
    return row
}

// step_generic computes each cell's neighbour count from `source` (a 0/1
// "is this neighbour alive" indicator -- for Conway that's `grid` itself,
// since its only states already are 0/1; for a richer ruleset like
// Generations it's a derived array, decoupled from grid's own wider state
// range) and calls rule(state, neighbours) -> next_state per cell,
// writing the result into `next`. state comes from `grid` (which may
// differ from `source`), so a rule can see a cell's full state (e.g.
// which dying stage it's in) even though only a 0/1 indicator feeds the
// neighbour count.
//
// Uses the same rolling window of three horiz_sum_of() rows (above,
// current, below the row being processed) regardless of ruleset --
// their sum at column x is `source`'s full 3x3 neighbourhood total
// *including itself* (h_curr[x] already counts source[x,y]), so
// subtracting the cell's own `source` value once gives the neighbour-only
// count. After each row, the window just slides down (h_prev <- h_curr
// <- h_next) instead of recomputing from scratch -- roughly 5x fewer
// float_array native calls than reading all 8 neighbours fresh per cell
// (measured on Conway's rule: 0.33s -> 0.06s per tick on a 192x108 grid),
// since each native float_array method call costs far more than the
// plain list-index reads (h_prev[x]/h_curr[x]/h_next[x]) it replaces.
// Verified to produce identical output to the naive 8-neighbour version
// against a known blinker oscillator and 20 generations of a random
// 30x30 grid before landing.
func step_generic(source, grid, next, rule) {
    var h_prev = horiz_sum_of(source, rows - 1)
    var h_curr = horiz_sum_of(source, 0)
    for (var y = 0; y < rows; y = y + 1) {
        var h_next = horiz_sum_of(source, (y + 1) % rows)
        for (var x = 0; x < cols; x = x + 1) {
            var total = h_prev[x] + h_curr[x] + h_next[x]
            var self_indicator = source.get(x, y)
            var n = total - self_indicator
            var state = grid.get(x, y)
            next.set(x, y, rule(state, n))
        }
        h_prev = h_curr
        h_curr = h_next
    }
}

// state_indicator builds a 0/1 indicator array from grid's wider state
// range, 1.0 only where state is exactly target_state -- shared by every
// strategy whose intermediate/dying states (however many it has) must
// not count as live neighbours, only one particular state does (see
// Generations and Brian's Brain below for why), and by Immigration
// Game's two competing colours (each needs its own indicator, counted
// separately).
func state_indicator(grid, target_state) {
    var ind = float_array(cols, rows)
    for (var y = 0; y < rows; y = y + 1) {
        for (var x = 0; x < cols; x = x + 1) {
            if (grid.get(x, y) == target_state) {
                ind.set(x, y, 1.0)
            } else {
                ind.set(x, y, 0.0)
            }
        }
    }
    return ind
}

// neighbour_count_array materialises step_generic's own per-cell
// neighbour-count computation (same rolling horiz_sum_of window, same
// "subtract self once" math) into a whole float_array, instead of
// immediately consuming each count via a rule callback. step_generic
// itself doesn't need this (fusing count + rule application into one
// pass avoids the extra float_array of storage and its own get/set
// overhead), but a strategy like Immigration Game needs *two* full
// neighbour-count arrays at once (one per competing colour, see below)
// before it can decide anything per cell, so there's no single rule
// callback to fuse into.
func neighbour_count_array(source) {
    var counts = float_array(cols, rows)
    var h_prev = horiz_sum_of(source, rows - 1)
    var h_curr = horiz_sum_of(source, 0)
    for (var y = 0; y < rows; y = y + 1) {
        var h_next = horiz_sum_of(source, (y + 1) % rows)
        for (var x = 0; x < cols; x = x + 1) {
            var total = h_prev[x] + h_curr[x] + h_next[x]
            var self_indicator = source.get(x, y)
            counts.set(x, y, total - self_indicator)
        }
        h_prev = h_curr
        h_curr = h_next
    }
    return counts
}

// -----------------------------------------------------------------------
// Strategy: Conway's Game of Life (2 states: dead 0, alive 1). Birth on
// exactly 3 live neighbours, survival on 2 or 3, death otherwise.

func conway_rule(state, n) {
    var alive = state > 0.5
    if (alive and (n == 2 or n == 3)) {
        return 1.0
    }
    if (!alive and n == 3) {
        return 1.0
    }
    return 0.0
}

func step_conway(grid, next) {
    // grid doubles as its own neighbour-indicator: Conway's only states
    // are already 0/1, so no separate indicator array is needed.
    step_generic(grid, grid, next, conway_rule)
}

func conway_colour(state) {
    if (state > 0.5) {
        return ALIVE_COLOUR
    }
    return nil
}

// -----------------------------------------------------------------------
// Strategy: Generations, the B2/S345/C5 "Star Wars" rule -- 5 states:
// dead (0), alive (1), and 3 dying/fading states (2-4) a cell passes
// through before returning to dead. Unlike Conway, a *dying* cell does
// not count as a live neighbour for its neighbours' own birth/survival --
// only state 1 does -- so births/survival can only be sustained by
// cells that are still fully alive, not by trails of fading ones.

const GEN_NUM_STATES = 5

const GEN_COLOURS = [
    vec4(255, 255, 60, 255), // state 1: alive
    vec4(255, 140, 0, 255),  // state 2: dying
    vec4(200, 30, 0, 255),   // state 3: dying
    vec4(70, 0, 40, 255)   // state 4: nearly gone
]

func gen_rule(state, n) {
    if (state == 0.0) {
        if (n == 2) {
            return 1.0
        }
        return 0.0
    }
    if (state == 1.0) {
        if (n == 3 or n == 4 or n == 5) {
            return 1.0
        }
        return 2.0 // starts dying
    }
    // Already dying (state 2..GEN_NUM_STATES-1): always advances one
    // stage, regardless of neighbours, wrapping back to dead once it
    // reaches the last dying state.
    var nxt = state + 1.0
    if (nxt >= GEN_NUM_STATES) {
        return 0.0
    }
    return nxt
}

func step_generations(grid, next) {
    step_generic(state_indicator(grid, 1.0), grid, next, gen_rule)
}

func generations_colour(state) {
    if (state < 0.5) {
        return nil
    }
    return GEN_COLOURS[int(state) - 1]
}

// -----------------------------------------------------------------------
// Strategy: HighLife (B36/S23) -- Conway's own rule plus an extra birth
// condition on exactly 6 neighbours. Still just 2 states (dead/alive), so
// it reuses Conway's shape exactly, only the birth predicate differs.
// Famous for having a small self-replicating pattern, unlike plain Conway.

const HIGHLIFE_COLOUR = vec4(60, 200, 255, 255)

func highlife_rule(state, n) {
    var alive = state > 0.5
    if (alive and (n == 2 or n == 3)) {
        return 1.0
    }
    if (!alive and (n == 3 or n == 6)) {
        return 1.0
    }
    return 0.0
}

func step_highlife(grid, next) {
    step_generic(grid, grid, next, highlife_rule)
}

func highlife_colour(state) {
    if (state > 0.5) {
        return HIGHLIFE_COLOUR
    }
    return nil
}

// -----------------------------------------------------------------------
// Strategy: Seeds (B2/S) -- births on exactly 2 neighbours, but *no*
// survival condition at all: every live cell dies unconditionally every
// generation, regardless of neighbour count. Never stabilises -- unlike
// Conway/HighLife, patterns explode outward rather than settling into
// still lifes or oscillators, a deliberately different long-run behaviour
// from the other 2-state strategies above.

const SEEDS_COLOUR = vec4(255, 60, 200, 255)

func seeds_rule(state, n) {
    if (state < 0.5 and n == 2) {
        return 1.0
    }
    return 0.0
}

func step_seeds(grid, next) {
    step_generic(grid, grid, next, seeds_rule)
}

func seeds_colour(state) {
    if (state > 0.5) {
        return SEEDS_COLOUR
    }
    return nil
}

// -----------------------------------------------------------------------
// Strategy: Brian's Brain -- 3 states: off (0), firing (1), dying/
// refractory (2). An off cell fires with exactly 2 firing neighbours; a
// firing cell always becomes dying next tick, unconditionally; a dying
// cell always goes off next tick, unconditionally -- neither transition
// depends on neighbours at all, unlike Generations' dying stages (also
// unconditional) or any 2-state rule's survival check. Only firing cells
// (state 1) count as neighbours, same reasoning as Generations. Never
// settles into still lifes -- brains "spark" and travel rather than sit.

const BRAIN_COLOURS = [
    vec4(255, 255, 255, 255), // state 1: firing
    vec4(40, 80, 255, 255)   // state 2: dying/refractory
]

func brain_rule(state, n) {
    if (state == 0.0) {
        if (n == 2) {
            return 1.0
        }
        return 0.0
    }
    if (state == 1.0) {
        return 2.0
    }
    return 0.0
}

func step_brain(grid, next) {
    step_generic(state_indicator(grid, 1.0), grid, next, brain_rule)
}

func brain_colour(state) {
    if (state < 0.5) {
        return nil
    }
    return BRAIN_COLOURS[int(state) - 1]
}

// -----------------------------------------------------------------------
// Strategy: Day & Night (B3678/S34678) -- 2 states, same shape as
// Conway/HighLife/Seeds. Symmetric under swapping dead and alive (the
// birth and survival neighbour sets are each other's complement against
// 0-8), so large dead regions and large alive regions behave like mirror
// images of each other -- solid fields with moving boundaries, rather
// than Conway's sparse blobs and gliders.

const DAY_NIGHT_COLOUR = vec4(230, 230, 230, 255)

func day_night_rule(state, n) {
    var alive = state > 0.5
    if (alive and (n == 3 or n == 4 or n == 6 or n == 7 or n == 8)) {
        return 1.0
    }
    if (!alive and (n == 3 or n == 6 or n == 7 or n == 8)) {
        return 1.0
    }
    return 0.0
}

func step_day_night(grid, next) {
    step_generic(grid, grid, next, day_night_rule)
}

func day_night_colour(state) {
    if (state > 0.5) {
        return DAY_NIGHT_COLOUR
    }
    return nil
}

// -----------------------------------------------------------------------
// Strategy: Replicator (B1357/S1357) -- 2 states, but birth and survival
// share the exact same condition (any odd neighbour count), so a cell's
// *current* state never actually matters to its next one: alive iff n is
// odd, full stop. Every pattern spontaneously copies itself repeatedly --
// genuinely chaotic, not just noisy like Seeds or blob-forming like the
// others above.

const REPLICATOR_COLOUR = vec4(50, 255, 180, 255)

func replicator_rule(state, n) {
    _ = state
    if (n == 1 or n == 3 or n == 5 or n == 7) {
        return 1.0
    }
    return 0.0
}

func step_replicator(grid, next) {
    step_generic(grid, grid, next, replicator_rule)
}

func replicator_colour(state) {
    if (state > 0.5) {
        return REPLICATOR_COLOUR
    }
    return nil
}

// -----------------------------------------------------------------------
// Strategy: 2x2 (B36/S125) -- 2 states. Named for its tendency to
// preserve and propagate 2x2 block structures from the initial noise,
// giving it a blockier, more mechanical look than the organic blobs or
// scattered dots every other strategy above produces.

const TWOBYTWO_COLOUR = vec4(180, 180, 255, 255)

func twobytwo_rule(state, n) {
    var alive = state > 0.5
    if (alive and (n == 1 or n == 2 or n == 5)) {
        return 1.0
    }
    if (!alive and (n == 3 or n == 6)) {
        return 1.0
    }
    return 0.0
}

func step_twobytwo(grid, next) {
    step_generic(grid, grid, next, twobytwo_rule)
}

func twobytwo_colour(state) {
    if (state > 0.5) {
        return TWOBYTWO_COLOUR
    }
    return nil
}

// -----------------------------------------------------------------------
// Strategy: Immigration Game -- Conway's own birth (exactly 3 neighbours)
// and survival (2 or 3) counts, but 3 states instead of 2: two competing
// "colours" of alive cell (1, 2) plus dead (0). Survivors keep their own
// colour; a newly-born cell's colour is decided by majority vote among
// its exactly-3 live parent neighbours (never a tie -- 3 neighbours split
// between 2 colours is always 3-0, 2-1, 1-2, or 0-3, one side always
// wins). Unlike every strategy above, this can't be expressed as
// step_generic(source, grid, next, rule): that abstraction only ever
// hands a rule a single neighbour *count*, but deciding a birth's colour
// needs to know the breakdown *by colour*, not just the total -- so this
// strategy computes two full neighbour_count_array()s (one per colour)
// and combines them itself instead. Also the first strategy with its own
// randomiser (randomise_immigration): the shared randomise() only ever
// seeds a single "on" state, but a fair fight needs both colours seeded
// from the start, not one colour only ever arising from later births.

const IMMIGRATION_COLOUR_A = vec4(255, 60, 60, 255)
const IMMIGRATION_COLOUR_B = vec4(60, 140, 255, 255)

func randomise_immigration(grid) {
    seed_shapes(grid, func () {
        if (random.integer(0, 1) == 0) {
            return 1.0
        }
        return 2.0
    })
}

func step_immigration(grid, next) {
    var count_a = neighbour_count_array(state_indicator(grid, 1.0))
    var count_b = neighbour_count_array(state_indicator(grid, 2.0))
    for (var y = 0; y < rows; y = y + 1) {
        for (var x = 0; x < cols; x = x + 1) {
            var ca = count_a.get(x, y)
            var cb = count_b.get(x, y)
            var n = ca + cb
            var state = grid.get(x, y)
            if (state > 0.5) {
                if (n == 2 or n == 3) {
                    next.set(x, y, state) // survives, keeps its own colour
                } else {
                    next.set(x, y, 0.0)
                }
            } else {
                if (n == 3) {
                    if (ca > cb) {
                        next.set(x, y, 1.0)
                    } else {
                        next.set(x, y, 2.0)
                    }
                } else {
                    next.set(x, y, 0.0)
                }
            }
        }
    }
}

func immigration_colour(state) {
    if (state == 1.0) {
        return IMMIGRATION_COLOUR_A
    }
    if (state == 2.0) {
        return IMMIGRATION_COLOUR_B
    }
    return nil
}

// -----------------------------------------------------------------------
// Strategy: QuadLife -- Immigration Game's own idea (Conway's birth/
// survival counts, competing colours, survivors keep their colour)
// extended to 4 colours (states 1-4) instead of 2. With only 2 colours a
// birth's 3 parents always have a clean majority (3 items split 2 ways
// can't tie); with 4 colours they might not -- 3 parents could be 3
// different colours with no majority at all. The standard QuadLife rule
// handles that case cleanly: if there *is* a majority (2 or more parents
// sharing a colour), the birth takes it, same as Immigration Game; if
// all 3 parents are different colours, the birth takes the one colour
// *not* among those 3 (always exactly one, since 4 colours - 3 present
// = 1 missing) -- see quadlife_birth_colour. Needs 4 full
// neighbour_count_array()s per tick instead of Immigration Game's 2, so
// noticeably more work per generation than any other strategy here.

const QUADLIFE_COLOUR_1 = vec4(255, 70, 70, 255)
const QUADLIFE_COLOUR_2 = vec4(70, 220, 90, 255)
const QUADLIFE_COLOUR_3 = vec4(80, 140, 255, 255)
const QUADLIFE_COLOUR_4 = vec4(255, 220, 60, 255)

func randomise_quadlife(grid) {
    seed_shapes(grid, func () {
        var c = random.integer(1, 4)
        if (c == 1) {
            return 1.0
        }
        if (c == 2) {
            return 2.0
        }
        if (c == 3) {
            return 3.0
        }
        return 4.0
    })
}

// quadlife_birth_colour picks a birth's colour from its exactly-3 live
// parents' per-colour counts (which always sum to 3). If one colour has
// 2 or 3 of them, that's a clear majority. Otherwise all three parents
// are different colours (three counts of 1, one of 0) -- the birth takes
// the missing (count 0) colour.
func quadlife_birth_colour(c1, c2, c3, c4) {
    if (c1 >= 2) {
        return 1.0
    }
    if (c2 >= 2) {
        return 2.0
    }
    if (c3 >= 2) {
        return 3.0
    }
    if (c4 >= 2) {
        return 4.0
    }
    if (c1 == 0) {
        return 1.0
    }
    if (c2 == 0) {
        return 2.0
    }
    if (c3 == 0) {
        return 3.0
    }
    return 4.0
}

func step_quadlife(grid, next) {
    var count1 = neighbour_count_array(state_indicator(grid, 1.0))
    var count2 = neighbour_count_array(state_indicator(grid, 2.0))
    var count3 = neighbour_count_array(state_indicator(grid, 3.0))
    var count4 = neighbour_count_array(state_indicator(grid, 4.0))
    for (var y = 0; y < rows; y = y + 1) {
        for (var x = 0; x < cols; x = x + 1) {
            var c1 = count1.get(x, y)
            var c2 = count2.get(x, y)
            var c3 = count3.get(x, y)
            var c4 = count4.get(x, y)
            var n = c1 + c2 + c3 + c4
            var state = grid.get(x, y)
            if (state > 0.5) {
                if (n == 2 or n == 3) {
                    next.set(x, y, state)
                } else {
                    next.set(x, y, 0.0)
                }
            } else {
                if (n == 3) {
                    next.set(x, y, quadlife_birth_colour(c1, c2, c3, c4))
                } else {
                    next.set(x, y, 0.0)
                }
            }
        }
    }
}

func quadlife_colour(state) {
    if (state == 1.0) {
        return QUADLIFE_COLOUR_1
    }
    if (state == 2.0) {
        return QUADLIFE_COLOUR_2
    }
    if (state == 3.0) {
        return QUADLIFE_COLOUR_3
    }
    if (state == 4.0) {
        return QUADLIFE_COLOUR_4
    }
    return nil
}

// -----------------------------------------------------------------------
// Strategy registry -- runs cycle through these, one per RESET_TICKS
// generations. A "strategy" bundles a step rule, a state->colour lookup,
// and a randomiser; all but Immigration Game share the same grid storage,
// sliding-window neighbour counting (step_generic/horiz_sum_of), and
// randomise() -- only the state-transition rule and the colour mapping
// differ. `step`/`colour`/`randomise` are plain fields holding functions,
// not class methods, so calling them (`strategy.step(grid, next)`) just
// invokes the stored function directly -- no implicit `this` involved.
class Strategy {
    init(name, step_fn, colour_fn, randomise_fn) {
        this.name = name
        this.step = step_fn
        this.colour = colour_fn
        this.randomise = randomise_fn
    }
}

var strategies = [
    Strategy("Conway's Game of Life", step_conway, conway_colour, randomise),
    Strategy("Generations (B2/S345/C5)", step_generations, generations_colour, randomise),
    Strategy("HighLife (B36/S23)", step_highlife, highlife_colour, randomise),
    Strategy("Seeds (B2/S)", step_seeds, seeds_colour, randomise),
    Strategy("Brian's Brain", step_brain, brain_colour, randomise),
    Strategy("Day & Night (B3678/S34678)", step_day_night, day_night_colour, randomise),
    Strategy("Replicator (B1357/S1357)", step_replicator, replicator_colour, randomise),
    Strategy("2x2 (B36/S125)", step_twobytwo, twobytwo_colour, randomise),
    Strategy("Immigration Game", step_immigration, immigration_colour, randomise_immigration),
    Strategy("QuadLife", step_quadlife, quadlife_colour, randomise_quadlife)
]
var strategy_index = 0

func draw_grid(grid, colour_fn) {
    win.begin_texture_mode(rt)
    win.clear(BG_COLOUR)
    for (var y = 0; y < rows; y = y + 1) {
        for (var x = 0; x < cols; x = x + 1) {
            var col = colour_fn(grid.get(x, y))
            if (col != nil) {
                win.rectangle(x * CELL_SIZE, y * CELL_SIZE, CELL_SIZE - 1, CELL_SIZE - 1, col)
            }
        }
    }
    win.end_texture_mode()
}

var grid = float_array(cols, rows)
var next_grid = float_array(cols, rows)
var strategy = strategies[strategy_index]
strategy.randomise(grid)
draw_grid(grid, strategy.colour)

var generation = 0

while (!win.should_close()) {
    if (win.key_pressed(win.KEY_ESCAPE)) {
        break
    }

    strategy.step(grid, next_grid)
    var tmp = grid
    grid = next_grid
    next_grid = tmp

    generation = generation + 1
    if (generation >= RESET_TICKS) {
        strategy_index = (strategy_index + 1) % len(strategies)
        strategy = strategies[strategy_index]
        strategy.randomise(grid)
        generation = 0
    }

    draw_grid(grid, strategy.colour)

    win.begin()
    win.clear(BG_COLOUR)
    win.draw_render_texture(rt, 0, 0, colour.WHITE)
    win.text(format("%s -- Generation %d / %d", strategy.name, generation, RESET_TICKS), 10, 10, 20, colour.WHITE)
    win.text(format("%d x %d cells, %dpx", cols, rows, CELL_SIZE), 10, 34, 16, vec4(180, 180, 180, 255))
    win.end()
}
win.close()
