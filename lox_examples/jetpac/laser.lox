from gfx import *
import spectrum_attr

// @file laser.lox
// @brief LaserPool: 4 preallocated beam slots (laser_beam_params, 4
// records of 8 bytes: [used, Y, pulse1_X, pulse2_X, pulse3_X, pulse4_X,
// length, colour]). Rebuilt a third time against a real gameplay
// screenshot the user supplied: the beam is a single **growing dashed
// line** from Jetman's gun to its current tip, not a handful of
// isolated dash clusters -- the previous rewrite matched the
// disassembly's confirmed byte-level facts (front pulse steps a fixed
// 8px/tick and stamps a solid screen byte, $6fed) but rendering that
// literally (each step's mark never explicitly erased) would produce
// either a solid contiguous bar (adjacent 8px marks touching) or, with
// this port's earlier "4 discrete pulses" model, 4 isolated dashes --
// neither matches the screenshot's regular dash-gap-dash pattern
// spanning the whole beam. The trailing-pulse code ($7016-$706c) that
// erases *behind* the front as the beam collapses is exactly the kind
// of mechanism that could produce a dashed look throughout, but its
// precise bit-level pattern is one of the sections the disassembly's
// own comment already flags as uncertain ("copious amounts of register
// swapping... these annotations need checking") -- so rather than
// guess further at bytes, this rebuild renders the dash pattern
// directly (position-based, not time-based, so it stays visually
// stable as the beam grows) and keeps every mechanically-CONFIRMED
// fact from the previous pass:
//
// - The front (tip) moves a fixed 8px/tick and freezes -- stops
//   advancing permanently -- on EITHER hitting any non-empty screen
//   content OR an independent random max-range countdown running out
//   ($6f97-$6f9e: `(random&$38)|$84`, decoded to FRONT_RANGE_MIN/MAX).
// - The beam doesn't vanish the instant the front freezes -- the ROM's
//   own trailing pulses keep chasing and erasing behind it afterward,
//   so this port models that as a single collapse cursor that starts
//   advancing from the origin (Jetman's gun at fire time) toward the
//   front only once the front has frozen, consuming the dashed trail
//   as it goes; the beam deactivates once the cursor reaches the
//   front, matching the ROM's own "dies once every trailing pulse has
//   caught up" behaviour ($7027) without needing 3 separately-timed
//   pulses to reproduce the visible result.
// - Colour is a fresh **random** pick from laser_beam_colours ($6FB2:
//   $47/$43/$43/$45 -- white, magenta, magenta, cyan, all bright) every
//   time a beam fires ($6FA4: `random & 3`).
// - check_hit() tests the front (tip) position -- the previous pass's
//   "tests pulse #2, not the front" finding is almost certainly still
//   correct byte-for-byte, but pulse #2 has no clean equivalent in this
//   collapse-cursor model, and testing the tip is the more
//   gameplay-legible simplification (a shot registers as it reaches an
//   alien, not some ROM-internal trailing marker).

const MAX_BEAMS = 4
const FRONT_STEP = 8.0             // $6fd8/$6fd9: fixed 8px/tick
const FRONT_RANGE_MIN = 132.0      // $6f9e: (random&$38)|$84, decoded to a plain distance cap
const FRONT_RANGE_MAX = 188.0
const COLLAPSE_STEP = 8.0          // $7059: same fixed ±8 move confirmed for a trailing pulse

const DASH_LEN = 4.0   // drawn dash length, in px, of the dashed trail
const DASH_GAP = 4.0   // gap between dashes -- DASH_LEN+DASH_GAP is the repeat period
const PULSE_THICKNESS = 2
const BEAM_Y_OFFSET = 13.0  // LaserBeamDraw: aligned to the middle of Jetman's sprite

const SCREEN_W = 256
const SCREEN_H = 192

// Alien-hit test window, approximating $6e33-$6e53's own asymmetric
// arithmetic (wider ahead of the alien than behind) rather than
// reproducing it exactly.
const HIT_DX_AHEAD = 32.0
const HIT_DX_BEHIND = 8.0
const HIT_DY = 12.0

// laser_beam_colours' own 4 raw attribute bytes, decoded once.
const COLOUR_ATTRS = [71, 67, 67, 69]

func beam_colours() {
    var out = []
    foreach (var attr in COLOUR_ATTRS) {
        var d = spectrum_attr.decode_attribute(attr)
        out.append(spectrum_attr.colour_to_rgba(d["ink"], d["bright"]))
    }
    return out
}

var BEAM_COLOURS = beam_colours()

func rand_range(lo, hi) {
    return lo + rand() * (hi - lo)
}

// Display.plot()/set_attr() don't bounds-check (unlike blit_sprite,
// which clips its own loop), so every plot here needs its own guard.
func plot_clamped(disp, x, y, v) {
    if (x >= 0 and x < SCREEN_W and y >= 0 and y < SCREEN_H) {
        disp.plot(x, y, v)
    }
}

func set_attr_clamped(disp, x, y, ink, paper) {
    var cx = int(x / 8)
    var cy = int(y / 8)
    if (cx >= 0 and cx < SCREEN_W / 8 and cy >= 0 and cy < SCREEN_H / 8) {
        disp.set_attr(cx, cy, ink, paper)
    }
}

func new_beam() {
    return {
        "active": false,
        "y": 0.0,
        "dir": 1,
        "origin_x": 0.0,     // Jetman's gun position at fire time -- the trail's own back end until it starts collapsing
        "front_x": 0.0,      // current tip
        "front_frozen": false,
        "traveled": 0.0,
        "max_range": 0.0,
        "collapsing": false, // true once the front has frozen -- origin_x then advances toward front_x
        "colour": encode_rgba(255, 255, 255),
        "last_lo": nil,      // erase bookkeeping: the drawn span's own last [lo, hi) bounds
        "last_hi": nil,
        "last_y": nil
    }
}

class LaserPool {
    __init__() {
        this.beams = []
        for (var i = 0; i < MAX_BEAMS; i = i + 1) {
            this.beams.append(new_beam())
        }
    }

    // Fires from Jetman's gun (LaserNewIfFreeSlot: only if a slot is
    // free -- no queueing).
    fire(jetman) {
        for (var i = 0; i < MAX_BEAMS; i = i + 1) {
            var b = this.beams[i]
            if (!b["active"]) {
                b["active"] = true
                b["y"] = jetman.y - BEAM_Y_OFFSET
                b["dir"] = 1
                if (jetman.facing_left) {
                    b["dir"] = -1
                }
                b["origin_x"] = jetman.x
                b["front_x"] = jetman.x
                b["front_frozen"] = false
                b["traveled"] = 0.0
                b["max_range"] = rand_range(FRONT_RANGE_MIN, FRONT_RANGE_MAX)
                b["collapsing"] = false
                b["colour"] = BEAM_COLOURS[int(rand() * len(BEAM_COLOURS))]
                b["last_lo"] = nil
                b["last_hi"] = nil
                return
            }
        }
    }

    clear(disp) {
        foreach (var b in this.beams) {
            if (b["last_lo"] == nil) {
                continue
            }
            for (var x = b["last_lo"]; x < b["last_hi"]; x = x + 1) {
                for (var t = 0; t < PULSE_THICKNESS; t = t + 1) {
                    plot_clamped(disp, x, b["last_y"] + t, 0.0)
                }
            }
        }
    }

    // Advances the front (fixed step, freezing on collision or max
    // range), then -- once frozen -- advances the collapse cursor
    // (origin_x) toward it at the same fixed step, consuming the trail
    // from the back. Deactivates once the trail is fully consumed.
    update(platforms) {
        foreach (var b in this.beams) {
            if (!b["active"]) {
                continue
            }

            if (!b["front_frozen"]) {
                var next_x = b["front_x"] + FRONT_STEP * float(b["dir"])
                if (next_x < 0.0 or next_x > float(SCREEN_W)) {
                    b["front_frozen"] = true
                } else if (platforms.blocks_point(int(next_x), int(b["y"]))) {
                    b["front_frozen"] = true
                } else {
                    b["front_x"] = next_x
                    b["traveled"] = b["traveled"] + FRONT_STEP
                    if (b["traveled"] >= b["max_range"]) {
                        b["front_frozen"] = true
                    }
                }
            } else {
                b["collapsing"] = true
            }

            if (b["collapsing"]) {
                var dx = b["front_x"] - b["origin_x"]
                if (dx < 0.0) { dx = -dx }
                if (dx <= COLLAPSE_STEP) {
                    b["active"] = false
                } else {
                    var step = COLLAPSE_STEP
                    if (b["front_x"] < b["origin_x"]) {
                        step = -COLLAPSE_STEP
                    }
                    b["origin_x"] = b["origin_x"] + step
                }
            }
        }
    }

    draw(disp) {
        foreach (var b in this.beams) {
            if (!b["active"]) {
                continue
            }
            var y0 = int(b["y"])
            var lo = b["origin_x"]
            var hi = b["front_x"]
            if (lo > hi) {
                var tmp = lo
                lo = hi
                hi = tmp
            }
            var period = DASH_LEN + DASH_GAP

            // Dash phase anchored to origin_x (not front_x) so the
            // pattern stays stable near Jetman's gun as the beam grows,
            // rather than sliding every tick the tip advances.
            var x = lo
            var min_drawn = nil
            var max_drawn = nil
            while (x < hi) {
                var dash_end = x + DASH_LEN
                if (dash_end > hi) { dash_end = hi }
                var xi0 = int(x)
                var xi1 = int(dash_end)
                for (var px = xi0; px < xi1; px = px + 1) {
                    for (var t = 0; t < PULSE_THICKNESS; t = t + 1) {
                        plot_clamped(disp, px, y0 + t, 1.0)
                    }
                }
                if (xi1 > xi0) {
                    if (min_drawn == nil or xi0 < min_drawn) { min_drawn = xi0 }
                    if (max_drawn == nil or xi1 > max_drawn) { max_drawn = xi1 }
                }
                x = x + period
            }
            if (min_drawn != nil) {
                var black = encode_rgba(0, 0, 0)
                var cx0 = int(min_drawn / 8)
                var cx1 = int((max_drawn - 1) / 8)
                var cy = int(y0 / 8)
                for (var cxi = cx0; cxi <= cx1; cxi = cxi + 1) {
                    if (cxi >= 0 and cxi < SCREEN_W / 8 and cy >= 0 and cy < SCREEN_H / 8) {
                        disp.set_attr(cxi, cy, b["colour"], black)
                    }
                }
            }

            if (min_drawn == nil) {
                b["last_lo"] = nil
                b["last_hi"] = nil
            } else {
                b["last_lo"] = min_drawn
                b["last_hi"] = max_drawn
            }
            b["last_y"] = y0
        }
    }

    // Consumes and returns true for the first active beam whose front
    // (tip) is within the asymmetric hit window of (x, y).
    check_hit(x, y) -> bool {
        foreach (var b in this.beams) {
            if (!b["active"]) {
                continue
            }
            var dx = b["front_x"] - x
            var dy = b["y"] - y
            if (dy < 0.0) { dy = -dy }
            var x_ok = false
            if (dx >= 0.0 and dx < HIT_DX_AHEAD) {
                x_ok = true
            } else if (dx < 0.0 and -dx < HIT_DX_BEHIND) {
                x_ok = true
            }
            if (x_ok and dy < HIT_DY) {
                b["active"] = false
                return true
            }
        }
        return false
    }
}
