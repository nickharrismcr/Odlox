// SoundManager: exclusivity groups, play-if-not-playing, a mute switch,
// and per-frame music polling on top of the native `sound` module.

import sound

class SoundManager {
	// Kill switch, set before constructing a SoundManager (e.g.
	// SoundManager.no_sound = cfg.mute_sound) to run with audio fully
	// disabled. load()/load_music() skip populating their dicts when set,
	// so every other method checks no_sound first too.
	static no_sound = false

	init() {
		this.sounds = {}   // name -> Sound object
		this.groups = {}   // name -> group id (absent = no exclusivity)
		this.music = {}    // key -> Music object
		this.muted = false
		if (!SoundManager.no_sound) {
			sound.init()
		}
	}

	// load registers a Sound under name, loaded from path. group, if
	// given and nonzero, makes this sound mutually exclusive with every
	// other sound sharing that group: playing one stops every other
	// currently-playing sound in the same group first.
	load(name, path, group=0) {
		if (SoundManager.no_sound) { return }
		this.sounds[name] = sound.load(path)
		if group != 0 {
			this.groups[name] = group
		}
	}

	load_music(key, path) {
		if (SoundManager.no_sound) { return }
		this.music[key] = sound.load_music(path)
	}

	play(name) {
		if (SoundManager.no_sound or this.muted) { return }
		group = this.groups.get(name, 0)
		if group != 0 {
			foreach (other in this.groups.keys()) {
				if other != name and this.groups[other] == group {
					this.sounds[other].stop()
				}
			}
		}
		this.sounds[name].stop()
		this.sounds[name].play()
	}

	// play_if_not re-triggers name only if it isn't already playing --
	// keeps a one-shot clip effectively looping for as long as it's
	// called every frame some condition holds.
	play_if_not(name) {
		if (SoundManager.no_sound) { return }
		if !this.muted and !this.sounds[name].is_playing() {
			this.sounds[name].play()
		}
	}

	stop(name) {
		if (SoundManager.no_sound) { return }
		this.sounds[name].stop()
	}

	play_music(key) {
		if (SoundManager.no_sound) { return }
		if !this.muted {
			this.music[key].play()
		}
	}

	// Routed through the manager rather than the raw Music object so
	// callers don't need their own no_sound check.
	set_music_looping(key, looping) {
		if (SoundManager.no_sound) { return }
		this.music[key].set_looping(looping)
	}

	set_music_volume(key, volume) {
		if (SoundManager.no_sound) { return }
		this.music[key].set_volume(volume)
	}

	// play_music_if_not is play_if_not's counterpart for a registered
	// Music stream -- starts key only if it isn't already playing, so a
	// per-frame "should this loop be running right now" check (e.g. a
	// thruster tied to a held input) doesn't restart it from the top
	// every single frame the condition holds.
	play_music_if_not(key) {
		if (SoundManager.no_sound) { return }
		if !this.muted and !this.music[key].is_playing() {
			this.music[key].play()
		}
	}

	stop_music(key) {
		if (SoundManager.no_sound) { return }
		this.music[key].stop()
	}

	// update polls every registered Music stream -- call once per frame
	// from the game's own loop, or streamed playback stalls.
	update() {
		if (SoundManager.no_sound) { return }
		foreach (key in this.music.keys()) {
			this.music[key].update()
		}
	}

	// set_muted(true) stops everything currently playing and silences
	// future play()/play_music() calls; set_muted(false) just lifts the
	// silence -- nothing resumes automatically.
	set_muted(m) {
		if (SoundManager.no_sound) { return }
		this.muted = m
		if m {
			foreach (name in this.sounds.keys()) {
				this.sounds[name].stop()
			}
			foreach (key in this.music.keys()) {
				this.music[key].stop()
			}
		}
	}

	is_muted() {
		return this.muted
	}
}
