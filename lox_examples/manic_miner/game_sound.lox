import sound
import sound_mgr

//
// @file game_sound.lox
// @brief Wraps a sound_mgr.SoundManager with one named method per game
// sound cue. The background tune plays as one-shot note samples via
// play_next_tune_note(), one call per game tick.
//

const SOUND_PATHS = {
    "die":              "assets/die.wav",
    "level_end_swoop":  "assets/air.wav",
    "game_over_swoop":  "assets/game-over.wav",
    "jump":             "assets/jumping.wav",
    "fall":             "assets/falling.wav"
}

// Manic Miner's tune data (disassembly table at 34188), remapped from
// raw timer-period values to a sample index (0 = lowest note, see
// TUNE_NOTE_VALUES) so play_next_tune_note() can index straight into a
// sample name. Each entry sounds across 2 calls before advancing.
const TUNE_TABLE = [
    0, 1, 2, 3, 4, 2, 4, 4, 5, 3, 5, 5, 4, 2, 4, 4,
    0, 1, 2, 3, 4, 2, 4, 4, 5, 3, 5, 5, 4, 4, 4, 4,
    0, 1, 2, 3, 4, 2, 4, 4, 5, 3, 5, 5, 4, 2, 4, 4,
    0, 1, 2, 3, 4, 2, 4, 6, 4, 2, 0, 2, 4, 4, 4, 4
]

// Every distinct raw value in the disassembly's table, ordered from
// lowest note (highest timer period) to highest -- sample "tune_i" is
// TUNE_NOTE_VALUES[i]. Not read by code; kept as a record of what each
// sample index means.
const TUNE_NOTE_VALUES = [128, 114, 102, 96, 86, 81, 64]
const TUNE_NOTE_PATH_FMT = "assets/tune_%d.wav"

class Sound {
    __init__(mute: bool) {
        sound_mgr.SoundManager.no_sound = mute
        this.mgr = sound_mgr.SoundManager()
        foreach (var name in SOUND_PATHS.keys()) {
            this.mgr.load(name, SOUND_PATHS[name])
        }

        for (var i = 0; i < len(TUNE_NOTE_VALUES); i = i + 1) {
            this.mgr.load(format("tune_%d", i), format(TUNE_NOTE_PATH_FMT, i))
        }
        this.tune_tick = 0

        this.mgr.load_music("intro_tune", "assets/tune.wav")
        this.mgr.set_music_looping("intro_tune", false)
    }

    // Advances the background tune by one tick -- call once per game
    // tick during play. Each TUNE_TABLE entry plays across 2 consecutive
    // calls before moving to the next, wrapping back to the table's
    // start after its last entry's second tick.
    play_next_tune_note() {
        var table_index = int(this.tune_tick / 2) % len(TUNE_TABLE)
        var sample_index = TUNE_TABLE[table_index]
        this.mgr.play(format("tune_%d", sample_index))
        this.tune_tick = (this.tune_tick + 1) % (2 * len(TUNE_TABLE))
    }

    play_willy_dying() {
        this.mgr.play("die")
    }

    play_level_end_swoop() {
        this.mgr.play("level_end_swoop")
    }

    play_game_over_swoop() {
        this.mgr.play("game_over_swoop")
    }

    play_jump() {
        this.mgr.play("jump")
    }

    stop_jump() {
        this.mgr.stop("jump")
    }

    play_falling() {
        this.mgr.play("fall")
    }

    stop_falling() {
        this.mgr.stop("fall")
    }

    // Plays once (not looping -- see __init__'s set_music_looping call);
    // stop_intro_tune() ends it early if ENTER skips the title screen
    // before it finishes.
    play_intro_tune() {
        this.mgr.play_music("intro_tune")
    }

    stop_intro_tune() {
        this.mgr.stop_music("intro_tune")
    }

    // Polls the intro tune's stream -- call once per frame, same
    // requirement as sound_mgr.SoundManager.update() itself.
    update() {
        this.mgr.update()
    }

    close() {
        sound.close()
    }
}
