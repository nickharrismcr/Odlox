from gfx import *
import display
import colour
import intro
import game
import game_sound
import sys

//
// @file main.lox
// @brief Willy, playable: LEFT/RIGHT to walk, UP or SPACE to jump.
// Drives an intro.Intro (title screen, waits for ENTER) then a game.Game
// -- cavern/item/conveyor/guardian rendering, Willy's movement/collision/
// death, and the running/die/game_over session state all live there. This
// is just the window and presentation loop. ESC quits, at either stage.
// Owns the one game_sound.Sound shared by both states -- there's a single
// audio device for the whole process, not one per state.
//
// Usage: odlox.exe main.lox [cavern_index]
//

var argv = sys.args()
var index = 0
if (len(argv) >= 2) {
    index = int(argv[1])
}

const TARGET_FPS = 12   // Manic Miner's own tick rate -- see game_sprite.lox
const MUTE_SOUND = false

const SCALE = 3
var win = window(display.SCREEN_W * SCALE, display.SCREEN_H * SCALE)
win.init()
win.set_target_fps(TARGET_FPS)

var snd = game_sound.Sound(MUTE_SOUND)

// Intro.__init__/Game.__init__ both create a Display (and its GPU render
// texture), which needs win.init()'s GL context to already exist.
var title = intro.Intro(snd)
title.disp.upload()
var quit = false

while (!win.should_close() and !title.is_done()) {
    if (win.key_pressed(win.KEY_ESCAPE)) {
        quit = true
        break
    }

    title.tick(win)

    win.begin()
    win.clear(colour.BLACK)
    title.disp.draw(win, 0, 0, display.SCREEN_W * SCALE, display.SCREEN_H * SCALE)
    win.end()
}

var g = nil
if (!quit) {
    g = game.Game(index,TARGET_FPS,snd)
    g.disp.upload()
}

while (!quit and !win.should_close()) {
    if (win.key_pressed(win.KEY_ESCAPE)) {
        break
    }
    if (g.is_game_over()) {
        break
    }

    g.tick(win)
    g.disp.upload()

    win.begin()
    win.clear(colour.BLACK)
    // Cavern name/air/lives are drawn into the display's own HUD rows
    // now (see game.lox's draw_static_hud()/draw_lives()), not overlaid
    // here.
    g.disp.draw(win, 0, 0, display.SCREEN_W * SCALE, display.SCREEN_H * SCALE)
    win.end()
}
snd.close()
win.close()
