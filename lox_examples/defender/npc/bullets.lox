from gfx import *
import sprite
import random
import bullet

class BulletPool {
    __init__(size: int) {
        img = image("pngs/bullet.png")
        this.bullets = []
        for (i = 0; i < size; i=i+1) {
            this.bullets.append(bullet.Bullet(vec2(0,0), img, 2,1,2))
        }
    }
    fire(p: vec2, v: vec2, life: int = 100) {
        foreach (var b in this.bullets) {
            if (b.dead()) {
                b.reset(p,v,life)
                break
            }
        }
    }
    update(width: int, height: int) {
        foreach (var b in this.bullets) {
            b.update(width, height)
        }
    }
    clear() {
        foreach (var b in this.bullets) {
            b.kill()
        }
    }

    draw(win: Window,cam) {
        foreach (var b in this.bullets) {
            b.draw(win, cam)
        }
    }
}