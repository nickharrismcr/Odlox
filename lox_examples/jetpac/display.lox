from gfx import *
import colour

//
// @file display.lox
// @brief ZX Spectrum-style display: 256x192 1-bit bitmap plus a 32x24
// ink/paper attribute grid, composited on the GPU every frame.
//

const SCREEN_W = 256
const SCREEN_H = 192
const CELL = 8                       // attribute cell size, in pixels
const ATTR_COLS = SCREEN_W / CELL    // 32
const ATTR_ROWS = SCREEN_H / CELL    // 24

// Packed-rgba encoding of a set bitmap pixel -- same convention as
// attr_ink/attr_paper, so the composite shader can test texture0.r
// against a clean 0.0/1.0 instead of relying on draw_array_fast's
// incidental low-byte packing of a raw 1.0.
const BIT_SET = encode_rgba(255, 255, 255)

// Mirror win.FILTER_POINT/win.WRAP_CLAMP's rl.TextureFilter/TextureWrap
// ordinals -- Display has no window reference to read those constants
// off of, since it's constructed with no arguments.
const TEXTURE_FILTER_POINT = 0
const TEXTURE_WRAP_CLAMP = 1

// Standard fullscreen-quad vertex shader, same as every other shader
// example in this codebase.
var VERTEX_SHADER_SRC = "
#version 330

in vec3 vertexPosition;
in vec2 vertexTexCoord;
in vec3 vertexNormal;
in vec4 vertexColor;

uniform mat4 mvp;

out vec2 fragTexCoord;
out vec4 fragColor;

void main()
{
    fragTexCoord = vertexTexCoord;
    fragColor = vertexColor;
    gl_Position = mvp * vec4(vertexPosition, 1.0);
}
"

// Composites bitmap/ink/paper into the final image. inkTex/paperTex are
// 32x24 texels; FILTER_POINT + WRAP_CLAMP (set on ink_rt/paper_rt below)
// makes the GPU's texture-coordinate mapping quantize each fragment to
// its containing 8x8 cell, so no cell-index math is needed here.
var COMPOSITE_SHADER_SRC = "
#version 330
in vec2 fragTexCoord;
out vec4 finalColor;

uniform sampler2D texture0;  // bitmap_rt: WHITE = ink bit set, BLACK = clear
uniform sampler2D inkTex;    // ink_rt, 32x24, FILTER_POINT + WRAP_CLAMP
uniform sampler2D paperTex;  // paper_rt, 32x24, FILTER_POINT + WRAP_CLAMP

void main() {
    float bit = texture(texture0, fragTexCoord).r;
    vec4 ink = texture(inkTex, fragTexCoord);
    vec4 paper = texture(paperTex, fragTexCoord);
    finalColor = mix(paper, ink, bit);
}
"

class Display {
    __init__() {
        // Packed-rgba per pixel (BIT_SET or 0.0) -- the "ink bit". Never
        // stores colour, so it doubles as the source of truth for
        // pixel-perfect collision tests (via get_pixel()).
        this.bitmap = float_array(SCREEN_W, SCREEN_H)

        // One packed-rgba colour per attribute cell.
        this.attr_ink = float_array(ATTR_COLS, ATTR_ROWS)
        this.attr_paper = float_array(ATTR_COLS, ATTR_ROWS)

        this.bitmap_rt = render_texture(SCREEN_W, SCREEN_H)
        this.ink_rt = render_texture(ATTR_COLS, ATTR_ROWS)
        this.paper_rt = render_texture(ATTR_COLS, ATTR_ROWS)
        this.ink_rt.get_texture().set_filter_mode(TEXTURE_FILTER_POINT)
        this.ink_rt.get_texture().set_wrap_mode(TEXTURE_WRAP_CLAMP)
        this.paper_rt.get_texture().set_filter_mode(TEXTURE_FILTER_POINT)
        this.paper_rt.get_texture().set_wrap_mode(TEXTURE_WRAP_CLAMP)

        // Final composited output, presented by draw().
        this.rt = render_texture(SCREEN_W, SCREEN_H)

        this.composite = shader()
        this.composite.load_from_memory(VERTEX_SHADER_SRC, COMPOSITE_SHADER_SRC)
        this.ink_loc = this.composite.get_location("inkTex")
        this.paper_loc = this.composite.get_location("paperTex")

        // Set whenever attr_ink/attr_paper change; consumed (and
        // cleared) by upload(), which re-uploads ink_rt/paper_rt only
        // then -- pixel plots are far more frequent than attribute
        // changes. True here so the first upload() populates them.
        this.attr_dirty = true
    }

    // Sets every cell's paper to `paper` and ink to `ink`, and clears the
    // bitmap -- a fresh blank display in one colour, e.g. at cavern load.
    clear(ink, paper) {
        this.bitmap.clear(0.0)
        this.attr_ink.clear(ink)
        this.attr_paper.clear(paper)
        this.attr_dirty = true
    }

    // Plots one bitmap pixel: BIT_SET if bit != 0.0, else clear. Colour
    // resolution happens later, on the GPU, in upload()/draw().
    plot(x, y, bit) {
        this.bitmap.set(x, y, bit != 0.0 ? BIT_SET : 0.0)
    }

    get_pixel(x, y) -> float {
        return this.bitmap.get(x, y) != 0.0 ? 1.0 : 0.0
    }

    // Sets one attribute cell's ink/paper -- the ZX Spectrum "attribute
    // flash" primitive (see Willy's death sequence: cycles ink across
    // every cell on screen without redrawing a single sprite). The
    // bitmap itself is untouched.
    set_attr(cx, cy, ink, paper) {
        this.attr_ink.set(cx, cy, ink)
        this.attr_paper.set(cx, cy, paper)
        this.attr_dirty = true
    }

    // Starts an ink-only flash (Willy's death sequence): forces every
    // cell's paper to black.
    begin_flash() {
        this.attr_paper.clear(encode_rgba(0, 0, 0))
        this.attr_dirty = true
    }

    // One flash tick: recolours every cell's ink. Paper stays black
    // (set by begin_flash()) for the rest of the flash.
    flash_ink(ink) {
        this.attr_ink.clear(ink)
        this.attr_dirty = true
    }

    // Blits a monochrome sprite (float_array of 0.0/1.0 bits) with its
    // top-left at (x, y), then colours every attribute cell its bounding
    // box overlaps with ink/paper -- the whole cell, not just the sprite's
    // own pixels (real Spectrum attribute clash). reverse mirrors it
    // left-right. or_blit leaves an existing set pixel alone wherever the
    // sprite's own bit is 0 (instead of force-clearing it) -- for a
    // sprite meant to rest on top of static art without punching holes
    // through it (e.g. the rocket standing on a platform, whose own
    // sprites have real transparent gaps between struts/legs); most
    // callers (including this same sprite's own clear()) want the
    // default force-write instead, so background gets properly erased.
    blit_sprite(sprite, x, y, ink, paper, reverse: bool = false, or_blit: bool = false) {
        var sw = sprite.width()
        var sh = sprite.height()
        for (var sy = 0; sy < sh; sy = sy + 1) {
            var py = y + sy
            if (py < 0 or py >= SCREEN_H) { continue }
            for (var sx = 0; sx < sw; sx = sx + 1) {
                var px = x + sx
                if (px < 0 or px >= SCREEN_W) { continue }
                var src_x = sx
                if (reverse) {
                    src_x = sw - 1 - sx
                }
                var bit = sprite.get(src_x, sy)
                if (or_blit and bit == 0.0) {
                    continue
                }
                this.plot(px, py, bit)
            }
        }

        var cx0 = int(x / CELL)
        var cy0 = int(y / CELL)
        var cx1 = int((x + sw - 1) / CELL)
        var cy1 = int((y + sh - 1) / CELL)
        for (var cy = cy0; cy <= cy1; cy = cy + 1) {
            if (cy < 0 or cy >= ATTR_ROWS) { continue }
            for (var cx = cx0; cx <= cx1; cx = cx + 1) {
                if (cx < 0 or cx >= ATTR_COLS) { continue }
                this.set_attr(cx, cy, ink, paper)
            }
        }
    }

    // Rotates a width-pixel row at (x, y) circularly left by `amount`
    // positions (RLC on real hardware) -- e.g. the conveyor animation.
    // Reads/writes through plot(), so re-plotting stays idempotent.
    rotate_row_left(x, y, width, amount) {
        var old = []
        for (var i = 0; i < width; i = i + 1) {
            old.append(this.bitmap.get(x + i, y))
        }
        for (var i = 0; i < width; i = i + 1) {
            this.plot(x + i, y, old[(i + amount) % width])
        }
    }

    // As rotate_row_left, but rotating right (RRC on real hardware).
    rotate_row_right(x, y, width, amount) {
        var old = []
        for (var i = 0; i < width; i = i + 1) {
            old.append(this.bitmap.get(x + i, y))
        }
        for (var i = 0; i < width; i = i + 1) {
            var src = ((i - amount) % width + width) % width
            this.plot(x + i, y, old[src])
        }
    }

    // Shifts a width x height pixel block at (x, y) down by one row,
    // discarding the bottom row and blanking the top -- the
    // crumbling-floor animation. A shift, not a wraparound: after
    // `height` calls the block is blank regardless of its start.
    shift_rows_down(x, y, width, height) {
        for (var row = height - 1; row > 0; row = row - 1) {
            for (var col = 0; col < width; col = col + 1) {
                this.plot(x + col, y + row, this.bitmap.get(x + col, y + row - 1))
            }
        }
        for (var col = 0; col < width; col = col + 1) {
            this.plot(x + col, y, 0.0)
        }
    }

    get_ink(cx, cy) -> float {
        return this.attr_ink.get(cx, cy)
    }

    get_paper(cx, cy) -> float {
        return this.attr_paper.get(cx, cy)
    }

    // Uploads bitmap every frame; ink/paper only when attr_dirty (attribute
    // changes are rarer than pixel plots). attr_dirty is cleared by draw(),
    // once its uniforms are actually rebound. Caller still does its own
    // win.begin()/draw()/win.end() around this.
    upload() {
        this.bitmap_rt.draw_array_fast(this.bitmap)
        if (this.attr_dirty) {
            this.ink_rt.draw_array_fast(this.attr_ink)
            this.paper_rt.draw_array_fast(this.attr_paper)
        }
    }

    // Composites bitmap_rt/ink_rt/paper_rt into rt via the shader, then
    // draws rt scaled to (w, h) at (x, y). Negative source heights
    // compensate for render textures' bottom-up storage (see
    // game_of_life.lox's identical use of this).
    draw(win, x, y, w, h) {
        win.begin_texture_mode(this.rt)
        win.begin_shader_mode(this.composite)
        // set_value_texture() resolves against whichever shader program
        // is currently bound -- must run after begin_shader_mode(), not
        // in upload(), or it silently rebinds the wrong shader's sampler.
        if (this.attr_dirty) {
            this.composite.set_value_texture(this.ink_loc, this.ink_rt)
            this.composite.set_value_texture(this.paper_loc, this.paper_rt)
            this.attr_dirty = false
        }
        win.draw_texture_pro(this.bitmap_rt, 0, 0, SCREEN_W, -SCREEN_H, 0, 0, SCREEN_W, SCREEN_H, 0, 0, 0, colour.WHITE)
        win.end_shader_mode()
        win.end_texture_mode()
        win.draw_texture_pro(this.rt, 0, 0, SCREEN_W, -SCREEN_H, x, y, w, h, 0, 0, 0, colour.WHITE)
    }
}
