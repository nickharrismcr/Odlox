import json
import spectrum_attr
import game_sprite

//
// @file cavern.lox
// @brief Holds one Manic Miner cavern's layout and metadata, as produced
// by extract_cavern.lox. Graphics are never owned here -- layout cells,
// item_sprite, and portal.sprite are asset name *pointers*, resolved
// through a SpriteAssets instance (every draw method takes one).
// Guardians are the exception: load_from_dict() builds a real
// game_sprite.Sprite per guardian, driven by update_guardians()/
// draw_guardians(). Portal gameplay isn't implemented yet.
//
// Same __init__-defaults + load_from_dict(d) convention as
// game_sprite.Sprite, plus load(path) to read straight from a JSON file.
//

// Layout digit values, matching extract_cavern.lox's own TILE_NAMES order
// exactly -- this.layout[y][x] is already one of these as a character.
const TILE_BACKGROUND = 0
const TILE_FLOOR = 1
const TILE_CRUMBLING_FLOOR = 2
const TILE_WALL = 3
const TILE_CONVEYOR = 4
const TILE_NASTY1 = 5
const TILE_NASTY2 = 6
const TILE_EXTRA = 7

// Approximate: real per-tick timing isn't decoded yet -- ticks a crumbling
// floor tile can be stood on before it gives way (see Cavern.tick_crumble()).
const CRUMBLE_TICKS = 8

// An uncollected item's ink cycles through these four palette values
// once per tick -- magenta, green, cyan, yellow -- while its paper stays
// whatever the underlying room tile's paper is (see draw_items()), not
// the item's own decoded paper or an alternation with init_colour.
const ITEM_INK_CYCLE = [3, 4, 5, 6]

// Ticks per flash phase once the portal starts flashing (see
// Cavern.set_portal_flash()).
const PORTAL_FLASH_TICKS = 8

// Each tick, animate_conveyor() bit-rotates pixel row 0 of every belt
// tile by this many positions one way, and row 2 the other way (rows 1
// and 3-7 are untouched) -- there are no separate animation frames.
const CONVEYOR_ROTATE = 2

// Horizontal guardians hold their on-screen position for a full 4-frame
// animation cycle then jump 8px in one go, the block-movement convention
// already established and tested for Willy (game_sprite.lox) -- the
// 7-byte horizontal record has no speed byte, so movement_speed/
// animation_speed are fixed constants, not extracted data. Vertical
// guardians instead move continuously, 1 tick's animation speed and its
// own signed per-tick delta (g["dy"]) at a time -- see extract_cavern.lox.
const GUARDIAN_FRAMES = 4
const GUARDIAN_MOVEMENT_SPEED = 8
const GUARDIAN_ANIMATION_SPEED = 1
const SKYLAB_FRAMES = 8

// Builds a game_sprite.Sprite for one guardian record. g's min_x/max_x
// are reused as the bound pair for whichever axis movement_type is
// (min/max y for "vertical"). Horizontal guardians always spawn exactly
// on one bound (g["x"] == min_x or max_x), so start_x doubles as the
// spawn point same as before; vertical guardians can spawn mid-range, so
// init_y overrides that with g["y"] instead. A vertical guardian tagged
// "style": "skylab" (Skylab Landing Bay only) uses crash_respawn instead
// of bouncing -- see game_sprite.lox's update(). `frames` and
// `image_list` are caller-supplied (not fixed constants) because a
// cavern with both horizontal and vertical guardians splits the shared
// 8-frame sheet between them -- see load_from_dict().
func make_guardian_sprite(g, movement_type, image_list, frames) {
    var ink = spectrum_attr.colour_to_rgba(g["ink"], g["bright"])
    var paper = spectrum_attr.colour_to_rgba(g["paper"], g["bright"])
    var start_x = g["x"]
    var end_x = g["x"]
    var start_y = g["y"]
    var end_y = g["y"]
    var init_y = g["y"]
    var movement_speed = GUARDIAN_MOVEMENT_SPEED
    var step_movement = true
    var crash_respawn = false
    if (movement_type == "horizontal") {
        start_x = g["min_x"]
        end_x = g["max_x"]
    } else {
        start_y = g["min_x"]
        end_y = g["max_x"]
        movement_speed = g["dy"]
        step_movement = false
        if (g.get("style", "") == "skylab") {
            frames = SKYLAB_FRAMES
            crash_respawn = true
        }
    }
    var spr = game_sprite.Sprite()
    spr.load_from_dict({
        "type": "moving",
        "frames": frames,
        "movement_type": movement_type,
        "movement_speed": movement_speed,
        "animation_speed": GUARDIAN_ANIMATION_SPEED,
        "step_movement": step_movement,
        "crash_respawn": crash_respawn,
        "image_list": image_list,
        "start_x": start_x, "start_y": start_y,
        "end_x": end_x, "end_y": end_y,
        "init_y": init_y,
        "colour": ink, "paper": paper
    })
    return spr
}

class Cavern {
    __init__() {
        this.path = nil               // set by load(); lets a full reset just re-call load(this.path)
        this.name = ""
        this.width = 0
        this.height = 0
        this.layout = []              // row strings, one digit char (0-7) per cell, indexing tile_names
        this.tile_names = []          // 8 asset-name pointers, index-matched to layout values
        this.tile_colours = []        // 8 {name, ink, paper, bright} -- name points into a SpriteAssets, ink/paper are 0-7 palette indices
        this.willy_start = {}         // {y_times_2, frame, direction, airborne, x, y, jump_counter}
        this.conveyor = {}            // {direction, x, y, length}
        this.border_colour = 0
        this.items = []               // list of {type, x, y, ink, paper, bright, init_ink, init_paper, init_bright}
        this.item_sprite = ""         // asset name pointer
        this.portal = {}              // {ink, paper, bright, x, y, sprite}
        this.air = 0
        this.clock = 0
        this.horizontal_guardians = []   // list of {x, y, ink, paper, bright, min_x, max_x} -- min_x/max_x already in pixels
        this.vertical_guardians = []
        this.guardian_sprite_names = []   // 8 asset-name pointers (right_0..3, left_0..3)
        this.guardian_sprites = []        // game_sprite.Sprite instances, built from the above by load_from_dict
        this.crumbled = {}                // "cx,cy" -> true once a crumbling-floor cell has given way
        this.crumble_timers = {}          // "cx,cy" -> ticks remaining while still being stood on
    }

    // Sets every named field present in `d` (anything absent keeps its
    // current value) -- same pattern as game_sprite.Sprite.load_from_dict.
    load_from_dict(d) {
        this.name = d.get("name", this.name)
        this.width = d.get("width", this.width)
        this.height = d.get("height", this.height)
        this.layout = d.get("layout", this.layout)
        this.tile_names = d.get("tile_names", this.tile_names)
        this.tile_colours = d.get("tile_colours", this.tile_colours)
        this.willy_start = d.get("willy_start", this.willy_start)
        this.conveyor = d.get("conveyor", this.conveyor)
        this.border_colour = d.get("border_colour", this.border_colour)
        this.items = d.get("items", this.items)
        this.item_sprite = d.get("item_sprite", this.item_sprite)
        this.portal = d.get("portal", this.portal)
        this.air = d.get("air", this.air)
        this.clock = d.get("clock", this.clock)
        this.horizontal_guardians = d.get("horizontal_guardians", this.horizontal_guardians)
        this.vertical_guardians = d.get("vertical_guardians", this.vertical_guardians)
        this.guardian_sprite_names = d.get("guardian_sprite_names", this.guardian_sprite_names)
        this.crumbled = {}
        this.crumble_timers = {}

        // The 8-frame guardian sheet is a fixed-size, per-cavern resource:
        // a cavern with only one guardian type gives it all 8 (frames=4,
        // right+left); a cavern with both splits it in half, frames 0-3
        // for vertical (already how vertical indexes, frames=4 unchanged)
        // and 4-7 for horizontal (frames=2, so still right+left within
        // its half).
        var horizontal_image_list = this.guardian_sprite_names
        var horizontal_frames = GUARDIAN_FRAMES
        if (len(this.vertical_guardians) > 0) {
            horizontal_image_list = this.guardian_sprite_names[4:8]
            horizontal_frames = 2
        }

        this.guardian_sprites = []
        foreach (var g in this.horizontal_guardians) {
            this.guardian_sprites.append(make_guardian_sprite(g, "horizontal", horizontal_image_list, horizontal_frames))
        }
        foreach (var g in this.vertical_guardians) {
            this.guardian_sprites.append(make_guardian_sprite(g, "vertical", this.guardian_sprite_names, GUARDIAN_FRAMES))
        }
    }

    // Reads a cavern JSON file (as written by extract_cavern.lox). Records
    // path so a later load(this.path) can fully reset the room (guardians,
    // items, crumbled floors) -- e.g. after Willy dies.
    load(path) {
        this.path = path
        this.load_from_dict(json.load(path))
    }

    // Returns the asset name for the tile at grid cell (x, y). layout
    // rows are strings, one digit character (0-7) per cell, indexing
    // tile_names.
    get_tile(x, y) {
        var index = int(this.layout[y][x])
        return this.tile_names[index]
    }

    // Returns the TILE_* type at pixel position (px, py), for collision.
    // Out-of-bounds (below/beside the playfield) reads as TILE_WALL, a
    // safety floor rather than an index-out-of-range crash -- the real
    // playfield is always walled in on every side anyway. A collapsed
    // crumbling-floor cell reads as TILE_BACKGROUND without this.layout
    // itself ever being mutated.
    tile_type_at(px, py) -> int {
        var cx = int(px / 8)
        var cy = int(py / 8)
        if (cx < 0 or cx >= this.width or cy < 0 or cy >= this.height) {
            return TILE_WALL
        }
        var key = format("%d,%d", cx, cy)
        if (this.crumbled.get(key, false)) {
            return TILE_BACKGROUND
        }
        return int(this.layout[cy][cx])
    }

    // True if the tile at pixel (px, py) fully blocks movement in every
    // direction. Real game's collision rule: a non-background tile whose
    // own paper differs from the room's background paper (tile_colours'
    // TILE_BACKGROUND entry) is a full wall; one whose paper *matches* is
    // a one-way platform instead -- passable sideways and from below
    // (walking or jumping through it), but still supports Willy landing
    // on it from above (see tile_supports_landing()). Plain background
    // never blocks at all.
    tile_blocks(px, py) -> bool {
        var t = this.tile_type_at(px, py)
        if (t == TILE_BACKGROUND) {
            return false
        }
        return this.tile_colours[t]["paper"] != this.tile_colours[TILE_BACKGROUND]["paper"]
    }

    // True if Willy can stand on the tile at (px, py) when landing on it
    // from above -- any non-background tile, whether tile_blocks() or
    // not, except a nasty tile: the real game explicitly excludes those
    // (Willy falls through one rather than landing on it).
    tile_supports_landing(px, py) -> bool {
        var t = this.tile_type_at(px, py)
        if (t == TILE_BACKGROUND) {
            return false
        }
        if (t == TILE_NASTY1 or t == TILE_NASTY2) {
            return false
        }
        return true
    }

    // True if the tile at (px, py) is a one-way platform: a real,
    // non-background tile that doesn't tile_blocks(). Willy renders in
    // *its* ink while overlapping one (see willy.lox's draw()) rather
    // than his own fixed colour -- plain background isn't a "block" at
    // all, so it doesn't count even though it also doesn't block.
    tile_is_platform(px, py) -> bool {
        var t = this.tile_type_at(px, py)
        if (t == TILE_BACKGROUND) {
            return false
        }
        return !this.tile_blocks(px, py)
    }

    // The room's own background paper, as a packed colour -- Willy force-
    // blits with this (not a fixed colour) wherever he overlaps open
    // background, so it matches whatever this cavern's background is.
    background_paper() -> float {
        var bg = this.tile_colours[TILE_BACKGROUND]
        return spectrum_attr.colour_to_rgba(bg["paper"], bg["bright"])
    }

    // Call once per tick while Willy is standing on a still-solid
    // crumbling-floor cell at pixel position (px, py); each call shifts
    // the cell's own 8 pixel rows down by one (the row that falls off the
    // bottom is gone, the row left at top is blank), so after
    // CRUMBLE_TICKS calls the cell is visually empty and collapses
    // (tile_type_at() then reads it as TILE_BACKGROUND, and the cell is
    // redrawn to match its true background attribute). Calling this on a
    // cell that isn't TILE_CRUMBLING_FLOOR, or that has already collapsed,
    // is harmless.
    tick_crumble(disp, lib, px, py) {
        var cx = int(px / 8)
        var cy = int(py / 8)
        var key = format("%d,%d", cx, cy)
        if (this.crumbled.get(key, false)) {
            return
        }
        disp.shift_rows_down(cx * 8, cy * 8, 8, 8)
        var remaining = this.crumble_timers.get(key, CRUMBLE_TICKS) - 1
        if (remaining <= 0) {
            this.crumbled[key] = true
            this.redraw_tile_cell(disp, lib, cx, cy)
        } else {
            this.crumble_timers[key] = remaining
        }
    }

    // Redraws whatever tile currently occupies grid cell (cx, cy) --
    // tile_type_at()'s own crumbled-overlay check, not the raw layout
    // digit, so a collapsed cell redraws as TILE_BACKGROUND. Used to erase
    // an item's icon once collect_item_at() removes it (items are drawn
    // straight onto disp's bitmap with no erase-tracking of their own,
    // unlike game_sprite.Sprite) and to reveal a crumbled floor cell.
    redraw_tile_cell(disp, lib, cx, cy) {
        var index = this.tile_type_at(cx * 8, cy * 8)
        var tile = this.tile_colours[index]
        var img = lib.get(tile["name"])
        var ink = spectrum_attr.colour_to_rgba(tile["ink"], tile["bright"])
        var paper = spectrum_attr.colour_to_rgba(tile["paper"], tile["bright"])
        disp.blit_sprite(img, cx * 8, cy * 8, ink, paper)
    }

    // Marks the first uncollected item overlapping the given pixel bounding
    // box as collected, erases its icon, and returns it (nil if none
    // overlap). Items are 8x8; collected ones are skipped both here and by
    // draw_items().
    collect_item_at(disp, lib, px, py, pw, ph) {
        foreach (var item in this.items) {
            if (item.get("collected", false)) {
                continue
            }
            var overlap_x = px < item["x"] + 8 and px + pw > item["x"]
            var overlap_y = py < item["y"] + 8 and py + ph > item["y"]
            if (overlap_x and overlap_y) {
                item["collected"] = true
                this.redraw_tile_cell(disp, lib, int(item["x"] / 8), int(item["y"] / 8))
                return item
            }
        }
        return nil
    }

    all_items_collected() -> bool {
        foreach (var item in this.items) {
            if (!item.get("collected", false)) {
                return false
            }
        }
        return true
    }

    // Bounding-box test against every guardian's current position.
    // Guardians (like Willy) are always 16x16.
    guardian_hit(px, py, pw, ph) -> bool {
        foreach (var g in this.guardian_sprites) {
            var overlap_x = px < g.x + 16 and px + pw > g.x
            var overlap_y = py < g.y + 16 and py + ph > g.y
            if (overlap_x and overlap_y) {
                return true
            }
        }
        return false
    }

    // Draws every layout cell's tile onto disp (an 8px-aligned blit per
    // cell, so no attribute clash between neighbouring tiles), resolving
    // graphics through lib -- a SpriteAssets loaded from this cavern's
    // own *_sprites.json. tile_colours' ink/paper are 0-7 palette
    // indices, resolved to actual colours once per tile here (not once
    // per cell) via spectrum_attr.colour_to_rgba().
    draw(disp, lib) {
        var resolved = []
        foreach (var tile in this.tile_colours) {
            resolved.append({
                "name": tile["name"],
                "ink": spectrum_attr.colour_to_rgba(tile["ink"], tile["bright"]),
                "paper": spectrum_attr.colour_to_rgba(tile["paper"], tile["bright"])
            })
        }
        for (var y = 0; y < this.height; y = y + 1) {
            for (var x = 0; x < this.width; x = x + 1) {
                var index = int(this.layout[y][x])
                var tile = resolved[index]
                var img = lib.get(tile["name"])
                disp.blit_sprite(img, x * 8, y * 8, tile["ink"], tile["paper"])
            }
        }
        this.draw_portal(disp, lib)
    }

    // Draws the portal at its own position in its own (non-flashing)
    // colour -- static, so unlike draw_items()/draw_guardians() this only
    // needs calling once (draw() does so). See set_portal_flash() for the
    // per-tick flash once every item is collected.
    draw_portal(disp, lib) {
        var img = lib.get(this.portal["sprite"])
        var ink = spectrum_attr.colour_to_rgba(this.portal["ink"], this.portal["bright"])
        var paper = spectrum_attr.colour_to_rgba(this.portal["paper"], this.portal["bright"])
        disp.blit_sprite(img, this.portal["x"], this.portal["y"], ink, paper)
    }

    // Once all_items_collected(), alternates the portal between its
    // normal ink/paper and them swapped, every PORTAL_FLASH_TICKS ticks --
    // call once per game tick, same convention as draw_items(). A no-op
    // until every item is collected.
    set_portal_flash(disp, lib, tick) {
        if (!this.all_items_collected()) {
            return
        }
        var img = lib.get(this.portal["sprite"])
        var ink = spectrum_attr.colour_to_rgba(this.portal["ink"], this.portal["bright"])
        var paper = spectrum_attr.colour_to_rgba(this.portal["paper"], this.portal["bright"])
        if (int(tick / PORTAL_FLASH_TICKS) % 2 == 0) {
            disp.blit_sprite(img, this.portal["x"], this.portal["y"], ink, paper)
        } else {
            disp.blit_sprite(img, this.portal["x"], this.portal["y"], paper, ink)
        }
    }

    // Draws every (uncollected) item using the shared item_sprite icon.
    // Ink cycles through ITEM_INK_CYCLE once per tick, offset by each
    // item's own index so items shimmer in a staggered wave rather than
    // flashing in unison; tick is owned by the caller (game_sprite.Sprite
    // callers do the same). Paper/bright come from the room tile
    // occupying the item's cell, not the item's own extracted paper/
    // bright. Items never move, so no erase step is needed.
    draw_items(disp, lib, tick) {
        var img = lib.get(this.item_sprite)
        for (var i = 0; i < len(this.items); i = i + 1) {
            var item = this.items[i]
            if (item.get("collected", false)) {
                continue
            }
            var ink_value = ITEM_INK_CYCLE[(tick + i) % len(ITEM_INK_CYCLE)]
            var cx = int(item["x"] / 8)
            var cy = int(item["y"] / 8)
            var tile_index = int(this.layout[cy][cx])
            var tile = this.tile_colours[tile_index]
            var ink = spectrum_attr.colour_to_rgba(ink_value, tile["bright"])
            var paper = spectrum_attr.colour_to_rgba(tile["paper"], tile["bright"])
            disp.blit_sprite(img, item["x"], item["y"], ink, paper)
        }
    }

    // Bit-rotates pixel rows 0 and 2 of every belt tile already on the
    // display -- no separate animation frames, no frame/tick state of its
    // own. direction 0 ("moving left") rotates row 0 left and row 2
    // right; any other value ("moving right") does the opposite. Requires
    // this.conveyor's tiles to already be drawn, and does nothing if
    // length is 0.
    animate_conveyor(disp) {
        var length = this.conveyor.get("length", 0)
        if (length <= 0) {
            return
        }
        var left_row = 0
        var right_row = 2
        if (this.conveyor["direction"] != 0) {
            left_row = 2
            right_row = 0
        }
        var x0 = this.conveyor["x"]
        var y0 = this.conveyor["y"]
        for (var t = 0; t < length; t = t + 1) {
            var x = x0 + t * 8
            disp.rotate_row_left(x, y0 + left_row, 8, CONVEYOR_ROTATE)
            disp.rotate_row_right(x, y0 + right_row, 8, CONVEYOR_ROTATE)
        }
    }

    // Advances every guardian's animation/position by one tick. Call
    // once per game tick, before draw_guardians().
    update_guardians() {
        foreach (var g in this.guardian_sprites) {
            g.update()
        }
    }

    // Draws every guardian at its current position -- each Sprite
    // handles its own erase-before-redraw (see game_sprite.lox).
    draw_guardians(disp, lib) {
        foreach (var g in this.guardian_sprites) {
            g.draw(disp, lib)
        }
    }
}
