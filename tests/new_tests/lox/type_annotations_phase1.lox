// Phase 1 of optional type annotations: annotations at all three sites
// (param, var decl, return type), plus generic and nilable forms, parse
// and are silently ignored -- runtime behaviour must be identical to the
// unannotated equivalent. See docs/plans/done/optional-type-checking-implementation.md.

var a: int = 1
var b: List[int] = [1, 2, 3]
var c: string?
print a
print b
print c

func add(x: int, y: int = 10) -> int {
	return x + y
}
print add(5)
print add(5, 20)

func greet(name: string?) -> string {
	if (name == nil) {
		return "hello, stranger"
	}
	return "hello, " & name
}
print greet(nil)
print greet("Sam")

class Box {
	__init__(value: int) {
		this.value = value
	}
	get() -> int {
		return this.value
	}
}
var box = Box(42)
print box.get()
