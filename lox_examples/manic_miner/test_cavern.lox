import cavern
import sys

//
// @file test_cavern.lox
// @brief Loads a cavern JSON (as written by extract_cavern.lox) and
// prints its layout grid as ASCII (one letter per tile type) plus key
// metadata, for a human shape/sanity check against the real game.
//
// Usage: odlox.exe test_cavern.lox <path/to/cavern_N.json>
//

// Ordered most-specific-suffix-first ("crumbling_floor" before "floor",
// which is itself a suffix of it) -- a plain dict's iteration order
// isn't controllable, so this has to be a list, not a dict.
const LETTERS = [
    ["crumbling_floor", "c"],
    ["background", "."],
    ["floor", "="],
    ["wall", "#"],
    ["conveyor", "v"],
    ["nasty1", "N"],
    ["nasty2", "n"],
    ["extra", "8"]
]

// Tile asset names are "<prefix>_tile_<type>" -- match by suffix since
// there's no string.find()/contains() in this Lox dialect.
func ends_with(s, suffix) {
    var n = len(s)
    var m = len(suffix)
    if (m > n) {
        return false
    }
    return s[n - m:n] == suffix
}

func tile_letter(name) {
    foreach (var pair in LETTERS) {
        if (ends_with(name, pair[0])) {
            return pair[1]
        }
    }
    return "?"
}

var argv = sys.args()
if (len(argv) < 2) {
    print("usage: test_cavern.lox <path/to/cavern_N.json>")
} else {
    var c = cavern.Cavern()
    c.load(argv[1])

    print(format("-- %s (%dx%d) --", c.name, c.width, c.height))
    for (var y = 0; y < c.height; y = y + 1) {
        var row = ""
        for (var x = 0; x < c.width; x = x + 1) {
            row = row & tile_letter(c.get_tile(x, y))
        }
        print(row)
    }

    print(format("willy_start: %s", c.willy_start))
    print(format("conveyor: %s", c.conveyor))
    print(format("border_colour: %d  air: %d  clock: %d", c.border_colour, c.air, c.clock))
    print(format("items (%d): %s", len(c.items), c.items))
    print(format("horizontal_guardians (%d): %s", len(c.horizontal_guardians), c.horizontal_guardians))
    print(format("vertical_guardians (%d): %s", len(c.vertical_guardians), c.vertical_guardians))
    print(format("guardian_sprite_names: %s", c.guardian_sprite_names))
}
