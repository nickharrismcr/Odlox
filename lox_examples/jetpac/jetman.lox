from gfx import *
from game_sprite import Sprite

// @file jetman.lox
// @brief Jetman: fly/walk states and physics, derived from
// JetmanFlyThrust ($739E), JetmanWalk ($753C) and PlatformCollision
// ($75FC, see platform.lox). Movement is a state machine of
// state_<name>/enter_<name> functions, matching this codebase's
// established convention; everything but __init__/spawn/step/draw is a
// module-level free function taking j first.

// Physics constants, decimal (this dialect has no hex literals), each
// with the disassembly address it came from.
const VEL_ACCEL          = 8    // $73C3/$7425: 8 minus the velocity modifier
const VEL_MODIFIER       = 4    // $5DCA: 0 or 4, halving acceleration
const ACCEL_STEP         = VEL_ACCEL - VEL_MODIFIER  // per-tick velocity change, accelerating or braking
const MAX_VEL_X_FLYING   = 64   // $40, $73D6 clamp
const MAX_VEL_X_WALKING  = 32   // $20, $757C/$75B8
const MAX_VEL_Y          = 63   // $3F, $7448 clamp
const WALK_STEP          = 1    // $75AD/$75BF: 1 pixel per tick
const SCREEN_TOP_Y        = 42  // $2A, $746B: flight clamped to 42..192
const SCREEN_BOTTOM_Y     = 192 // $C0
const JETMAN_HEIGHT       = 36  // $24, default_player_state byte 7
const ALIEN_HIT_DX        = 12  // $0C, $6E00 -- alien.lox's collision test
const ALIEN_HIT_DY        = 21  // $15, $6E14

const SCREEN_W = 256.0

// Jetman's X position wraps mod 256 -- a free side effect of it being a
// single 8-bit byte on real hardware (JetmanFlyHorizontal never clamps
// it), not a deliberate design choice this port re-derives.
func wrap_x(x) {
    var w = x % SCREEN_W
    if (w < 0.0) {
        w = w + SCREEN_W
    }
    return w
}

// Moves vel toward max by ACCEL_STEP if want_this_dir (accelerating in
// the currently facing/moving direction); else brakes toward zero
// first, only flipping (returned as "flip") once vel would go negative
// -- same shape as JetmanVelIncX/JetmanDirFlipX (and their Y-axis
// equivalents), so a direction change decelerates smoothly rather than
// snapping straight to the opposite facing.
func accel_or_flip(vel, want_this_dir, max_vel) {
    if (want_this_dir) {
        var nv = vel + ACCEL_STEP
        if (nv > max_vel) {
            nv = max_vel
        }
        return {"vel": nv, "flip": false}
    }
    var nv = vel - ACCEL_STEP
    if (nv <= 0) {
        return {"vel": 0, "flip": true}
    }
    return {"vel": nv, "flip": false}
}

class Jetman < Sprite {
    __init__(sound) {
        super.__init__()
        this.sound = sound
        this.frames = 1
        this.colour = encode_rgba(255, 255, 255)
        this.paper = encode_rgba(0, 0, 0)
        this.or_blit = true  // don't punch through a platform's own art while standing/walking on it
        this.facing_left = false
        this.moving_down = true
        this.vel_x = 0
        this.vel_y = 0
        this.dead = false
        this.update_func = state_fly
        this.launched_this_tick = false
    }

    // (Re)spawns from data/jetpac_static.json's default_jetman record --
    // used both for the initial spawn and every respawn after death.
    // default_jetman's own motion=1 (bit0 "flying", bit7 "fly up") is
    // why Jetman starts airborne rather than standing.
    spawn(static_data) {
        var d = static_data["default_jetman"]
        this.x = float(d["x"])
        this.y = float(d["y"])
        this.facing_left = false
        this.moving_down = false
        this.vel_x = 0
        this.vel_y = 0
        this.dead = false
        this.last_x = nil
        this.last_y = nil
        this.sound.pickup_item()  // SfxPickupItem: also played when Jetman appears on-screen
        enter_fly(this)
    }

    // Dispatches through update_func -- named step() to avoid colliding
    // with Sprite's own per-frame bookkeeping. launched_this_tick is
    // reset here (not by state_walk itself) so it's a clean one-tick
    // pulse regardless of which state runs this call.
    step(input, platforms) {
        this.launched_this_tick = false
        var f = this.update_func
        f(this, input, platforms)
    }

    is_dead() -> bool {
        return this.update_func == state_dying
    }

    is_boarding() -> bool {
        return this.update_func == state_boarding
    }

    // Covers both "not drawn/stepped" states -- game.lox uses this for
    // its draw/input gating, while is_dead() alone still gates the
    // death/respawn timer specifically (boarding respawns via
    // rocket.lox's own landing instead, no life lost, no timer).
    is_hidden() -> bool {
        return this.is_dead() or this.is_boarding()
    }

    // RocketUpdate ($66D0): Jetman "finds and destroys" (vanishes,
    // no explosion) once he touches a fully-fuelled rocket on the pad
    // -- he's boarding it, not dying. last_x/last_y reset so a stray
    // clear() call while hidden doesn't keep stomping wherever he last
    // stood (see Sprite.clear()'s own nil check).
    board() {
        this.update_func = state_boarding
        this.last_x = nil
        this.last_y = nil
    }

    // Alien contact / falling too far / running out of air -- whatever
    // kills Jetman calls this rather than reaching into enter_dying
    // directly.
    kill() {
        this.sound.explode_player()
        enter_dying(this)
    }

    // Overrides Sprite.draw(): the "frame" is really a pose/facing/
    // walk-cycle lookup, picked fresh each tick -- see
    // current_sprite_name(). Two *separate* corrections combine to get
    // the real draw X, both confirmed from ActorUpdate ($7207)/Coord2Scr
    // ($72D0): (1) `- walk_shift(this)` cancels the sub-byte pixel
    // offset already baked into the chosen shift sprite's own artwork
    // (Coord2Scr truncates X to a byte boundary -- `rrca x3; and $1F`,
    // i.e. floor(x/8)*8 -- discarding exactly the low bits walk_shift()
    // computes, since this port blits at an arbitrary x and so doesn't
    // need a byte-aligned address the way the ROM's own blitter does);
    // (2) `+ lib.get_x_offset(name)` adds the chosen sprite's own fixed
    // per-variant header offset (ActorUpdate's "add a,l"), which is 0
    // for every right-facing shift variant but +8 for the narrower
    // 2-tile left-facing ones (see assets.lox's get_x_offset() comment).
    // x_offset is always a whole multiple of 8 in the ROM's own data,
    // so it doesn't interact with walk_shift()'s truncation -- the two
    // corrections are independent and additive. Dropping either one
    // alone breaks something: no x_offset term looked right for RIGHT
    // (whose own offsets are always 0) but left a several-pixel jump on
    // LEFT every time the shift slot changed; dropping walk_shift()
    // instead (this port's own first attempt at fixing that) made
    // *both* directions jerky, since walk_shift()'s correction was
    // never actually about facing, just about this port's own
    // arbitrary-x blitter needing to undo the ROM art's baked-in
    // byte-alignment shift.
    draw(disp, lib) {
        var name = current_sprite_name(this)
        this.image_list = [name]
        this.frame = 0
        var true_x = this.x
        if (this.update_func == state_walk) {
            this.x = true_x - float(walk_shift(this)) + float(lib.get_x_offset(name))
        }
        super.draw(disp, lib)
        this.x = true_x
    }
}

// ActorGetSpriteAddress indexes jetman_sprite_table by x&$06 to *pick*
// which of the 4 pre-shifted sprites to use -- not, as this port
// originally assumed, to compute a draw-position compensation (see
// draw()'s own comment for that correction). The 4 shift sprites for
// the walking pose specifically aren't just byte-alignment copies of
// each other -- they show genuinely different leg positions (compare
// jetman_walk_right_shift0's legs against shift2's staggered stride) --
// so this same x&$06 lookup doubles as Jetman's walk-cycle animation
// index, since x advances by WALK_STEP each tick and naturally cycles
// through all 4 shifts. The flying pose's own 4 shifts are clean
// re-shifted copies with no comparable leg movement (a jetpack thrust
// pose doesn't "walk"), so flying still only ever uses shift0.
func walk_shift(j) {
    var shift = int(j.x) % 8
    return int(shift / 2) * 2
}

func current_sprite_name(j) {
    if (j.update_func == state_walk) {
        var dir = "right"
        if (j.facing_left) {
            dir = "left"
        }
        return format("jetman_walk_%s_shift%d", dir, walk_shift(j))
    }
    var dir = "right"
    if (j.facing_left) {
        dir = "left"
    }
    return format("jetman_fly_%s_shift0", dir)
}

func enter_fly(j) {
    j.update_func = state_fly
}

func enter_walk(j) {
    j.update_func = state_walk
    j.vel_x = 0
}

func enter_dying(j) {
    j.dead = true
    j.update_func = state_dying
}

// Horizontal flight: accelerates toward max speed in the held
// direction, brakes toward zero (then flips facing) on a direction
// change, and drag-decelerates to a stop with no input held. Position
// wraps at the screen edges (see wrap_x).
func fly_horizontal(j, input) {
    if (!input.left and !input.right) {
        var nv = j.vel_x - ACCEL_STEP
        if (nv < 0) {
            nv = 0
        }
        j.vel_x = nv
    } else {
        var want_right = input.right
        var currently_right = !j.facing_left
        var r = accel_or_flip(j.vel_x, want_right == currently_right, MAX_VEL_X_FLYING)
        j.vel_x = r["vel"]
        if (r["flip"]) {
            j.facing_left = !j.facing_left
        }
    }
    var dx = j.vel_x / 32.0
    if (j.facing_left) {
        dx = -dx
    }
    j.x = wrap_x(j.x + dx)
}

// Vertical flight: accelerates upward while thrust is held, otherwise
// gravity accelerates downward at the same rate; releasing thrust while
// rising brakes first (accel_or_flip), so the transition to falling is
// smooth rather than an instant velocity reset. Bounces softly off the
// screen's top/bottom (JetmanStateSetDownSlow/JetmanStateSetUp) --
// platform landing is a separate check in state_fly, since it can
// happen anywhere in between. Holding hover overrides all of that: Y
// velocity is forced to zero and no dy is applied this tick, so Jetman
// holds his current altitude exactly (mirrors JetmanVelSetYMin, $7438
// -- the ROM's own "undocumented hover key" reached via a keyboard-scan
// timing quirk rather than a real bound key, but the effect -- Y
// velocity zeroed for the tick -- is the same one this port binds
// deliberately). No SFX here: JetmanFlyThrust/JetmanFalling ($739E/
// $7412) never call any sound routine -- SfxThrusters ($67B6, despite
// its name) is only ever used for the Rocket's own flame during
// takeoff/landing and an alien death cue, never for Jetman's personal
// thrust. An earlier version of this port played a continuous pitched
// tone here on every held thrust, which was never part of the original
// game.
func fly_vertical(j, input) {
    if (input.hover) {
        j.vel_y = 0
        return
    }

    var want_up = input.thrust
    var currently_up = !j.moving_down
    var r = accel_or_flip(j.vel_y, want_up == currently_up, MAX_VEL_Y)
    j.vel_y = r["vel"]
    if (r["flip"]) {
        j.moving_down = !j.moving_down
    }

    var dy = j.vel_y / 32.0
    if (j.moving_down) {
        j.y = j.y + dy
    } else {
        j.y = j.y - dy
    }

    if (j.y < SCREEN_TOP_Y) {
        j.y = float(SCREEN_TOP_Y)
        j.vel_y = int(j.vel_y / 2)
        j.moving_down = true
    } else if (j.y > SCREEN_BOTTOM_Y) {
        j.y = float(SCREEN_BOTTOM_Y)
        j.moving_down = false
    }
}

func state_fly(j, input, platforms) {
    var old_y = j.y
    fly_horizontal(j, input)
    fly_vertical(j, input)

    // landed/head_bump are only honoured while actually travelling that
    // direction (falling onto a surface, rising into one) -- otherwise
    // jetmanLeavePlatform's own 2px liftoff hop is smaller than
    // LAND_TOLERANCE, and the very next tick would re-land on the
    // platform Jetman just launched from.
    var result = platforms.collide(j.x, old_y, j.y, JETMAN_HEIGHT)
    if (result["landed"] and j.moving_down) {
        j.y = result["snap_y"]
        enter_walk(j)
    } else if (result["head_bump"] and !j.moving_down) {
        j.moving_down = true
    } else if (result["blocked_x"]) {
        j.facing_left = !j.facing_left
        j.vel_x = 0
    }
}

// Walking moves a flat WALK_STEP per tick (no accel curve, matching
// JetmanWalk's unconditional inc/dec), then checks THRUST -- held, or
// no longer supported underfoot (walked off an edge) -- to launch back
// into flight (jetmanLeavePlatform's small hop off the surface).
func state_walk(j, input, platforms) {
    if (input.right) {
        j.x = wrap_x(j.x + WALK_STEP)
        j.facing_left = false
        j.vel_x = MAX_VEL_X_WALKING
    } else if (input.left) {
        j.x = wrap_x(j.x - WALK_STEP)
        j.facing_left = true
        j.vel_x = MAX_VEL_X_WALKING
    } else {
        j.vel_x = 0
    }

    var result = platforms.collide(j.x, j.y, j.y, JETMAN_HEIGHT)
    if (input.thrust or !result["landed"]) {
        enter_fly(j)
        j.y = j.y - 2.0
        j.moving_down = false
        // jetmanLeavePlatform ($757F) sets up jetman_thruster_anim_state
        // ($5D48) here and lets the shared AnimateExplosion routine
        // ($687A) run it through the same big/medium/small sprite cycle
        // used for kills -- Game.spawn_explosion() is this port's
        // equivalent of that shared explosion object/pool.
        j.launched_this_tick = true
    }
}

// Frozen while dead -- the owning Game drives death timing and calls
// spawn() again once it's done.
func state_dying(j, input, platforms) {
}

// Frozen while boarding the rocket -- rocket.lox's own state_landing
// calls spawn() again once it lands back on the pad.
func state_boarding(j, input, platforms) {
}
