from gfx import *

// @file game_sprite.lox
// @brief A drawable, animated sprite: erase-then-draw save-under
// machinery (last_x/last_y/blank/erase_ink/erase_paper) plus frame
// cycling. Adapted from manic_miner's Sprite: no bounce-between-bounds
// movement -- no Jetpac entity moves that way, so owning classes
// (Jetman, Item, Alien, ...) set x/y (and, for an animated entity,
// advance the frame) themselves. Composed or extended by every Jetpac
// entity class.

class Sprite {
    __init__() {
        this.frames = 1
        this.animation_speed = 1     // ticks per animation frame
        this.image_list = []         // sprite names, indexed by frame
        this.colour = nil
        this.paper = nil
        this.reverse = false  // mirror left-right (e.g. a meteor travelling right to left)
        this.or_blit = false  // true: don't punch through platform art under this sprite's own transparent pixels (e.g. Jetman/an item standing on a platform)

        this.x = 0.0
        this.y = 0.0
        this.frame = 0
        this.tick = 0

        this.last_x = nil     // where draw() last blitted -- nil means "never drawn yet"
        this.last_y = nil
        this.blank = nil      // lazily sized to the first frame drawn, reused every erase

        this.erase_ink = nil    // the room's own ink/paper under the last drawn position,
        this.erase_paper = nil  // captured just before it was painted over -- see draw()
    }

    // Advances the animation frame every animation_speed ticks,
    // wrapping. Position is the owning class's own responsibility.
    advance_frame() {
        this.tick = this.tick + 1
        if (this.tick >= this.animation_speed) {
            this.tick = 0
            this.frame = (this.frame + 1) % this.frames
        }
    }

    // Erases wherever this sprite last drew itself (a no-op on the
    // first call, since last_x is nil) before any sprite draws this
    // tick, so a fresh draw isn't wiped by a later clear. last_x/last_y
    // already record the actual top-left blit_sprite() position (see
    // draw()), not this.x/this.y directly.
    clear(disp) {
        if (this.last_x != nil) {
            disp.blit_sprite(this.blank, this.last_x, this.last_y, this.erase_ink, this.erase_paper)
        }
    }

    // Looks up image_list[frame] in lib and blits it onto disp, in this
    // sprite's colour/paper, with this.x/this.y as the BOTTOM-left
    // corner -- every "Actor" sprite's Y in this ROM (Jetman, items,
    // aliens, explosions) is a feet/bottom anchor, not top-left
    // (MaskSprite $7705 starts at the actor's own Y and draws upward via
    // ScreenPosOnePixelAbove; the row data itself is also bottom-first,
    // see skool.lox's header and extract_jetpac.lox's reverse_rows()).
    // clear() must already have run this tick -- draw() doesn't erase.
    draw(disp, lib) {
        var name = this.image_list[this.frame]
        var img = lib.get(name)

        // Resized whenever the drawn image's own size changes, not just
        // allocated once -- entities that reuse one Sprite/Item across
        // different sprite names of different sizes (Item's shared
        // module/fuel/collectible slots; explosion.lox's 3-frame cycle,
        // later) would otherwise erase with a stale, wrongly-sized blank.
        if (this.blank == nil or this.blank.width() != img.width() or this.blank.height() != img.height()) {
            this.blank = float_array(img.width(), img.height())
        }

        var ix = int(this.x)
        var iy = int(this.y) - img.height()
        var cx = int(ix / 8)
        var cy = int(iy / 8)
        this.erase_ink = disp.get_ink(cx, cy)
        this.erase_paper = disp.get_paper(cx, cy)

        disp.blit_sprite(img, ix, iy, this.colour, this.paper, this.reverse, this.or_blit)

        this.last_x = ix
        this.last_y = iy
    }
}
