from gfx import *
import spectrum_attr
import item as item_module

// @file rocket.lox
// @brief The Rocket: modules (1..3), fuel (0..6), takeoff/landing, and
// colour banding by fuel collected. States state_on_pad/
// state_taking_off/state_landing, mirroring the skool's own move
// values $09/$0A/$0B (RocketUpdate/RocketTakeoff/RocketLanding).
// Level cycling (out of scope, see docs/plans/jetpac-port.md) is
// replaced with a simple pad<->launch loop so the core build/launch
// cycle stays playable/testable indefinitely.

const ROCKET_PAD_Y = 183          // $B7, RocketLanding's landed check
const ROCKET_LAUNCH_TOP_Y = 40    // $28, RocketTakeoff's top-of-screen check
const FUEL_PODS_NEEDED = 6        // RocketUpdate's takeoff gate
const RISE_STEP = 1               // RocketTakeoff/RocketLanding: 1px/tick (dec/inc)
const ROCKET_TILE = 16
const MAX_MODULES = 3
const STACK_HEIGHT = MAX_MODULES * ROCKET_TILE  // module stack, top to y
const FLAME_HEIGHT = 16                          // flame sprites extend below y, during takeoff/landing
const ERASE_HEIGHT = STACK_HEIGHT + FLAME_HEIGHT // clear()'s blank buffer covers both

const MODULE_SPRITES = ["rocket_u1_bottom", "rocket_u1_middle", "rocket_u1_top"]
const FLAME_SPRITES = ["rocket_flames_0", "rocket_flames_1"]
const FLAME_ANIM_TICKS = 4

const CELL = 8
const FLASH_TICKS = 16  // UpdateRocketColour: timer bit 4 -> toggles every 16 game ticks

// UpdateRocketColour ($66FC), confirmed against jetpac.skool $6741-$678B:
// banding only kicks in once the rocket is fully built (modules ==
// MAX_MODULES) -- `sla b` / `cp $06` on the modules count gates the
// whole routine, so a partially-built stack (or one with zero fuel) is
// always plain white regardless of fuel collected. A full tank (fuel >=
// FUEL_PODS_NEEDED) doesn't band at all -- it flashes the *entire*
// stack between magenta and white on the game timer ($675e-$675f: a
// fresh colour computed from timer bit 4 each call). Otherwise ($6762-
// $6777) the bottom `fuel*8` pixels are painted solid magenta counting
// up from the rocket's own base, the rest above solid white.
//
// row_top_y is the top pixel of ONE attribute row (row_cy*CELL) -- the
// row is coloured by testing its own *midpoint* against the magenta/
// white pixel boundary rather than a discrete "cell index", because
// ROCKET_PAD_Y (183) is not itself a multiple of 8: every module
// tile's 16px sprite therefore straddles 3 attribute rows, not a clean
// 2, and a per-tile-half discrete cell index left one of those three
// rows uncorrected (still whatever plain white blit_sprite's own base
// call left it at) -- the visible bug this replaced ("stripes" where a
// row should have been part of a solid magenta band). Continuous
// pixel-space math is correct regardless of alignment.
func row_ink(rocket, row_top_y, white, magenta, flash_on) {
    if (rocket.modules < MAX_MODULES or rocket.fuel == 0) {
        return white
    }
    if (rocket.fuel >= FUEL_PODS_NEEDED) {
        if (flash_on) { return magenta }
        return white
    }
    var boundary_y = rocket.y - float(rocket.fuel) * float(CELL)
    var row_mid = float(row_top_y) + float(CELL) / 2.0
    if (row_mid >= boundary_y) {
        return magenta
    }
    return white
}

// AlienCollision ($6DE9), which RocketUpdate ($66D0) reuses with
// IX=Rocket for Jetman-touches-rocket proximity: X within 12px; Y is
// asymmetric -- within 21px if Jetman is at-or-below the rocket's own
// Y anchor, but only within (rocket.height - 14) if Jetman is ABOVE it
// (height=28 by default -- a tighter 14px catch window from above,
// since Jetman has to actually reach the rocket's own top rather than
// just being "somewhere above it").
const TOUCH_DX = 12.0
const TOUCH_DY_BELOW = 21.0

func near_jetman(rocket, jetman) -> bool {
    var dx = jetman.x - rocket.x
    if (dx < 0.0) { dx = -dx }
    if (dx >= TOUCH_DX) {
        return false
    }
    var dy = jetman.y - rocket.y
    if (dy >= 0.0) {
        return dy < TOUCH_DY_BELOW
    }
    dy = -dy
    return dy < (rocket.height - 14.0)
}

class Rocket {
    __init__(static_data, sound) {
        var d = static_data["default_rocket"]
        this.sound = sound
        this.x = float(d["x"])
        this.y = float(d["y"])
        this.height = float(d["height"])
        this.modules = d["modules"]
        this.fuel = d["fuel"]
        this.update_func = state_on_pad
        this.flame_tick = 0
        this.flame_frame = 0
        this.colour_tick = 0

        this.last_x = nil
        this.last_y = nil
        this.blank = float_array(ROCKET_TILE, ERASE_HEIGHT)
        this.erase_ink = nil
        this.erase_paper = nil
    }

    // SfxRocketBuild: "activated when ship module is dropped, or fuel
    // cell touches the rocket base" -- both delivery events share it.
    // Reaching FUEL_PODS_NEEDED does NOT launch by itself -- see
    // state_on_pad()'s own comment.
    add_fuel() {
        this.sound.rocket_build()
        this.fuel = this.fuel + 1
    }

    add_module() {
        this.sound.rocket_build()
        if (this.modules < MAX_MODULES) {
            this.modules = this.modules + 1
        }
    }

    is_taking_off() -> bool {
        return this.update_func == state_taking_off
    }

    // jetman/game are only actually needed by state_on_pad (the launch
    // trigger, which touches both) and state_landing (respawning
    // Jetman once the rocket's back on the pad) -- threaded through
    // every state function uniformly since they share one dispatch.
    step(jetman, game) {
        var f = this.update_func
        f(this, jetman, game)
    }

    // Erases from the topmost possible module tile (y - STACK_HEIGHT)
    // down through the flame's own extent (y + FLAME_HEIGHT) -- a
    // fixed region regardless of the current module count, so a
    // newly-docked module never leaves a stale un-erased gap above it.
    clear(disp) {
        if (this.last_x != nil) {
            disp.blit_sprite(this.blank, this.last_x, this.last_y - STACK_HEIGHT, this.erase_ink, this.erase_paper)
        }
    }

    // Draws the module stack from the pad up (bottom always present,
    // middle/top as modules is collected), then the thruster flame
    // while taking off/landing. Sprite pixels for every tile are
    // blitted FIRST (in one pass), then colour banding (row_ink()
    // above) is applied in a SEPARATE pass across every attribute row
    // the whole stack spans -- not interleaved per tile, because
    // adjacent tiles' own attribute footprints overlap by one row
    // (ROCKET_PAD_Y isn't 8-aligned, see row_ink()'s own comment), so
    // a later tile's plain-white blit_sprite call would otherwise stomp
    // an earlier tile's already-correct override at the shared row.
    draw(disp, lib) {
        var white = encode_rgba(255, 255, 255)
        var magenta = encode_rgba(255, 0, 255)
        var black = encode_rgba(0, 0, 0)

        this.colour_tick = this.colour_tick + 1
        var flash_on = int(this.colour_tick / FLASH_TICKS) % 2 == 0

        var cx = int(this.x / 8)
        var cy = int(this.y / 8)
        this.erase_ink = disp.get_ink(cx, cy)
        this.erase_paper = disp.get_paper(cx, cy)

        var col_x0 = int(this.x / CELL)
        var col_x1 = int((this.x + float(ROCKET_TILE) - 1.0) / CELL)

        // or_blit: the bottom tile's own transparent gaps (between the
        // landing struts) shouldn't punch through the pad platform
        // underneath -- see docs/plans/jetpac-port.md's history for the
        // bug this fixes. Requires platforms to already be freshly
        // redrawn earlier in this same tick's draw phase (see
        // game.lox's tick()). Blitted plain white here; the colouring
        // pass below repaints the real attribute colour right after.
        var tile_y = int(this.y) - ROCKET_TILE
        for (var i = 0; i < this.modules; i = i + 1) {
            disp.blit_sprite(lib.get(MODULE_SPRITES[i]), int(this.x), tile_y, white, black, false, true)
            tile_y = tile_y - ROCKET_TILE
        }

        if (this.modules > 0) {
            var cy_bottom = int((int(this.y) - 1) / CELL)
            var cy_top = int((int(this.y) - this.modules * ROCKET_TILE) / CELL)
            for (var row_cy = cy_top; row_cy <= cy_bottom; row_cy = row_cy + 1) {
                var ink = row_ink(this, row_cy * CELL, white, magenta, flash_on)
                for (var cxi = col_x0; cxi <= col_x1; cxi = cxi + 1) {
                    disp.set_attr(cxi, row_cy, ink, black)
                }
            }
        }

        if (this.update_func == state_taking_off or this.update_func == state_landing) {
            disp.blit_sprite(lib.get(FLAME_SPRITES[this.flame_frame]), int(this.x), int(this.y), encode_rgba(255, 0, 0), black, false, true)
        }

        this.last_x = int(this.x)
        this.last_y = int(this.y)
    }
}

func enter_on_pad(r) {
    r.update_func = state_on_pad
}

func enter_taking_off(r) {
    r.update_func = state_taking_off
}

func enter_landing(r) {
    r.update_func = state_landing
    r.y = float(ROCKET_LAUNCH_TOP_Y)
}

// On the pad: RocketUpdate ($66D0) polls, every tick, for BOTH a full
// tank AND Jetman actually touching the rocket (AlienCollision, see
// near_jetman() above) before launching -- reaching FUEL_PODS_NEEDED
// alone just starts the full-tank flash (row_ink()), it doesn't
// launch by itself. On a genuine touch, Jetman "is found and
// destroyed" (boards, vanishes -- not a death, no explosion/life lost)
// and the player is awarded a bonus life ($66f5: `inc (hl)` on the
// lives counter) before takeoff begins.
func state_on_pad(r, jetman, game) {
    if (!jetman.is_dead() and r.fuel >= FUEL_PODS_NEEDED and near_jetman(r, jetman)) {
        jetman.board()
        game.lives = game.lives + 1
        enter_taking_off(r)
    }
}

func animate_flame(r) {
    r.flame_tick = r.flame_tick + 1
    if (r.flame_tick >= FLAME_ANIM_TICKS) {
        r.flame_tick = 0
        r.flame_frame = (r.flame_frame + 1) % len(FLAME_SPRITES)
    }
}

// RocketTakeoff/RocketLanding ($6690/$66B4) both call SfxThrusters
// ($67B6) every tick while rising/falling -- this port's own thrust()
// cue (pitched by Y, retriggering once the previous clip finishes) was
// wrongly wired to Jetman's own jetpack instead (see jetman.lox's own
// fly_vertical() comment for that fix); this is its real ROM home.
func state_taking_off(r, jetman, game) {
    r.y = r.y - RISE_STEP
    r.sound.thrust(r.y)
    animate_flame(r)
    if (r.y <= ROCKET_LAUNCH_TOP_Y) {
        // Level cycling is out of scope -- loop back down for another
        // build/launch cycle instead of advancing a level. The real
        // ROM's own equivalent moment (LevelNew, $6083, reached the
        // instant the old rocket reaches the top) calls RocketReset
        // ($60A7) here, which re-seeds BOTH module Item slots, not just
        // the rocket's own modules/fuel counters -- without this, this
        // port's rocket_item/collectible_item stay permanently consumed
        // after their first delivery, and every later cycle comes back
        // down with only the base tile and no way to ever rebuild it.
        r.modules = 1
        r.fuel = 0
        item_module.init_module(game.rocket_item, "default_top_module", "rocket_u1_top", game.static_data)
        item_module.init_module(game.collectible_item, "default_middle_module", "rocket_u1_middle", game.static_data)
        enter_landing(r)
    }
}

func state_landing(r, jetman, game) {
    r.y = r.y + RISE_STEP
    r.sound.thrust(r.y)
    animate_flame(r)
    if (r.y >= ROCKET_PAD_Y) {
        r.y = float(ROCKET_PAD_Y)
        r.sound.stop_thrust()
        enter_on_pad(r)
        // Jetman boarded (state_on_pad, above) rather than dying, so
        // he respawns here instead of through Game's death/respawn
        // timer -- no life lost, matching the bonus he was awarded on
        // the way in.
        jetman.spawn(game.static_data)
    }
}
