from gfx import *
// Multi-zone (Larger-than-Life-style) cellular automaton: generalises Conway's 3x3
// neighbour count to two independently-thresholded radii -- a small INNER disc
// (overcrowding guard) and a wider OUTER annulus (birth/survival signal) -- compared as
// fill ratios, not raw counts, so they stay meaningful at any radius.
// ESC quits, SPACE reseeds. INNER_R/OUTER_R/BIRTH_*/SURVIVE_*/OVERCROWD are the whole
// rule -- edit the on-screen fields (click, type, ENTER) to retune it live.

import random
import colour
import math
import gui

const CELL_SIZE = 1
const BG_COLOUR = colour.BLACK
const ALIVE_COLOUR = vec4(90, 200, 255, 255)

// Shape counts scale with resolution to keep seed density constant --
// a fixed count (as game_of_life.lox uses) starves at a larger
// cols x rows. Lines/boxes are ~1D, so covered area grows linearly with
// resolution and their count scales with sqrt(cols*rows); blocks are
// filled rects whose area already grows quadratically, so their count
// stays constant. REF_* is the density tuned to sustain the automaton;
// MAX_* bounds worst-case seeding time.
const REF_CELLS = 3600.0
const REF_L = 60.0  // sqrt(REF_CELLS) -- the linear scale REF_LINES/REF_BOXES were tuned at
const REF_LINES = 40.0
const REF_BOXES = 15.0
const REF_BLOCKS = 10.0
const MAX_LINES = 400
const MAX_BOXES = 500
const MAX_BLOCKS = 100

// The rule. INNER_R/OUTER_R are sample radii in cells (OUTER_R must not
// exceed MAX_R in multi_zone_src below). BIRTH_LO/HI and SURVIVE_LO/HI
// are outer-ratio bands (0..1): birth for a dead cell, survive for a
// live one. OVERCROWD is an inner-ratio ceiling -- a live cell above it
// dies regardless of the outer ratio.
// var, not const -- the on-screen fields built below reassign these live.
var INNER_R = 4.0
var OUTER_R = 10.0
var BIRTH_LO = 0.28
var BIRTH_HI = 0.38
var SURVIVE_LO = 0.18
var SURVIVE_HI = 0.55
var OVERCROWD = 0.63

var win = window(1, 1)
win.init()
win.toggle_fullscreen()
win.set_target_fps(0)

var screen_w = int(win.get_screen_width())
var screen_h = int(win.get_screen_height())
var cols = screen_w / CELL_SIZE
var rows = screen_h / CELL_SIZE

var grid_scale = math.sqrt(float(cols * rows)) / REF_L
var NUM_LINES = int(math.min(REF_LINES * grid_scale, MAX_LINES))
var NUM_BOXES = int(math.min(REF_BOXES * grid_scale, MAX_BOXES))
var NUM_BLOCKS = int(math.min(REF_BLOCKS, MAX_BLOCKS))

// Ping-ponged simulation textures, same convention as game_of_life.lox:
// one pixel per cell, POINT filtering + REPEAT wrap for exact sampling
// and toroidal wraparound.
var grid_a = render_texture(cols, rows)
var grid_b = render_texture(cols, rows)
grid_a.get_texture().set_filter_mode(win.FILTER_POINT)
grid_a.get_texture().set_wrap_mode(win.WRAP_REPEAT)
grid_b.get_texture().set_filter_mode(win.FILTER_POINT)
grid_b.get_texture().set_wrap_mode(win.WRAP_REPEAT)

// Standard fullscreen-quad vertex shader, same as every other shader
// example in this codebase.
var vertex_shader_src = "
#version 330

in vec3 vertexPosition;
in vec2 vertexTexCoord;
in vec3 vertexNormal;
in vec4 vertexColor;

uniform mat4 mvp;

out vec2 fragTexCoord;
out vec4 fragColor;

void main()
{
    fragTexCoord = vertexTexCoord;
    fragColor = vertexColor;
    gl_Position = mvp * vec4(vertexPosition, 1.0);
}
"

// One nested loop over a fixed MAX_R window computes both zones in a
// single pass, bucketed by distance -- outer_r/inner_r stay runtime-
// tunable via the `if (d > outer_r) continue` cutoff even though the
// loop bound itself is the compile-time constant MAX_R.
var multi_zone_src = "
#version 330
in vec2 fragTexCoord;
out vec4 finalColor;

uniform sampler2D texture0;
uniform vec2 resolution;
uniform float inner_r;
uniform float outer_r;
uniform float birth_lo;
uniform float birth_hi;
uniform float survive_lo;
uniform float survive_hi;
uniform float overcrowd;

const int MAX_R = 14;

void main() {
    vec2 texel = 1.0 / resolution;
    float cur = texture(texture0, fragTexCoord).r;

    float inner_sum = 0.0;
    float inner_count = 0.0;
    float outer_sum = 0.0;
    float outer_count = 0.0;

    for (int dx = -MAX_R; dx <= MAX_R; dx++) {
        for (int dy = -MAX_R; dy <= MAX_R; dy++) {
            if (dx == 0 && dy == 0) { continue; }
            float d = length(vec2(float(dx), float(dy)));
            if (d > outer_r) { continue; }
            float v = texture(texture0, fragTexCoord + vec2(float(dx), float(dy)) * texel).r;
            if (d <= inner_r) {
                inner_sum += v;
                inner_count += 1.0;
            } else {
                outer_sum += v;
                outer_count += 1.0;
            }
        }
    }

    float inner_ratio = inner_sum / max(inner_count, 1.0);
    float outer_ratio = outer_sum / max(outer_count, 1.0);

    float next_state = 0.0;
    if (cur > 0.5) {
        if (outer_ratio >= survive_lo && outer_ratio <= survive_hi && inner_ratio <= overcrowd) {
            next_state = 1.0;
        }
    } else {
        if (outer_ratio >= birth_lo && outer_ratio <= birth_hi) {
            next_state = 1.0;
        }
    }
    finalColor = vec4(next_state, next_state, next_state, 1.0);
}
"

var multi_zone = shader()
multi_zone.load_from_memory(vertex_shader_src, multi_zone_src)
if (!multi_zone.is_valid()) {
    print("Failed to load multi-zone step shader")
}
// Locations are cached once (rather than re-queried by name) since the
// param panel below re-uploads whichever uniform changed on every submit.
var loc_inner_r = multi_zone.get_location("inner_r")
var loc_outer_r = multi_zone.get_location("outer_r")
var loc_birth_lo = multi_zone.get_location("birth_lo")
var loc_birth_hi = multi_zone.get_location("birth_hi")
var loc_survive_lo = multi_zone.get_location("survive_lo")
var loc_survive_hi = multi_zone.get_location("survive_hi")
var loc_overcrowd = multi_zone.get_location("overcrowd")

multi_zone.set_value_vec2(multi_zone.get_location("resolution"), vec2(cols, rows))
multi_zone.set_value_float(loc_inner_r, INNER_R)
multi_zone.set_value_float(loc_outer_r, OUTER_R)
multi_zone.set_value_float(loc_birth_lo, BIRTH_LO)
multi_zone.set_value_float(loc_birth_hi, BIRTH_HI)
multi_zone.set_value_float(loc_survive_lo, SURVIVE_LO)
multi_zone.set_value_float(loc_survive_hi, SURVIVE_HI)
multi_zone.set_value_float(loc_overcrowd, OVERCROWD)

// Interactive rule panel: one Label + Text_Input per rule constant.
// ENTER applies a field -- `apply` updates the Lox-side var (so
// seeding/HUD stay in sync) and re-uploads just that uniform. A parse
// failure is swallowed; the field keeps showing what was typed.
var param_screen = gui.Screen()
var param_fields = []

func add_param_field(y, label_text, initial, loc, apply) {
    param_screen.add(gui.Label(10, y, label_text, 16, colour.WHITE))
    var field = param_screen.add(gui.Text_Input(150, y - 2, 70, 20, format("%g", initial), true))
    field.on_submit = func (w, text) {
        try {
            var v = float(text)
            apply(v)
            multi_zone.set_value_float(loc, v)
        } except Exception as e {
        }
    }
    param_fields.append(field)
    return field
}

add_param_field(80, "inner_r", INNER_R, loc_inner_r, func (v) { INNER_R = v })
add_param_field(104, "outer_r", OUTER_R, loc_outer_r, func (v) { OUTER_R = v })
add_param_field(128, "birth_lo", BIRTH_LO, loc_birth_lo, func (v) { BIRTH_LO = v })
add_param_field(152, "birth_hi", BIRTH_HI, loc_birth_hi, func (v) { BIRTH_HI = v })
add_param_field(176, "survive_lo", SURVIVE_LO, loc_survive_lo, func (v) { SURVIVE_LO = v })
add_param_field(200, "survive_hi", SURVIVE_HI, loc_survive_hi, func (v) { SURVIVE_HI = v })
add_param_field(224, "overcrowd", OVERCROWD, loc_overcrowd, func (v) { OVERCROWD = v })

// Seeding (CPU-side, one-time): same shape-scattering as game_of_life.lox,
// but bulk-uploaded via draw_array_fast() instead of drawn pixel by pixel
// -- at thousands of shapes, per-pixel rt.pixel() calls would make
// startup take minutes. seed_arr is allocated once and reused per reseed.

var seed_arr = float_array(cols, rows)
const WHITE_PACKED = encode_rgba(255, 255, 255)

func set_wrapped_val(arr, x, y) {
    var wx = ((x % cols) + cols) % cols
    var wy = ((y % rows) + rows) % rows
    arr.set(wx, wy, WHITE_PACKED)
}

func draw_random_line(arr) {
    var x0 = random.integer(0, cols - 1)
    var y0 = random.integer(0, rows - 1)
    var length = random.integer(cols / 8, cols / 2)
    var kind = random.integer(0, 2)
    var dx = 0
    var dy = 0
    if (kind == 0) {
        dx = 1
    } else if (kind == 1) {
        dy = 1
    } else {
        dx = 1
        dy = random.integer(0, 1) * 2 - 1
    }
    for (var i = 0; i < length; i = i + 1) {
        set_wrapped_val(arr, x0 + dx * i, y0 + dy * i)
    }
}

func draw_random_box(arr) {
    var x0 = random.integer(0, cols - 1)
    var y0 = random.integer(0, rows - 1)
    var w = random.integer(cols / 12, cols / 4)
    var h = random.integer(rows / 12, rows / 4)
    for (var i = 0; i < w; i = i + 1) {
        set_wrapped_val(arr, x0 + i, y0)
        set_wrapped_val(arr, x0 + i, y0 + h - 1)
    }
    for (var j = 0; j < h; j = j + 1) {
        set_wrapped_val(arr, x0, y0 + j)
        set_wrapped_val(arr, x0 + w - 1, y0 + j)
    }
}

func draw_random_block(arr) {
    var x0 = random.integer(0, cols - 1)
    var y0 = random.integer(0, rows - 1)
    var w = random.integer(cols / 20, cols / 6)
    var h = random.integer(rows / 20, rows / 6)
    for (var j = 0; j < h; j = j + 1) {
        for (var i = 0; i < w; i = i + 1) {
            set_wrapped_val(arr, x0 + i, y0 + j)
        }
    }
}

func randomise(rt) {
    seed_arr.clear(0.0)
    for (var i = 0; i < NUM_LINES; i = i + 1) {
        draw_random_line(seed_arr)
    }
    for (var i = 0; i < NUM_BOXES; i = i + 1) {
        draw_random_box(seed_arr)
    }
    for (var i = 0; i < NUM_BLOCKS; i = i + 1) {
        draw_random_block(seed_arr)
    }
    rt.draw_array_fast(seed_arr)
}

randomise(grid_a)

var current = grid_a
var next_tex = grid_b
var generation = 0

while (!win.should_close()) {
    if (win.key_pressed(win.KEY_ESCAPE)) {
        break
    }

    param_screen.update(win)
    for (var i = 0; i < len(param_fields); i = i + 1) {
        var field = param_fields[i]
        field.handle_keys(win, param_screen.focused == field)
    }

    // Gated on no field being focused, so SPACE reaches a field's text
    // (were it ever needed) instead of also reseeding behind the user's
    // back while they're mid-edit.
    if (win.key_pressed(win.KEY_SPACE) and param_screen.focused == nil) {
        randomise(current)
        generation = 0
    }

    // Negative source height: draw_texture_pro doesn't auto-flip a
    // render_texture's bottom-up storage -- without it this mirrors the
    // grid every generation (see game_of_life.lox's own note on this).
    win.begin_texture_mode(next_tex)
    win.begin_shader_mode(multi_zone)
    win.draw_texture_pro(current, 0, 0, cols, -rows, 0, 0, cols, rows, 0, 0, 0, colour.WHITE)
    win.end_shader_mode()
    win.end_texture_mode()

    var tmp = current
    current = next_tex
    next_tex = tmp
    generation = generation + 1

    win.begin()
    win.clear(BG_COLOUR)
    win.draw_texture_pro(current, 0, 0, cols, -rows, 0, 0, screen_w, screen_h, 0, 0, 0, ALIVE_COLOUR)
    win.text(format("Multi-zone CA -- Generation %d", generation), 10, 10, 20, colour.WHITE)
    win.text(format("%d x %d cells, %dpx, inner_r=%g outer_r=%g", cols, rows, CELL_SIZE, INNER_R, OUTER_R), 10, 34, 16, vec4(180, 180, 180, 255))
    win.text("SPACE: reseed", 10, 54, 16, vec4(180, 180, 180, 255))
    param_screen.draw(win)
    win.end()
}
win.close()
