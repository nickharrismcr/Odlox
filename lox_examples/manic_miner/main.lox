from gfx import *
import display
import colour
import game
import sys

//
// @file main.lox
// @brief Willy, playable: LEFT/RIGHT to walk, UP or SPACE to jump.
// Drives a game.Game -- cavern/item/conveyor/guardian rendering, Willy's
// movement/collision/death, and the running/die/game_over session state
// all live there. This is just the window and presentation loop. ESC quits.
//
// Usage: odlox.exe main.lox [cavern_index]
//

var argv = sys.args()
var index = 2
if (len(argv) >= 2) {
    index = int(argv[1])
}

const TARGET_FPS = 15   // Manic Miner's own tick rate -- see game_sprite.lox

const SCALE = 3
var win = window(display.SCREEN_W * SCALE, display.SCREEN_H * SCALE)
win.init()
win.set_target_fps(TARGET_FPS)

// Game.__init__ creates the Display (and its GPU render texture), which
// needs win.init()'s GL context to already exist.
var g = game.Game(index,TARGET_FPS)
g.disp.upload()

 
while (!win.should_close()) {
    if (win.key_pressed(win.KEY_ESCAPE)) {
        break
    }
    if (g.is_game_over()) {
        break
    }

  

    g.tick(win)
    g.disp.upload()

    win.begin()
    win.clear(colour.BLACK)
    g.disp.draw(win, 0, 0, display.SCREEN_W * SCALE, display.SCREEN_H * SCALE)
    win.text(g.cavern.name, 10, display.SCREEN_H * SCALE - 30, 20, colour.WHITE)
    win.text(format("air: %d  lives: %d", g.willy.air_remaining, g.lives), 10, display.SCREEN_H * SCALE - 55, 16, colour.WHITE)
    win.end()
}
win.close()
