// Correctness stress test for the bytecode cache (see
// docs/plans/bytecode-cache.md), modeled on pool_reuse_stress.lox's own
// discipline: a cache's real failure mode is silent corruption, not a
// crash, so every value is checked by exact comparison, not just
// "doesn't crash." The pytest driver runs this script twice back to
// back -- once with no cache present (cold, compiles bc_cache_module.lox
// from source) and once immediately after (warm, hits the .lxc the
// first run wrote) -- and asserts byte-identical output both times, on
// top of this script's own internal fails counter being zero either way.

import bc_cache_module

var fails = 0

var b1 = bc_cache_module.make_bumper(3)
var r1 = b1()
var r2 = b1()
var r3 = b1()
if (r1 != 1000000003 or r2 != 1000000006 or r3 != 1000000009) {
	fails = fails + 1
}

var nums = bc_cache_module.big_ints()
if (nums[0] != 2147483647 or nums[1] != 2147483648 or nums[2] != 4294967296 or nums[3] != -2147483648) {
	fails = fails + 1
}

if (bc_cache_module.pi_ish() != 3.14159265) {
	fails = fails + 1
}

var g = bc_cache_module.greeting("cache")
if (g != "hello, cache") {
	fails = fails + 1
}

var adder = bc_cache_module.Adder()
var s1 = adder.add(5)
var s2 = adder.add(10)
var s3 = adder.add(-3)
if (s1 != 5 or s2 != 15 or s3 != 12) {
	fails = fails + 1
}

print fails
print "bc_cache_roundtrip_stress complete"
