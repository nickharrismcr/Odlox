from gfx import *
// Minimal level editor built on gui.lox: a palette sidebar of tile
// Buttons, and a canvas where clicking places a Draggable tile using
// whichever palette entry is currently selected. Every tile texture is
// generated procedurally (a coloured square with a contrasting dot) via
// render_texture, so the demo needs no external image asset.
//
// Left-click a palette tile to select it (it stays visually "pressed").
// Left-click empty canvas to place a copy of the selected tile there,
// snapped to a TILE_SIZE grid. Drag a placed tile to move it. Right-click
// a placed tile to delete it. ESC to quit.
import gui
import colour

const TARGET_FPS = 60
const TILE_SIZE = 48
const PALETTE_X = 10
const PALETTE_GAP = 8
const CANVAS_X = 100 // left edge of the placeable canvas, right of the palette sidebar

var win = window(900, 600)
win.init()
win.set_target_fps(TARGET_FPS)

func make_tile_texture(base_colour, mark_colour) {
    var rt = render_texture(TILE_SIZE, TILE_SIZE)
    rt.clear(base_colour)
    rt.circle_fill(TILE_SIZE / 2, TILE_SIZE / 2, TILE_SIZE / 4, mark_colour)
    return rt.get_texture()
}

var tile_textures = [
    make_tile_texture(colour.DARKGREEN, colour.LIME),
    make_tile_texture(colour.DARKGRAY, colour.LIGHTGRAY),
    make_tile_texture(colour.MAROON, colour.RED),
]

var screen = gui.Screen()
var palette = []
var current_tile = tile_textures[0]

// select_tile marks palette entry `index` selected (drawn pressed) and
// clears every other entry's selection.
func select_tile(index) {
    current_tile = tile_textures[index]
    for (var i = 0; i < len(palette); i = i + 1) {
        palette[i].pressed = i == index
    }
}

for (var i = 0; i < len(tile_textures); i = i + 1) {
    // `i` is the for-loop's own control variable -- one shared slot across
    // every iteration, not a fresh binding per iteration -- so a closure
    // capturing `i` directly would see its final value (3) on every click,
    // not the index it was created with. `index` is a plain local declared
    // inside the loop body instead, which does get a fresh slot each time
    // round (same pattern as tests/new_tests/lox/closure_list.lox).
    var index = i
    var x = PALETTE_X
    var y = PALETTE_X + i * (TILE_SIZE + PALETTE_GAP)
    var b = screen.add(gui.Button(x, y, TILE_SIZE, TILE_SIZE, tile_textures[i]))
    b.on_left_click = func (w, pos) { select_tile(index) }
    palette.append(b)
}
select_tile(0)

// place_tile drops a new Draggable copy of the currently-selected tile at
// `pos`, snapped to the tile grid, and wires up its own delete-on-right-
// click handler.
func place_tile(pos) {
    var gx = int(pos.x / TILE_SIZE) * TILE_SIZE
    var gy = int(pos.y / TILE_SIZE) * TILE_SIZE
    var placed = screen.add(gui.Draggable(gx, gy, TILE_SIZE, TILE_SIZE, current_tile))
    placed.on_right_click = func (w, pos2) { screen.remove(placed) }
}

while (!win.should_close()) {
    if (win.key_pressed(win.KEY_ESCAPE)) {
        break
    }

    screen.update(win)

    if (!screen.click_consumed and win.mouse_pressed(win.MOUSE_LEFT)) {
        var pos = win.mouse_position()
        if (pos.x >= CANVAS_X) {
            place_tile(pos)
        }
    }

    win.begin()
    win.clear(colour.BLACK)
    win.line(CANVAS_X, 0, CANVAS_X, win.get_screen_height(), colour.GRAY)
    screen.draw(win)
    win.text(
        "Click a palette tile, then click the canvas to place it. Drag placed tiles. Right-click deletes. ESC quits.",
        CANVAS_X + 10, win.get_screen_height() - 30, 16, colour.WHITE
    )
    win.end()
}
win.close()
