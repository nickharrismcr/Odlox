from gfx import *
import display
import assets
import platform as platform_module
import jetman as jetman_module
import jetman_controller
import rocket as rocket_module
import item as item_module
import alien as alien_module
import laser as laser_module
import explosion as explosion_module
import spawner as spawner_module
import hud
import json

// @file game.lox
// @brief Owns one Jetpac play session: platforms/Jetman/Rocket/items/
// aliens/lasers/explosions, ticked each frame via a clear/move/draw
// phase order (see tick()). sound (a game_sound.Sound -- not nil:
// Jetman.spawn() below fires a cue immediately) is threaded through
// every actor constructor that fires one -- see
// docs/plans/jetpac-port.md Part 5.
//
// Item spawning: the skool has exactly two item RAM slots ($5D38,
// $5D40), each doing double duty -- a rocket module at level start,
// then (once that module is delivered) an ongoing fuel-pod/collectible
// slot respectively -- so there are exactly two Item instances here,
// both pre-seeded with a module below (see item.lox's init_module()).
// spawner.lox owns the timer that gates fuel-pod/collectible/alien
// spawning after that. The alien pool (6) and explosion pool (4) are
// allocated once here and reused, per the root CLAUDE.md's per-frame
// allocation discipline.

const ALIEN_COUNT = 6
const EXPLOSION_COUNT = 4
const LIVES_START = 3
const DEATH_TICKS = 30  // ticks Jetman's own death explosion plays before respawn

// Scoring isn't displayed until hud.lox lands; kept minimal here so
// item.lox/alien.lox have somewhere to report points.
class Score {
    __init__() {
        this.total = 0
    }

    add(points) {
        this.total = this.total + points
    }
}

class Game {
    __init__(sound) {
        this.sound = sound
        this.disp = display.Display()
        this.disp.clear(encode_rgba(0, 0, 0), encode_rgba(0, 0, 0))

        this.lib = assets.SpriteAssets()
        this.lib.load("assets/jetpac_sprites.json")

        this.font = assets.SpriteAssets()
        this.font.load("assets/font_sprites.json")

        this.static_data = json.load("data/jetpac_static.json")

        this.platforms = platform_module.Platforms(this.static_data)

        this.rocket = rocket_module.Rocket(this.static_data, this.sound)

        this.jetman = jetman_module.Jetman(this.sound)
        this.jetman.spawn(this.static_data)

        this.controller = jetman_controller.Controller()
        this.score = Score()

        // Both rocket modules are pre-seeded active here, matching
        // RocketReset's own one-time copy into $5D38/$5D40 -- see
        // item.lox's init_module() header. rocket_item's slot doubles
        // as the fuel-pod slot once its module is delivered;
        // collectible_item's doubles as the collectible slot once its is.
        this.rocket_item = item_module.Item(this.sound)
        item_module.init_module(this.rocket_item, "default_top_module", "rocket_u1_top", this.static_data)
        this.collectible_item = item_module.Item(this.sound)
        item_module.init_module(this.collectible_item, "default_middle_module", "rocket_u1_middle", this.static_data)

        this.aliens = []
        for (var i = 0; i < ALIEN_COUNT; i = i + 1) {
            this.aliens.append(alien_module.Alien(this.sound))
        }

        this.explosions = []
        for (var i = 0; i < EXPLOSION_COUNT; i = i + 1) {
            this.explosions.append(explosion_module.Explosion())
        }

        this.lasers = laser_module.LaserPool()
        this.spawner = spawner_module.Spawner()

        this.lives = LIVES_START
        this.die_tick = -1  // -1: not dying

        hud.draw_static(this)
    }

    // Finds an inactive explosion slot and starts it at (x, y) --
    // silently drops the explosion if all EXPLOSION_COUNT slots are
    // busy, which in practice never happens at this scale.
    spawn_explosion(x, y) {
        foreach (var e in this.explosions) {
            if (!e.is_active()) {
                e.spawn(x, y)
                return
            }
        }
    }

    is_game_over() -> bool {
        return this.lives <= 0 and this.die_tick == -1
    }

    is_done() -> bool {
        return this.is_game_over()
    }

    tick(win) {
        this.sound.update()
        this.controller.update(win)

        this.jetman.clear(this.disp)
        this.rocket.clear(this.disp)
        this.rocket_item.clear(this.disp)
        this.collectible_item.clear(this.disp)
        foreach (var a in this.aliens) {
            a.clear(this.disp)
        }
        this.lasers.clear(this.disp)
        foreach (var e in this.explosions) {
            e.clear(this.disp)
        }

        if (!this.jetman.is_hidden()) {
            this.jetman.step(this.controller, this.platforms)
            if (this.controller.fire) {
                this.lasers.fire(this.jetman)
                this.sound.laser()
            }
            if (this.jetman.launched_this_tick) {
                this.spawn_explosion(this.jetman.x, this.jetman.y)
            }
        }
        this.rocket.step(this.jetman, this)
        this.rocket_item.step(this.jetman, this.rocket, this.platforms, this.score)
        this.collectible_item.step(this.jetman, this.rocket, this.platforms, this.score)
        foreach (var a in this.aliens) {
            a.step(this.jetman, this.platforms, this.lasers, this.score, this)
        }
        this.lasers.update(this.platforms)
        foreach (var e in this.explosions) {
            e.step()
        }
        this.spawner.tick(this)
        step_death(this)

        // Redrawn every tick, first -- any sprite that overlapped a
        // platform since the last redraw (Display.blit_sprite force-
        // overwrites, no alpha) gets covered back over here before this
        // tick's own sprites draw on top (with or_blit, for the ones
        // that intentionally rest on a platform).
        this.platforms.draw(this.disp, this.lib)

        this.rocket.draw(this.disp, this.lib)
        if (this.rocket_item.is_active()) {
            this.rocket_item.draw(this.disp, this.lib)
        }
        if (this.collectible_item.is_active()) {
            this.collectible_item.draw(this.disp, this.lib)
        }
        foreach (var a in this.aliens) {
            if (a.is_active()) {
                a.draw(this.disp, this.lib)
            }
        }
        this.lasers.draw(this.disp)
        foreach (var e in this.explosions) {
            if (e.is_active()) {
                e.draw(this.disp, this.lib)
            }
        }
        if (!this.jetman.is_hidden()) {
            this.jetman.draw(this.disp, this.lib)
        }
        hud.draw(this)
    }
}

// Jetman's own death: fires the explosion once (die_tick edge from
// -1), waits DEATH_TICKS, then respawns him (or ends the session once
// lives run out) -- alien.lox's Alien.step() takes `g` as its
// "explosions" argument (see spawn_explosion() above) purely so it can
// call this on a kill; it never reads any other Game field.
func step_death(g) {
    if (!g.jetman.is_dead()) {
        return
    }
    if (g.die_tick == -1) {
        g.spawn_explosion(g.jetman.x, g.jetman.y)
        g.lives = g.lives - 1
        g.die_tick = 0
        return
    }
    g.die_tick = g.die_tick + 1
    if (g.die_tick < DEATH_TICKS) {
        return
    }
    g.die_tick = -1
    if (g.lives > 0) {
        g.jetman.spawn(g.static_data)
    }
}
