from gfx import *
import display
import colour
import assets
import cavern
import sys

//
// @file test_cavern_display.lox
// @brief Renders one extracted cavern (real tile graphics/colours, not
// ASCII) via Display + Cavern.draw(), plus its items twinkling via
// Cavern.draw_items(). ESC quits.
//
// Usage: odlox.exe test_cavern_display.lox [cavern_index]
//

var argv = sys.args()
var index = 0
if (len(argv) >= 2) {
    index = int(argv[1])
}

var lib = assets.SpriteAssets()
lib.load(format("caverns/cavern_%d_sprites.json", index))

var c = cavern.Cavern()
c.load(format("caverns/cavern_%d.json", index))

const SCALE = 3
var win = window(display.SCREEN_W * SCALE, display.SCREEN_H * SCALE)
win.init()
win.set_target_fps(8)   // Manic Miner's own tick rate -- see game_sprite.lox

var disp = display.Display()
disp.clear(encode_rgba(0, 0, 0), encode_rgba(0, 0, 0))
c.draw(disp, lib)
disp.upload()

var tick = 0
while (!win.should_close()) {
    if (win.key_pressed(win.KEY_ESCAPE)) {
        break
    }

    c.draw_items(disp, lib, tick)
    tick = tick + 1
    disp.upload()

    win.begin()
    win.clear(colour.BLACK)
    disp.draw(win, 0, 0, display.SCREEN_W * SCALE, display.SCREEN_H * SCALE)
    win.text(c.name, 10, display.SCREEN_H * SCALE - 30, 20, colour.WHITE)
    win.end()
}
win.close()
