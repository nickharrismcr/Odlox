from gfx import *
import item as item_module
import alien as alien_module
import spectrum_attr

// @file spawner.lox
// @brief The ROM's NewActor ($6971): advances a timer and gates
// module/fuel-pod, collectible, and alien spawns. Module/fuel-pod and
// collectible gate conditions live in item.lox (spawn_module/
// spawn_fuel_pod/spawn_collectible); this file just calls them on the
// ROM's own cadence -- new_fuel_pod every (255-timer)%16==0 tick,
// new_collectible every timer%128==0 tick -- and owns alien spawning
// itself, since alien.lox has no equivalent gate function of its own
// (level 1 has only meteors, spawned here directly).

const ALIEN_SPAWN_TICKS = 96  // no ROM equivalent cadence for meteors specifically; tuned for this port
const METEOR_Y_SPEED = 0.25   // tuned: half the original 0.5
const METEOR_X_SPEED_MIN = 0.6  // tuned: double the original 0.3-0.7 range
const METEOR_X_SPEED_MAX = 1.4

// NewActor's own alien colour: "$02..$05 from the slot index" -- plain
// small ink-index bytes, same convention gfx_params_platforms' own attr
// field uses (paper black, not bright), not a full bright attribute.
const ALIEN_COLOUR_BASE = 2
const ALIEN_COLOUR_COUNT = 4

func alien_colour(slot) {
    var d = spectrum_attr.decode_attribute(ALIEN_COLOUR_BASE + slot % ALIEN_COLOUR_COUNT)
    return spectrum_attr.colour_to_rgba(d["ink"], d["bright"])
}

class Spawner {
    __init__() {
        this.timer = 0
    }

    tick(g) {
        this.timer = (this.timer + 1) % 256

        if (!g.rocket_item.is_active()) {
            var spawned_module = item_module.spawn_module(g.rocket_item, g.jetman, g.rocket, g.static_data)
            if (!spawned_module and (255 - this.timer) % 16 == 0) {
                item_module.spawn_fuel_pod(g.rocket_item, g.jetman, g.rocket, g.static_data)
            }
        }

        if (!g.collectible_item.is_active() and this.timer % 128 == 0) {
            item_module.spawn_collectible(g.collectible_item, g.jetman, g.static_data)
        }

        if (this.timer % ALIEN_SPAWN_TICKS == 0) {
            spawn_alien_if_free(g)
        }
    }
}

const METEOR_SPAWN_Y_MIN = 32.0   // matches alien.lox's own vertical bounce range
const METEOR_SPAWN_Y_MAX = 192.0

// A free alien slot gets a meteor entering from the left edge
// (travelling right) or the right edge (travelling left), at a random
// height, coloured by its own pool slot index.
func spawn_alien_if_free(g) {
    for (var i = 0; i < len(g.aliens); i = i + 1) {
        var a = g.aliens[i]
        if (!a.is_active()) {
            var vx = METEOR_X_SPEED_MIN + rand() * (METEOR_X_SPEED_MAX - METEOR_X_SPEED_MIN)
            var x = 0.0
            if (rand() < 0.5) {
                x = 255.0
                vx = -vx
            }
            var y = METEOR_SPAWN_Y_MIN + rand() * (METEOR_SPAWN_Y_MAX - METEOR_SPAWN_Y_MIN)
            alien_module.spawn_meteor(a, x, y, vx, METEOR_Y_SPEED, alien_colour(i))
            return
        }
    }
}
