from gfx import *
import spectrum_attr
import jetman as jetman_module

// @file laser.lox
// @brief LaserPool: 4 preallocated beam slots. A beam is a **rigid
// 3-zone ensemble** -- a solid leading tip, then a zone of 4 short
// dashes with short gaps, then a trailing zone of 4 very short dashes
// ("dots") with longer gaps -- all one colour, fixed in position
// relative to each other, translating together as one fixed-size unit
// away from Jetman:
//
//     . . . .  - - - -  ----   ->
//   (trailing)         (leading, direction of travel)
//
// Per the user's own description of how this should look: the bolt is
// a single fixed-size object that's initially partly hidden and
// reveals more of itself as it travels, fully visible only once it's
// moved its own full length (ENSEMBLE_LEN) from the gun -- draw()'s
// per-mark `traveled` clamp implements exactly that reveal. An earlier
// version also shrank the ensemble back from the tail once the front
// stopped (collision or its own random max-range countdown), meant as
// a port of LaserBeamAnimate's ($6FC5) trailing-pulse catch-up -- but
// visually that read as the whole shot "extending then retracting",
// which isn't how it should look, so that shrink is gone: the beam
// just disappears the instant its front stops advancing, no lingering
// retraction. (The front's own movement facts are still real ROM
// mechanics, not invented: fixed step per tick, freezes on collision
// or the random max-range countdown -- see FRONT_STEP/FRONT_RANGE_MIN/
// MAX below.)
//
// Colour is a fresh **random** pick from laser_beam_colours ($6FB2:
// $47/$43/$43/$45 -- white, magenta, magenta, cyan, all bright) every
// time a beam fires ($6FA4: `random & 3`), applied uniformly across the
// whole ensemble (all one colour, per the user's own description).

const MAX_BEAMS = 4
// $6fd8/$6fd9 confirms a fixed step every tick, but this port's own
// per-actor-per-tick update runs every actor every engine tick, unlike
// the ROM's single jump-table-entry-per-50Hz-interrupt scheduling (see
// main.lox's own TARGET_FPS comment for the same kind of deviation) --
// 8px/tick reads much faster here than it would on real hardware, so
// this is tuned down for feel rather than transcribed.
const FRONT_STEP = 4.0
const FRONT_RANGE_MIN = 132.0      // $6f9e: (random&$38)|$84, decoded to a plain distance cap
const FRONT_RANGE_MAX = 188.0

// Ensemble shape, distances measured backward from the leading tip
// (front_x), in the direction opposite travel. Each of the 3 zones is
// one character cell (CELL=8px) wide, four cells long -- CELL_LEN.
const CELL = 8.0
const CELL_LEN = 4.0 * CELL

const SOLID_LEN = CELL_LEN

const DASH_COUNT = 4
const DASH_GAP = 2.0
const DASH_LEN = (CELL_LEN - float(DASH_COUNT - 1) * DASH_GAP) / float(DASH_COUNT)
const DASH_ZONE_LEN = CELL_LEN

const DOT_COUNT = 4
const DOT_GAP = 8.0
const DOT_LEN = (CELL_LEN - float(DOT_COUNT - 1) * DOT_GAP) / float(DOT_COUNT)
const DOT_ZONE_LEN = CELL_LEN

const ENSEMBLE_LEN = SOLID_LEN + DASH_ZONE_LEN + DOT_ZONE_LEN

const PULSE_THICKNESS = 2
const BEAM_Y_OFFSET = 13.0  // LaserBeamDraw: aligned to the middle of Jetman's sprite

const SCREEN_W = 256
const SCREEN_H = 192

// Alien-hit test window, approximating $6e33-$6e53's own asymmetric
// arithmetic (wider ahead of the alien than behind) rather than
// reproducing it exactly.
const HIT_DX_AHEAD = 32.0
const HIT_DX_BEHIND = 8.0
const HIT_DY = 12.0

// laser_beam_colours' own 4 raw attribute bytes, decoded once.
const COLOUR_ATTRS = [71, 67, 67, 69]

func beam_colours() {
    var out = []
    foreach (var attr in COLOUR_ATTRS) {
        var d = spectrum_attr.decode_attribute(attr)
        out.append(spectrum_attr.colour_to_rgba(d["ink"], d["bright"]))
    }
    return out
}

var BEAM_COLOURS = beam_colours()

// Every mark in the ensemble, as [near, far) distance-from-front pairs
// (near < far), built once. Order doesn't matter for drawing.
func build_marks() {
    var marks = []
    marks.append([0.0, SOLID_LEN])
    var off = SOLID_LEN
    for (var i = 0; i < DASH_COUNT; i = i + 1) {
        marks.append([off, off + DASH_LEN])
        off = off + DASH_LEN + DASH_GAP
    }
    off = SOLID_LEN + DASH_ZONE_LEN
    for (var i = 0; i < DOT_COUNT; i = i + 1) {
        marks.append([off, off + DOT_LEN])
        off = off + DOT_LEN + DOT_GAP
    }
    return marks
}

var MARKS = build_marks()

func rand_range(lo, hi) {
    return lo + rand() * (hi - lo)
}

// Display.plot()/set_attr() don't bounds-check (unlike blit_sprite,
// which clips its own loop), so every plot here needs its own guard.
func plot_clamped(disp, x, y, v) {
    if (x >= 0 and x < SCREEN_W and y >= 0 and y < SCREEN_H) {
        disp.plot(x, y, v)
    }
}

func new_beam() {
    return {
        "active": false,
        "y": 0.0,
        "dir": 1,
        "front_x": 0.0,
        "traveled": 0.0,
        "max_range": 0.0,
        "colour": encode_rgba(255, 255, 255),
        "last_lo": nil,       // erase bookkeeping: the drawn span's own last [lo, hi) bounds
        "last_hi": nil,
        "last_y": nil
    }
}

class LaserPool {
    __init__() {
        this.beams = []
        for (var i = 0; i < MAX_BEAMS; i = i + 1) {
            this.beams.append(new_beam())
        }
    }

    // Fires from Jetman's gun (LaserNewIfFreeSlot: only if a slot is
    // free -- no queueing). Jetman never mirrors his own sprite (he
    // uses separate left/right art, see jetman.lox's own
    // current_sprite_name()) -- this.x is always his sprite's LEFT
    // edge, regardless of facing. That's his gun position when facing
    // left, but his BACK when facing right, so a beam fired while
    // facing right needs to originate from the RIGHT edge (this.x +
    // the current sprite's own width) or it starts from behind him --
    // a real, playtested bug (confirmed against LaserBeamInit/
    // LaserBeamShootRight, $6F70/$6FB6, whose own C register ends up
    // well to the right of Jetman's base X when facing right, and only
    // slightly left of it when facing left).
    fire(jetman, lib) {
        for (var i = 0; i < MAX_BEAMS; i = i + 1) {
            var b = this.beams[i]
            if (!b["active"]) {
                b["active"] = true
                b["y"] = jetman.y - BEAM_Y_OFFSET
                b["dir"] = 1
                var gun_x = jetman.x
                if (jetman.facing_left) {
                    b["dir"] = -1
                } else {
                    var name = jetman_module.current_sprite_name(jetman)
                    gun_x = jetman.x + float(lib.get(name).width())
                }
                b["front_x"] = gun_x
                b["traveled"] = 0.0
                b["max_range"] = rand_range(FRONT_RANGE_MIN, FRONT_RANGE_MAX)
                b["colour"] = BEAM_COLOURS[int(rand() * len(BEAM_COLOURS))]
                b["last_lo"] = nil
                b["last_hi"] = nil
                return
            }
        }
    }

    clear(disp) {
        foreach (var b in this.beams) {
            if (b["last_lo"] == nil) {
                continue
            }
            for (var x = b["last_lo"]; x < b["last_hi"]; x = x + 1) {
                for (var t = 0; t < PULSE_THICKNESS; t = t + 1) {
                    plot_clamped(disp, x, b["last_y"] + t, 0.0)
                }
            }
        }
    }

    // Advances the front a fixed step, deactivating the beam outright
    // (no lingering retraction, see the file header) the instant it
    // hits something, leaves the screen, or its own random max-range
    // countdown runs out.
    update(platforms) {
        foreach (var b in this.beams) {
            if (!b["active"]) {
                continue
            }
            var next_x = b["front_x"] + FRONT_STEP * float(b["dir"])
            if (next_x < 0.0 or next_x > float(SCREEN_W)) {
                b["active"] = false
                continue
            }
            if (platforms.blocks_point(int(next_x), int(b["y"]))) {
                b["active"] = false
                continue
            }
            b["front_x"] = next_x
            b["traveled"] = b["traveled"] + FRONT_STEP
            if (b["traveled"] >= b["max_range"]) {
                b["active"] = false
            }
        }
    }

    draw(disp) {
        foreach (var b in this.beams) {
            if (!b["active"]) {
                continue
            }
            var y0 = int(b["y"])
            var min_drawn = nil
            var max_drawn = nil

            foreach (var m in MARKS) {
                var near = m[0]
                var far = m[1]
                // A mark only becomes visible once the front has
                // actually travelled far enough to have revealed it --
                // without this cap, firing painted the WHOLE 96px
                // ensemble immediately, so the trailing dot zone showed
                // up several cells behind Jetman's gun on the very
                // first frame instead of growing out from it.
                if (near >= b["traveled"]) {
                    continue
                }
                if (far > b["traveled"]) {
                    far = b["traveled"]
                }
                var x1 = b["front_x"] - float(b["dir"]) * near
                var x2 = b["front_x"] - float(b["dir"]) * far
                var x_lo = x1
                var x_hi = x2
                if (x_lo > x_hi) {
                    var tmp = x_lo
                    x_lo = x_hi
                    x_hi = tmp
                }
                var xi0 = int(x_lo)
                var xi1 = int(x_hi)
                if (xi1 <= xi0) {
                    xi1 = xi0 + 1
                }
                for (var px = xi0; px < xi1; px = px + 1) {
                    for (var t = 0; t < PULSE_THICKNESS; t = t + 1) {
                        plot_clamped(disp, px, y0 + t, 1.0)
                    }
                }
                if (min_drawn == nil or xi0 < min_drawn) { min_drawn = xi0 }
                if (max_drawn == nil or xi1 > max_drawn) { max_drawn = xi1 }
            }

            if (min_drawn != nil) {
                var black = encode_rgba(0, 0, 0)
                var cx0 = int(min_drawn / 8)
                var cx1 = int((max_drawn - 1) / 8)
                var cy = int(y0 / 8)
                for (var cxi = cx0; cxi <= cx1; cxi = cxi + 1) {
                    if (cxi >= 0 and cxi < SCREEN_W / 8 and cy >= 0 and cy < SCREEN_H / 8) {
                        disp.set_attr(cxi, cy, b["colour"], black)
                    }
                }
            }

            b["last_lo"] = min_drawn
            b["last_hi"] = max_drawn
            b["last_y"] = y0
        }
    }

    // Consumes and returns true for the first active beam whose front
    // (tip) is within the asymmetric hit window of (x, y).
    check_hit(x, y) -> bool {
        foreach (var b in this.beams) {
            if (!b["active"]) {
                continue
            }
            var dx = b["front_x"] - x
            var dy = b["y"] - y
            if (dy < 0.0) { dy = -dy }
            var x_ok = false
            if (dx >= 0.0 and dx < HIT_DX_AHEAD) {
                x_ok = true
            } else if (dx < 0.0 and -dx < HIT_DX_BEHIND) {
                x_ok = true
            }
            if (x_ok and dy < HIT_DY) {
                b["active"] = false
                return true
            }
        }
        return false
    }
}
