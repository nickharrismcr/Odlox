// @file spectrum_screen.lox
// @brief Converts ZX Spectrum screen/attribute memory addresses to pixel
// (x, y) coordinates: attr_addr_to_xy() for the plain attribute grid,
// pixel_addr_to_xy() for the real hardware's bit-interleaved bitmap layout.

// Attribute-style: addr indexes a plain 32-wide row-major grid starting
// at base. Returns the pixel (x, y) of that 8x8 cell's top-left corner.
func attr_addr_to_xy(addr, base) {
    var offset = addr - base
    var col = offset % 32
    var row = int(offset / 32)
    return {"x": col * 8, "y": row * 8}
}

// addr indexes a buffer laid out like the real Spectrum display file,
// relocated to base. Bits MSB to LSB: Y7 Y6 Y2 Y1 Y0 Y5 Y4 Y3 X4 X3 X2 X1 X0
// -- decoded via integer division/modulo (no bitwise ops in this dialect).
// Byte-addressed: x lands on an 8px boundary; y is a true pixel row.
func pixel_addr_to_xy(addr, base) {
    var offset = addr - base
    var x_byte = offset % 32
    var shifted = int(offset / 32)          // 8 bits: Y7 Y6 Y2 Y1 Y0 Y5 Y4 Y3
    var char_row = shifted % 8              // Y5 Y4 Y3 -- character row within third (0-7)
    var pixel_line = int(shifted / 8) % 8   // Y2 Y1 Y0 -- pixel line within character row (0-7)
    var third = int(shifted / 64)           // Y7 Y6 -- which third of the screen (0-2)
    var y = third * 64 + char_row * 8 + pixel_line
    return {"x": x_byte * 8, "y": y}
}
