from gfx import *
import display
import assets
import platform as platform_module
import jetman as jetman_module
import jetman_controller
import json

// @file game.lox
// @brief Owns one Jetpac play session: platforms/Jetman/controller,
// ticked each frame via a clear/move/draw phase order (see
// state_running). The rocket is still a fixed 3-tile stub blit --
// rocket.lox (a later build step) replaces it with a real Rocket class
// that tracks modules/fuel. Items/aliens/lasers/HUD/audio land in
// later build steps too (see docs/plans/jetpac-port.md Part 5).

class Game {
    __init__(sound) {
        this.sound = sound
        this.disp = display.Display()
        this.disp.clear(encode_rgba(0, 0, 0), encode_rgba(0, 0, 0))

        this.lib = assets.SpriteAssets()
        this.lib.load("assets/jetpac_sprites.json")

        this.static_data = json.load("data/jetpac_static.json")

        this.platforms = platform_module.Platforms(this.static_data)
        this.platforms.draw(this.disp, this.lib)

        var white = encode_rgba(255, 255, 255)
        var black = encode_rgba(0, 0, 0)

        // Rocket tiles are 16x16; r["y"] is the pad/ground row (matches
        // ROCKET_PAD_Y), so bottom/middle/top stack upward from there.
        var r = this.static_data["default_rocket"]
        this.disp.blit_sprite(this.lib.get("rocket_u1_bottom"), r["x"], r["y"] - 16, white, black)
        this.disp.blit_sprite(this.lib.get("rocket_u1_middle"), r["x"], r["y"] - 32, white, black)
        this.disp.blit_sprite(this.lib.get("rocket_u1_top"), r["x"], r["y"] - 48, white, black)

        this.jetman = jetman_module.Jetman()
        this.jetman.spawn(this.static_data)

        this.controller = jetman_controller.Controller()
    }

    tick(win) {
        this.controller.update(win)

        this.jetman.clear(this.disp)
        this.jetman.step(this.controller, this.platforms)
        this.jetman.draw(this.disp, this.lib)
    }

    is_done() -> bool {
        return false
    }
}
